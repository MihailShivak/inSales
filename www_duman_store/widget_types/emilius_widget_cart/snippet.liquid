<script type="text/template" data-template-id="product-not-available">
    <div class="basket__list-item basket-item basket-item_disabled" data-replace-id="<%= product_id %>" data-replace-variant-id="<%= variant_id %>" data-replace-price="<%= price %>">
        <div class="basket-item__image-wrapper">
            <img src="<%= image.replace('static.insales-cdn.com', 'ibicecdn.com/dumanstore') %>" alt="<%= title %>">
        </div>
        <div class="basket-item__body">
            <div class="basket-item__descr-wrapper">
                <div class="basket-item__descr">
                    <a href="<%= href %>?variant_id=<%= variant_id %>" class="basket-item__name"><%= title %></a>
                    <div class="basket-item__size"><%= value %></div>
                </div>
            </div>
            <div class="basket-item__actions">
                <button type="button" class="basket-item__actions-wishlist" data-em-favorites-trigger="<%= product_id %>">
                    <span>В вишлист</span>
                    <span>В вишлисте</span>
                </button>
                <button type="button" class="basket-item__actions-delete" data-cart-delete="<%= variant_id %>"></button>
            </div>
            <div class="basket-item__timer" hidden>
                <button type="button" class="basket-item__timer-btn btn btn_small btn_secondary" data-return-product>Вернуть</button>
                <span class="basket-item__timer-text"><span></span> сек</span>
            </div>
            <div class="basket-item__buttons-wrapper">
                <div class="basket-item__buttons">
                    <button type="button" data-popup="#popup-replace" class="basket-item__buttons-item btn btn_small btn_secondary">Заменить</button>
                    <button type="button" data-popup="#popup-subscribe" class="basket-item__buttons-item btn-icon btn-icon_small btn-icon_secondary btn-icon_notify"></button>
                </div>
            </div>
        </div>
    </div>
</script>

<script type="text/template" data-template-id="popup-not-available">
    <div class="popup__products-item products-item products-item_replace swiper-slide" data-js="product-item">
        <div class="products-item__img-wrapper">
            <a href="<%= url %>" class="products-item__img">
                <% if (image) { %>
                    <img src="<%= image.replace('static.insales-cdn.com', 'ibicecdn.com/dumanstore') %>" alt="<%= title %>">
                <% } else { %>
                    <img src="{{ 'no_image.svg' | asset_url }}" alt="<%= title %>">
                <% } %>
            </a>
            <div class="products-item__actions">
                <button data-js="product-item-wishlist" type="button" class="products-item__action products-item__action-whishlist" data-em-favorites-trigger="<%= id %>"></button>
            </div>
        </div>
        <div class="products-item__info">
            <a href="<%= url %>" class="products-item__title"><%= title %></a>
            <div class="products-item__properties">
                <div class="products-item__prices"><%= price_block %></div>
            </div>
            <div data-spollers class="products-item__basket-wrapper">
                <div class="products-item__size-wrapper">
                    <button type="button" data-spoller class="products-item__size-title<% if(values.length < 2) { %> _disabled<% } %>"><%= first_variant %></button>
                    <div data-spoller-options class="products-item__size-body" <% if(values.length < 2) { %> hidden <% } %> hidden>
                        <div class="products-item__size-options checkbox-list">
                            <% values.forEach(function (value) { %>
                                <div class="checkbox-list__item checkbox-btn">
                                    <label class="checkbox-btn__label<% if (value.inCart) { %> checkbox-item__circle<% } %>">
                                        <input hidden class="checkbox-btn__input" type="radio" value="<%= value.id %>" name="option-<%= variant_id %>"<% if (value.inCart) { %> checked<% } %>>
                                        <span data-spoller-option class="checkbox-btn__text-wrapper">
                                            <span class="checkbox-btn__text"><%= value.title %></span>
                                        </span>
                                    </label>
                                </div>
                            <% }); %>
                        </div>
                        <%= note %>
                    </div>
                </div>
                <button type="button" data-replace-in-cart="<%= variant_id %>" 
                    class="products-item__basket-btn btn-icon btn-icon_primary btn-icon_small btn-icon_basket<%= isAdded %>"></button>
            </div>
        </div>
    </div>
</script>

<script type="text/template" data-template-id="basket-product">
    <div class="basket__list-item basket-item" data-product-id="<%= product_id %>" data-item-id="<%= variant_id %>">
        <div class="basket-item__image-wrapper">
            <% if (isImags) { %>
                <img src="<%= image.replace('static.insales-cdn.com', 'ibicecdn.com/dumanstore') %>" alt="">
            <% } else { %>
                <img data-src="{{ 'no_image.svg' | asset_url }}" alt="" class="image-none">
            <% } %>
        </div>
        <div class="basket-item__body">
            <div class="basket-item__descr-wrapper">
                <div class="basket-item__descr">
                    <a href="<%= url %>" class="basket-item__name"><%= title %></a>
                    <div class="basket-item__size"><%= size_name %></div>
                </div>
                <!--noindex-->
                <div class="products-item__badges">
                    <% if (priceNotFormat < price_old) { %>
                        <% if (price < oldPrice) { %>
                            <span class="badge-sale">
                                <span>SUPER SALE</span>
                                <span><%= Math.floor( (price_old - priceNotFormat) / price_old * 100 ) %>%</span>
                            </span>
                        <% } %>
                    <% } %>
                    <%= badges %>
                </div>
                <!--/noindex-->
            </div>
            <div class="basket-item__actions">
                <button type="button" class="basket-item__actions-wishlist" data-em-favorites-trigger="<%= product_id %>">
                    <span>В вишлист</span>
                    <span>В вишлисте</span>
                </button>
                <button type="button" class="basket-item__actions-delete" data-cart-delete="<%= variant_id %>"></button>
            </div>
            <div class="basket-item__timer" hidden>
                <button type="button" class="basket-item__timer-btn btn btn_small btn_secondary" data-return-product>Вернуть</button>
                <span class="basket-item__timer-text"><span></span> сек</span>
            </div>
            <div class="basket-item__quantity-wrapper">
                <div class="basket-item__price-wrapper">
                    <% if (price_old && price_old.length > 0) { %>
                        <div class="products-item__prices">
                            <span class="products-item__price products-item__price_new"><%= price %></span>
                            <span class="products-item__price products-item__price_old"><%= price_old %></span>
                        </div>
                    <% } else { %>
                        <div class="basket-item__price" data-cart-item-price><%= price %></div>
                    <% } %>
                </div>
                <% if (maxQuantity > 1) { %>
                    <div data-em-quantity class="basket-item__quantity quantity">
                        <button data-em-quantity-change="-1" type="button" class="quantity__button quantity__button_minus"></button>
                        <div class="quantity__input">
                            <input type="text" name="cart[quantity][<%= variant_id %>]" value="<%= quantity %>" data-em-current-quantity="<%= quantity %>" data-max-quantity="<%= maxQuantity %>">
                        </div>
                        <button data-em-quantity-change="1" type="button" class="quantity__button quantity__button_plus" <%= quantity > maxQuantity - 1 ? 'disabled' : '' %>></button>
                    </div>
                <% } else if (isPreorder) { %>
                    <div class="basket-item__last">
                        <span style="color:#975730;">Предзаказ</span>
                    </div>
                <% } else { %>
                    <div class="basket-item__last">Последний товар</div>
                <% } %>
            </div>
        </div>
    </div>
</script>