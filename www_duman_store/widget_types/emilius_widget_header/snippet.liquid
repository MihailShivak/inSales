<div class="tap-bar">
  {% if template == 'cart' %}
    <div
      class="tap-bar__group"
      data-mob-basket-submit
      {% if cart.items.size == 0 %}
        hidden
      {% endif %}
    >
      <div class="tap-bar__label tap-bar__label_del" data-delivery-to-free hidden>
        До бесплатной доставки осталось <span data-delivery-price></span>
      </div>
      <div class="tap-bar__label" data-em-basket-hidden hidden>Нет доступных товаров к покупке</div>
      <div class="tap-bar__label tap-bar__label_del-active" data-delivery-free hidden>Бесплатная доставка</div>
      <div class="tap-bar__label" data-basket-empaty hidden>Нет доступных товаров к покупке</div>
      <button type="button" class="tap-bar__btn btn btn_primary btn_medium" data-basket-submit>
        <span>Перейти к оформлению</span>
        <span data-cart-total-price></span>
      </button>
    </div>
  {% elsif template == 'product' %}
    <div class="tap-bar__group">
      <div class="product-card-info__buttons">
        <button type="button" class="tap-bar__btn btn btn_primary btn_medium" data-em-select-variant>
          <span>Выберите размер</span>
          <span data-product-card-price data-card-product-price></span>
        </button>
        <div class="fav_boc_btns">
          <button
            type="button"
            class="product-card-info__button btn-icon btn-icon_large btn-icon_secondary btn-icon_whishlist favorites-not-added"
            data-em-favorites-trigger="{{ product.id }}"
          ></button>
          <button
            type="button"
            class="buy-one-click product-card-info__button btn btn_large btn_secondary"
            data-popup="#popup-buy-one-click"
            data-boc-trigger
            data-variant-id="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}"
            data-product-title="{{ product.title | escape }}"
          >
            Купить в 1 клик
          </button>
        </div>
      </div>
    </div>
  {% endif %}
  <div class="tap-bar__actions">
    <a href="/" class="tap-bar__actions-item tap-bar__actions-item_main" data-pathname="/">
      <span>Главная</span>
    </a>
    <button
      data-mob-popup-open="main"
      type="button"
      class="tap-bar__actions-item tap-bar__actions-item_catalog"
      data-pathname="/collection"
    >
      <span>Каталог</span>
    </button>
    <a href="/favorites" class="tap-bar__actions-item tap-bar__actions-item_whishlist" data-pathname="/favorites">
      <span>Вишлист</span>
      <span class="icon-counter" data-em-favorites-counter hidden></span>
    </a>
    <a href="/cart_items" class="tap-bar__actions-item tap-bar__actions-item_bag" data-pathname="/cart_items">
      <span>Корзина</span>
      <span class="icon-counter" data-em-cart-count>6</span>
    </a>
    {% if client %}
      <button
        data-popup="#popup-account-nav"
        type="button"
        class="tap-bar__actions-item tap-bar__actions-item_user"
        data-pathname="/login"
      >
        <span>Профиль</span>
      </button>
    {% else %}
      <button
        data-popup="#popup-login"
        type="button"
        class="tap-bar__actions-item tap-bar__actions-item_user"
        data-pathname="/login"
      >
        <span>Профиль</span>
      </button>
    {% endif %}
  </div>
</div>

