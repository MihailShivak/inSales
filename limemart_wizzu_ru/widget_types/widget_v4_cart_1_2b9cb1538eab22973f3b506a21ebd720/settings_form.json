{
  "content": [
    {
      "items": [
        {
          "name": "shared-cart-enable",
          "label": "{{ messages.enable_shared_cart }}",
          "value": null,
          "type": "checkbox",
          "general": true,
          "general_position": 1
        },
        {
          "class": "text",
          "name": "page_header",
          "label": "{{ messages.title }}",
          "value": "",
          "type": "text",
          "placeholder": null
        },
        {
          "name": "coupon-discounts-info",
          "label": "{{ messages.coupon_discounts }}",
          "value": null,
          "type": "info",
          "text": "{{ messages.coupon_discounts_help }}"
        }
      ]
    }
  ],
  "design": [
    {
      "type": "group",
      "name": "{{ messages.stylization }}",
      "items": [
        {
          "class": "range",
          "name": "border-radius",
          "label": "{{ messages.border_radius }} (px)",
          "min": 0,
          "max": 50,
          "step": 1,
          "help": "{{ messages.px_helper }}",
"unit": "px",
          "type": "number",
          "with_btns": true
        },
        {
          "class": "select",
          "name": "img-fit",
          "options": [
            [
              "{{ messages.maintain_proportions }}",
              "contain"
            ],
            [
              "{{ messages.stretch_entire_block }}",
              "cover"
            ]
          ],
          "label": "{{ messages.image_size }}",
          "type": "select"
        },
        {
          "class": "range",
          "name": "img-ratio",
          "label": "{{ messages.image_ratio }}",
          "min": 0.5,
          "max": 2,
          "step": 0.1,
          "type": "number",
          "with_btns": true
        }
      ]
    },
    {
      "type": "group",
      "name": "{{ messages.background }}",
      "items": [
        {
          "name": "bg",
          "label": "{{ messages.widget_background_color }}",
          "value": "",
          "type": "color",
          "clearable": true
        },
        {
          "class": "checkbox",
          "name": "layout-wide-bg",
          "label": "{{ messages.wide_background }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    },
    {
      "type": "group",
      "name": "{{ messages.indentation }}",
      "items": [
        {
          "class": "range",
          "name": "layout-pt",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "label": "{{ messages.padding_top }} (vw)",
          "type": "number",
          "with_btns": true,
          "help": "{{ messages.vw_helper }}",
"unit": "vw"
        },
        {
          "class": "range",
          "name": "layout-pb",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "label": "{{ messages.padding_bottom }} (vw)",
          "type": "number",
          "with_btns": true,
          "help": "{{ messages.vw_helper }}",
"unit": "vw"
        }
      ]
    },
    {
      "type": "group",
      "name": "{{ messages.content }}",
      "items": [
        {
          "class": "number",
          "name": "layout-content-max-width",
          "min": 980,
          "max": 2000,
          "label": "{{ messages.content_max_width }} (px)",
          "type": "number",
          "help": "{{ messages.px_helper }}",
"unit": "px",
          "hide_mobile": true
        },
        {
          "class": "checkbox",
          "name": "layout-wide-content",
          "label": "{{ messages.wide_content }}",
          "value": null,
          "type": "checkbox",
          "hide_mobile": true
        },
        {
          "class": "checkbox",
          "name": "layout-edge",
          "label": "{{ messages.remove_padding_at_edges }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    },
    {
      "type": "group",
      "name": "{{ messages.adaptive }}",
      "items": [
        {
          "class": "checkbox",
          "name": "hide-desktop",
          "label": "{{ messages.hide_desktop }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "checkbox",
          "name": "hide-mobile",
          "label": "{{ messages.hide_mobile }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    }
  ]
}
