<section class="basket page">
    <div class="basket__container basket__container_alt">
        <div class="basket__empty-wrapper" data-basket-empty {% if cart.items.size > 0 %} hidden {% endif %}>
            <div class="basket__empty">
                <div class="basket__empty-text-wrapper">
                    <div class="basket__empty-title">Корзина пока пуста</div>
                    <div class="basket__empty-text">В каталоге можно найти много классных товаров</div>
                </div>
                <a href="/collection/all" class="basket__empty-btn btn btn_primary btn_small">К каталогу</a>
            </div>
        </div>

        <form class="basket__grid" action="{{ cart_url }}" method="post" data-cart-form data-reload-on-coupon="false" {% if cart.items.size == 0 %} hidden {% endif %}>
            <input type="hidden" name="_method" value="put">
            <input type="hidden" name="make_order" value="">
            <input type="hidden" name="lang" value="{{ language.locale }}"/>
            <div class="basket__top">
                <div class="basket__title-wrapper" data-em-menu-top>
                    <div class="basket__title">
                        <span>Корзина</span>
                        <span class="basket__title-count" data-em-cart-item-count></span>
                    </div>
                    <div class="basket__actions-mob">
                        <button type="button" class="basket__actions-mob-item basket__actions-mob-item_share" data-share></button>
                    </div>
                </div>
                <div class="basket__actions">
                    <div class="basket__actions-share">
                        <button type="button" class="basket__actions-share-btn" data-share>Поделиться</button>
                        <button type="button" class="basket__actions-share-text" style="display:none;">
                            <svg width="18" height="17" viewBox="0 0 18 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.00008 0.166016C4.40508 0.166016 0.666748 3.90435 0.666748 8.49935C0.666748 13.0943 4.40508 16.8327 9.00008 16.8327C13.5951 16.8327 17.3334 13.0943 17.3334 8.49935C17.3334 3.90435 13.5951 0.166016 9.00008 0.166016ZM12.5672 7.06643L8.4005 11.2331C8.27841 11.3552 8.11841 11.416 7.95841 11.416C7.79841 11.416 7.63841 11.3552 7.51633 11.2331L5.433 9.14977C5.18883 8.9056 5.18883 8.51018 5.433 8.26602C5.67716 8.02185 6.07258 8.02185 6.31675 8.26602L7.958 9.90727L11.6826 6.18268C11.9267 5.93852 12.3222 5.93852 12.5663 6.18268C12.8105 6.42685 12.8109 6.82227 12.5672 7.06643Z" fill="#975730"/>
                            </svg>
                            <span>Ссылка на корзину скопирована!</span>
                        </button>
                    </div>
                    <button type="button" class="basket__actions-clear" data-popup="#popup-confirm-clear">Очистить всё</button>
                </div>
            </div>
            <div class="basket__list-wrapper">
                <div class="basket__list-group" data-basket-list>
                    <div class="basket__list">
                        {% for item in cart.items %}
                            {% unless item.product.available %}
                                {% if item.product.properties.predzakaz.characteristics.first.name != "Да" or item.product.properties.skoro-v-prodazhe.characteristics.first.name == "Да" %}
                                    {% continue %}
                                {% endif %}
                            {% endunless %}

                            <div class="basket__list-item basket-item" data-product-id="{{ item.product.id }}" data-item-id="{{ item.id }}">
                                <div class="basket-item__image-wrapper">
                                    {% if item.product.images.size > 0 %}
                                        <img data-src="{{ item.product.first_image.large_url | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }}" alt="{{ item.title }}">
                                    {% else %}
                                        <img data-src="{{ 'no_image.svg' | asset_url }}" alt="{{ item.title }}" class="image-none">
                                    {% endif %}
                                </div>
                                <div class="basket-item__body">
                                    <div class="basket-item__descr-wrapper">
                                        <div class="basket-item__descr">
                                            <a href="{{ item.product.url | add_param: 'variant_id', item.variant.id }}" class="basket-item__name">{{ item.product.title }}</a>
                                            {% if item.variant.option_values.size > 0 %}
                                                {% for option_value in item.variant.option_values %}
                                                    {% if option_value.option_name.title == 'Размер' %}
                                                        <div class="basket-item__size">{{ option_value.option_name.title }} {{ option_value.title }}</div>
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                        </div>
                                        <div class="basket-item__badges"
                                            {%- if item.product.properties.badge -%}data-badges-id="{%- for item in item.product.properties.badge.characteristics -%}{{- item.name -}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}"{%- endif -%}
                                        >
                                            {% for collection in item.product.collections %}
                                                {% if collection.handle == "sale" and item.product.price < item.product.old_price %}
                                                    <span class="badge-sale">
                                                        <span>SUPER SALE</span>
                                                        <span>{{- item.product.old_price | minus: item.product.price | divided_by: item.product.old_price | times: 100 | round: 0 -}}%</span>
                                                    </span>
                                                {% elsif collection.handle == "novinki" %}
                                                    <span class="products-item__badge">Новинка</span>
                                                {% endif %}
                                            {% endfor %}
                                            {% if item.product.properties.badge %}
                                                <span class="products-item__badge _disabled-badge">Загрузка</span>
                                            {% endif %} 
                                        </div>
                                    </div>
                                    <div class="basket-item__actions">
                                        <button type="button" class="basket-item__actions-wishlist" data-em-favorites-trigger="{{ item.product.id }}">
                                            <span>В вишлист</span>
                                            <span>В вишлисте</span>
                                        </button>
                                        <button type="button" class="basket-item__actions-delete" data-cart-delete="{{ item.id }}"></button>
                                    </div>
                                    <div class="basket-item__timer" hidden>
                                        <button type="button" class="basket-item__timer-btn btn btn_small btn_secondary" data-return-product>Вернуть</button>
                                        <span class="basket-item__timer-text"><span></span> сек</span>
                                    </div>
                                    <div class="basket-item__quantity-wrapper">
                                        <div class="basket-item__price-wrapper">
                                            {% if item.variant.old_price and item.variant.price < item.variant.old_price %}
                                                <div class="products-item__prices">
                                                    <span class="products-item__price products-item__price_new">{{ item.variant.price | money }}</span>
                                                    <span class="products-item__price products-item__price_old">{{ item.variant.old_price | money }}</span>
                                                </div>
                                            {% else %}
                                                <div class="basket-item__price" data-cart-item-price></div>
                                            {% endif %}
                                        </div>
                                        {% if item.variant.quantity > 1 %}
                                            <div data-em-quantity class="basket-item__quantity quantity">
                                                <button data-em-quantity-change="-1" type="button" class="quantity__button quantity__button_minus"></button>
                                                <div class="quantity__input">
                                                    <input type="text" name="cart[quantity][{{ item.id }}]" value="{{ item.quantity }}" data-em-current-quantity="{{ item.quantity }}" data-max-quantity="{{ item.variant.quantity }}">
                                                </div>
                                                <button data-em-quantity-change="1" type="button" class="quantity__button quantity__button_plus"{% if item.quantity >= item.variant.quantity %}disabled{% endif %}></button>
                                                <div class="basket-item__max-quantity" style="display:none;">Вы достигли максимума для выбора</div>
                                            </div>
                                        {% else %}
                                            <!-- [Перенести] -->
                                            <div class="basket-item__last">
                                                {% if item.variant.quantity == 0 and item.product.properties.predzakaz.characteristics.first.name == "Да" %}
                                                    <span style="color:#975730;">Предзаказ</span>
                                                {% else %}
                                                    Последний товар
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="basket__list-group" data-basket-disabled hidden>
                    <div class="basket__list-title">Недоступно для заказа</div>
                    <div class="basket__list" data-disabled-list></div>
                </div>
            </div>
            <div class="basket__info">
                <div class="basket__info-group" data-em-basket>
                    <div class="basket__info-delivery" data-delivery-to-free hidden>
                        До бесплатной доставки осталось <span data-delivery-price></span>
                    </div>
                    <div class="basket__info-delivery _active" data-delivery-free hidden>Бесплатная доставка</div>
                    <div class="basket__info-total-wrapper" data-em-basket-info>
                        <div class="basket__info-form-wrapper">
                            <div class="basket__info-form form-promocode">
                                <div class="form-promocode__input-wrapper">
                                    <input autocomplete="off" type="text" name="cart[coupon]" placeholder="Промокод" 
                                        class="form-promocode__input input-promocode" value="{{ cart.coupon }}" data-em-input-coupon>
                                    <div class="form-promocode__actions">
                                        <button type="button" class="form-promocode__clear" data-em-coupon-clear hidden></button>
                                        <button type="button" class="form-promocode__btn btn btn_secondary btn_small" data-em-coupon-accept hidden>Применить</button>
                                    </div>
                                </div>
                                <div class="bsk-form-success" data-coupon-message hidden></div>
                                <div class="form-promocode__capture" data-coupon-login hidden>
                                    <button type="button" data-popup="#popup-login" class="form-promocode__capture-btn">Войдите</button>
                                    <span> в профиль для активации промокода</span>
                                </div>
                            </div>
                        </div>
                        <div class="basket__info-certificate">
                            <div class="basket__info-certificate-group" data-certificate-open>
                                <div class="basket__info-certificate-text">
                                    У меня есть
                                    <button type="button" data-popup="#popup-certificate" class="basket__info-certificate-link">сертификат</button>
                                </div>
                            </div>
                            <div class="basket__info-certificate-group" data-certificate hidden>
                                <div class="basket__info-certificate-text">Активирован сертификат<br><span></span></div>
                                <button type="button" class="basket__info-certificate-delete" data-remove-certificate>Удалить</button>
                            </div>
                        </div>
                        <div class="basket__info-total">
                            <div class="basket__info-total-item basket__info-total-item_dilivery" hidden>
                                <span>Доставка</span>
                                <span class="dotts"></span>
                                <span data-delivery-info>Бесплатно по России</span>
                            </div>
                            <div class="basket__info-total-item basket__info-total-item_discount" data-cart-sale hidden>
                                <span>Скидка</span>
                                <span class="dotts"></span>
                                <span></span>
                            </div>
                            <div class="basket__info-total-item basket__info-total-item_discount" data-summ-promo hidden>
                                <span>Промокод</span>
                                <span class="dotts"></span>
                                <span></span>
                            </div>
                            <div class="basket__info-total-item basket__info-total-item_discount" data-summ-certificate hidden>
                                <span>Сертификат</span>
                                <span class="dotts"></span>
                                <span></span>
                            </div>
                            <div class="basket__info-total-item basket__info-total-item_price">
                                <span>Итого</span>
                                <span class="dotts"></span>
                                <span data-cart-total-price></span>
                            </div>
                        </div>
                        <div class="basket__button-wrapper">
                            <button type="submit" class="basket__button btn btn_primary btn_large" data-basket-submit>Перейти к оформлению</button>
                        </div>
                    </div>

