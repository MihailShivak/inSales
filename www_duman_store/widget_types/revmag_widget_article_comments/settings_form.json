{
  "{{ messages.comments }}":[
    {
      "items":[
        {
          "class":"text",
          "name":"title",
          "label":"{{ messages.title }}",
          "value":null,
          "type":"text"
        },
        {
          "class":"range",
          "name":"grid-list-min-width",
          "label":"{{ messages.review_item_masonry_min_width }}",
          "min":250,
          "max":500,
          "step":10,
          "unit":"px",
          "type":"range",
          "help":"{{ messages.review_item_masonry_min_width_help }}"
        },
        {
          "class":"range",
          "name":"grid-list-row-gap",
          "min":0.5,
          "max":10,
          "step":0.5,
          "label":"{{ messages.vertical_spacing_between_reviews }}",
          "unit":"rem",
          "type":"range"
        },
        {
          "class":"range",
          "name":"grid-list-column-gap",
          "min":0,
          "max":10,
          "step":0.5,
          "label":"{{ messages.horizontal_space_between_reviews }}",
          "unit":"rem",
          "type":"range"
        }
      ]
    }
  ],
  "{{ messages.label_widget }}": [
    {
      "group_name":"{{ messages.background }}",
      "items": [
        {
          "name":"bg",
          "label":"{{ messages.widget_background_color }}",
          "value":"",
          "type":"color",
          "clearable": true
        },
        {
          "class": "checkbox",
          "name": "layout-wide-bg",
          "label": "{{ messages.wide_background }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    },
    {
      "group_name":"{{ messages.indentation }}",
      "items": [
        {
          "class": "range",
          "name": "layout-mt",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "label": "{{ messages.margin_top }}",
          "type": "range",
          "unit": "vw"
        },
        {
          "class": "range",
          "name": "layout-mb",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "label": "{{ messages.margin_bottom }}",
          "type": "range",
          "unit": "vw"
        },
        {
          "class": "range",
          "name": "layout-pt",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "label": "{{ messages.padding_top }}",
          "type": "range",
          "unit": "vw"
        },
        {
          "class": "range",
          "name": "layout-pb",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "label": "{{ messages.padding_bottom }}",
          "type": "range",
          "unit": "vw"
        }
      ]
    },
    {
      "group_name":"{{ messages.content }}",
      "items": [
        {
          "class": "range",
          "name": "layout-content-max-width",
          "min": 600,
          "max": 2000,
          "step": 2,
          "label": "{{ messages.content_max_width }}",
          "type": "range",
          "unit": "px"
        },
        {
          "class": "checkbox",
          "name": "layout-wide-content",
          "label": "{{ messages.wide_content }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "checkbox",
          "name": "layout-edge",
          "label": "{{ messages.remove_padding_at_edges }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    },
    {
      "group_name":"{{ messages.adaptive }}",
      "items": [
        {
          "class": "checkbox",
          "name": "hide-desktop",
          "label": "{{ messages.hide_desktop }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "checkbox",
          "name": "hide-mobile",
          "label": "{{ messages.hide_mobile }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    }
  ]
}
