<!-- Уведомление о городе -->
<div id="city-notice" class="city-notice" hidden>
  <div class="city-notice__body">
    <div class="city-notice__header">
      <span class="city-notice__label">Адрес доставки</span>
    </div>
    <div class="city-notice__city">
      <strong class="city-notice__city-name" data-city-notice-name>Загружаем...</strong>
    </div>
    <div class="city-notice__buttons">
      <button type="button" class="city-notice__btn city-notice__btn_confirm" data-city-confirm>Да, верно</button>
      <button type="button" class="city-notice__btn city-notice__btn_change" data-city-change>Нет, другой</button>
    </div>
  </div>
</div>

<div id="popup-city" aria-hidden="true" class="popup">
  <div class="popup__wrapper">
    <div class="popup__content popup__content-city">
      <button data-close type="button" class="popup__close"></button>
      <div class="popup__body">
        <div class="popup__title">Адрес доставки</div>
        <form action="" data-dev class="popup__form form-popup">
          <div class="form-popup__group">
            <div class="form-popup__input-group">
              <div class="form-popup__input-wrapper">
                <select name="country" class="form" data-speed="350">
                  <option value="AZ">Азербайджан</option>
                  <option value="AM">Армения</option>
                  <option value="BY">Беларусь</option>
                  <option value="GE">Грузия</option>
                  <option value="KZ">Казахстан</option>
                  <option value="KG">Кыргызстан</option>
                  <option value="RU" selected>Россия</option>
                  <option value="TJ">Таджикистан</option>
                  <option value="UZ">Узбекистан</option>
                </select>
              </div>
            </div>
            <div class="form-popup__input-group">
              <div class="form-popup__input-wrapper">
                <select
                  name="domain_city"
                  class="form"
                  data-speed="350"
                  data-city-domain-select
                >
                  <option value="" selected>Крупные города</option>
                  <option value="новосибирск">Новосибирск</option>
                  <option value="санкт-петербург">Санкт-Петербург</option>
                  <option value="нижний новгород">Нижний Новгород</option>
                  <option value="красноярск">Красноярск</option>
                  <option value="казань">Казань</option>
                  <option value="челябинск">Челябинск</option>
                  <option value="самара">Самара</option>
                  <option value="омск">Омск</option>
                  <option value="ростов-на-дону">Ростов-на-Дону</option>
                  <option value="уфа">Уфа</option>
                  <option value="воронеж">Воронеж</option>
                  <option value="пермь">Пермь</option>
                  <option value="кемерово">Кемерово</option>
                  <option value="тольятти">Тольятти</option>
                  <option value="москва">Москва</option>
                </select>
              </div>
            </div>
            <div class="form-popup__input-group">
              <div class="form-popup__input-wrapper">
                <input
                  type="hidden"
                  name="name-city-hidden"
                  data-city-hidden
                  value=""
                >
                <input
                  autocomplete="off"
                  type="text"
                  name="name-city"
                  data-error=""
                  placeholder="Начните вводить название города"
                  class="form-popup__input input"
                >
                <button type="button" data-js="input-clear" class="form-popup__input-clear"></button>
                <div class="select__body">
                  <div class="select__options" data-select-container-sity hidden>
                    <div data-simplebar="init" class="select__scroll">
                      <div class="simplebar-content" data-select-sity-list></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
        <button type="button" data-city-save class="popup__button btn btn_medium btn_primary btn_accept_city" disabled>
          Сохранить
        </button>
      </div>
    </div>
  </div>
</div>

<button id="btn-popup-city" type="button" data-popup="#popup-city" hidden></button>
