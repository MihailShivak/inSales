<script>

/**
 * @typedef {Object} OptionsMap
 * @property {string} ID_MAP - Id контейнера карты
 * @property {Array} center - Координаты центра карты
 * @property {Int} zoom - Zoom карты
 */

/**
 * @param {Object} map - Объект контейнера карты
 * @param {OptionsMap} options - Параметры карты
 */
class DeliveryZonesMap {
    constructor(map, options) {
        this.name = "[DeliveryZonesMap]";
        this.options = options;

        this.currentCenter = options.center; // Текущий центр карты
        this.currentAddress = ""; // Текущий адрес
        // this.suggestView = null;

        this.ymaps = null; // Объект Yandex.Map
        this.polygons = []; // Полигоны зон

        this.map = map; // Контейнер карты
        this.adsress = map?.querySelector("#address-define");
    }

    /**
     * Инициализация Ynadex.Map
     * @param {JSON} geoJson - Данные зон в формате GEO JSON, импорт из карты 
     */
    init(geoJson) {
        if (!this.map || !this.adsress) {
            this.throwException("Ошибка инициализации");
        }

        this.mapModal = new EM_Module.Modal(this.map);
        this.mapModal.init();

        this.addressModal = new EM_Module.Modal(document.getElementById("popup-address"));
        this.addressModal.init(function() {
            // Открытие модалки
            this.modal.querySelector('#address-input').value = '';
            setTimeout(
                () => this.modal.querySelector('#address-input')?.focus(),
                250
            );
        });

        ymaps.ready(this.initMap.bind(this, this.fixGeoJSON(geoJson)));
        this.map.addEventListener("click", this.onClick.bind(this));
    }

    onClick(e) {
        // Изменить адрес
        if (e.target.classList.contains("btn__change-address")) {
            this.addressModal?.open();
        }
        else if (e.target.getAttribute("data-em-ready") !== null) {
            this.searchZone();
        }
    }

    initMap(geoJson) {
        this.ymaps = new ymaps.Map(this.options.ID_MAP, {
            center: this.options.center,
            zoom: this.options.zoom,
            controls: []
        });
    
        this.ymaps.events.add('boundschange', (e) => {
            if (e.get('newCenter')) {
                this.currentCoords = e.get('newCenter');
                this.updateAddressByCoords(this.currentCoords);
            }
        });
    
        // Отрисовка полигонов
        geoJson.features.forEach(feature => {
            if (feature.geometry.type !== "Polygon") return;

            let polygon = new ymaps.Polygon(
                feature.geometry.coordinates, { 
                    hintContent : `Зона: ${feature.id}` 
                }, {
                    fillColor: feature.properties.fill,
                    fillOpacity: feature.properties["fill-opacity"],
                    strokeColor: feature.properties.stroke,
                    strokeOpacity: feature.properties["stroke-opacity"],
                    strokeWidth: feature.properties["stroke-width"]
                }
            );
    
            this.ymaps.geoObjects.add(polygon);
            this.polygons.push(polygon);
        });
    
        this.updateAddressByCoords(this.currentCoords);
    
        // Инициализируем подсказки в модалке
        let suggestView = new ymaps.SuggestView('address-input', {
            provider: 'yandex#map',
            boundedBy: [
                [43.365897, 45.676333], // верхний левый угол
                [43.176329, 45.802180]  // нижний правый угол
            ],
            strictBounds: true,
            // noPlacemark: true,
            size: 'large',
            placeholderContent: 'Введите адрес в Грозном'
        });

        // Выбор адреса из предложенных
        suggestView.events.add('select', (e) => {
            const selectedAddress = e.get('item').value;
            if (!selectedAddress) return;

            ymaps.geocode(selectedAddress).then((res) => {
                let coords = res.geoObjects.get(0).geometry.getCoordinates();
                this.ymaps.setCenter(coords, 17);
                this.updateAddressByCoords(coords);
                this.addressModal.close();
            });
        });
    }

    /**
     * Проверка принадлежности к зоне
     * @param {*} res 
     * @returns 
     */
    searchZone() {
        if (!this.currentAddress || !this.currentCoords) {
            this.warn("Ошибка определния зоны доставки", {
                currentAddress: this.currentAddress,
                currentCoords: this.currentCoords
            });
            return;
        }
        console.log("[Map] Адрес выбран из поля поиска:", this.currentAddress);

        // Проверяем зону
        for (var polygon of this.polygons) {
            if (polygon.geometry.contains(this.currentCoords)) {
                console.log("[Map] Найдена зона:", polygon.properties.get("hintContent"));
                alert(`Адрес "${this.currentAddress }"\nвходит в зону: ${polygon.properties.get("hintContent")}`);
                return;
            }
        }
        alert(`Адрес "${this.currentAddress}"\nне входит ни в одну из зон.`);
    }

    updateAddressByCoords(coords) {
        ymaps.geocode(coords).then((res) => {
            let firstGeoObject = res.geoObjects.get(0);
            if (firstGeoObject) {
                this.currentAddress = firstGeoObject.getAddressLine();
                this.adsress.textContent = this.currentAddress;
            } else {
                this.adsress.textContent = "Укажите адрес доставки";
            }
        });
    }

    /**
     * Смена мест значений долготы и широты 
     * @param {GeoJSON} json - Данные зон в формате GEO JSON, импорт из карты 
     * @returns {GeoJSON} - Исправленные данные
     */
    fixGeoJSON(geojson) {
        geojson.features.forEach(feature => {
            if (feature.geometry.type === "Polygon" || feature.geometry.type === "MultiLineString") {
                feature.geometry.coordinates = feature.geometry.coordinates.map(ring =>
                    // Смена
                    ring.map(coord => [coord[1], coord[0]])
                );
            }
        });
        return geojson;
    }

    printWarn(mess, params) {
        console.warn(this.name, mess, params);
    }

    printError(mess, params="") {
        console.error(this.name, mess, params);
    }

    throwException(mess) {
        throw `${this.name} ${mess}`;
    }

}

