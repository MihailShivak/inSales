                    ></span>
                  </button>
                  <div class="filters__body">
                    <div class="filters__label">{{ option.title }}</div>
                    <div class="filters__list">
                      {% if option.values.size > 0 %}
                        {% for option_value in option.values %}
                          <div class="filters__list-item checkbox">
                            <label class="checkbox__label checkbox__label_filter">
                              <input
                                data-error=""
                                class="checkbox__input"
                                type="checkbox"
                                value="{{ option_value.id }}"
                                data-property-id="{{ option.id }}"
                              >
                              <span class="checkbox__text-wrapper">
                                <span class="checkbox__point"></span>
                                {% if option.id == 1607435 and option_value.image_url %}
                                  <span class="checkbox__text checkbox__text_color">
                                    <img
                                      class="checkbox__text-icon"
                                      data-src="{{ option_value.image_url | image_url: 32 }}"
                                    >
                                    {{ option_value.title }}
                                  </span>
                                {% else %}
                                  <span class="checkbox__text">{{ option_value.title }}</span>
                                {% endif %}
                              </span>
                            </label>
                          </div>
                        {% endfor %}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}

              <div class="filters__group" data-filter-id="price">
                <button type="button" data-spoller data-spoller-fade data-spoller-close class="filters__title-wrapper">
                  <span class="filters__title">Цена <span class="filters__title-count"></span></span>
                </button>
                <div class="filters__body">
                  <div class="filters__label">Цена</div>
                  <div data-range class="filters__price price-filter">
                    <div class="price-filter__inputs">
                      <div class="price-filter__input-wrap">
                        <input
                          data-range-from="{{ price_min }}"
                          autocomplete="off"
                          type="text"
                          value="{{ price_min }}"
                          name="price_min"
                          class="price-filter__input"
                        >
                        <span>от</span>
                      </div>
                      <div class="price-filter__input-wrap">
                        <input
                          data-range-to="{{ price_max }}"
                          autocomplete="off"
                          type="text"
                          value="{{ price_max }}"
                          name="price_max"
                          class="price-filter__input"
                        >
                        <span>до</span>
                      </div>
                    </div>
                    <div data-range-item class="price-filter__range"></div>
                  </div>
                </div>
              </div>

              {% if collection.handle != 'all' %}
                {% for property in collection.properties %}
                  <div class="filters__group" data-filter-id="{{ property.id }}" data-filter-type="characteristic">
                    <button
                      type="button"
                      data-spoller
                      data-spoller-fade
                      data-spoller-close
                      class="filters__title-wrapper"
                    >
                      <span class="filters__title">
                        {{- property.name -}}
                        <span class="filters__title-count"></span
                      ></span>
                    </button>
                    <div class="filters__body">
                      <div class="filters__label">{{ property.name }}</div>
                      <div class="filters__list">
                        {% for characteristic in property.characteristics %}
                          <div class="filters__list-item checkbox">
                            <label class="checkbox__label checkbox__label_filter">
                              <input
                                data-error=""
                                class="checkbox__input"
                                type="checkbox"
                                value="{{ characteristic.id }}"
                                data-property-id="{{ property.id }}"
                                name="characteristic"
                              >
                              <span class="checkbox__text-wrapper">
                                <span class="checkbox__point"></span>
                                <span class="checkbox__text">{{ characteristic.name }}</span>
                              </span>
                            </label>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </form>
    <div class="catalog__selected-filters selected-filters" hidden>
      <div class="selected-filters__list"></div>
      <button type="button" class="selected-filters__clear" data-clear-filtres>Очистить всё</button>
    </div>
  </div>
  <script>
    console.log("render catalog filters: {{ 'now' | date: '%s.%L' | minus: catalog_panel_time }}");
  </script>

  <div class="catalog__error" hidden>Товары не найдены</div>
  <div
    class="catalog__list catalog__list_default"
    data-js="catalog-list"
    data-ajax-products="{{ products.size }}"
    data-no-image="{{ 'no_image.svg' | asset_url }}"
  >
    {% for product in products %}
      <div
        class="catalog__list-item products-item"
        data-ssr-item
        {% if product.available %}
          data-js="product-item"
        {% endif %}
        data-cust-product-id="{{ product.id }}"
      >
        <div class="products-item__img-wrapper">
          <a href="{{ product.url }}" class="products-item__img" target="_blank">
            <div class="products-item__img-list">
              {% if product.image %}
                <div>
                  <picture>
                    <source
                      srcset="{{ product.image | image_url: '400x400' }} 1x, {{ product.image | image_url: '800x800' }} 2x"
                      type="image/webp"
                    >
                    <img
                      src="{{ product.image | image_url: '400x400' }}"
                      alt="{{ product.title }}"
                      class="entered"
                      loading="lazy"
                    >
                  </picture>
                </div>
              {% else %}
                <div>
                  <img
                    src="{{ 'no_image.svg' | asset_url }}"
                    alt="{{ product.title }}"
                    class="image-none entered loading"
                    loading="lazy"
                  >
                </div>
              {% endif %}
            </div>
          </a>
        </div>
        <div class="products-item__info">
          <a href="{{ product.url }}" class="products-item__title" target="_blank">{{ product.title }}</a>
          <div class="products-item__properties">
            <div class="products-item__prices">
              {% if product.available == false %}
                <div class="products-item__button btn btn_outline btn_small">Скоро в продаже</div>
              {% else %}
                {% if product.old_price_min and product.old_price_min > product.price_min %}
                  <span class="products-item__price products-item__price_new">{{ product.price_min | money }}</span>
                  <span class="products-item__price products-item__price_old">{{ product.old_price_min | money }}</span>
                {% else %}
                  <span class="products-item__price">{{ product.price_min | money }}</span>
                {% endif %}
              {% endif %}
            </div>
          </div>
          {% unless product.available %}
            <div class="products-item__product-ended">Товар закончился</div>
          {% endunless %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% comment %}
    <div class="catalog__btn">
        <button type="button" class="basket__empty-btn btn btn_primary btn_medium" data-load-more style="margin-top: 40px;"
            {% if products.size <= page_size and collection.products_count <= page_size %} hidden{% endif %}
        >Загрузить еще</button>
    </div>
  {% endcomment %}
  {%- if paginate.pages > 1 -%}
    <div class="catalog__loader" hidden>
      <div class="catalog__loader-body">
        <div class="catalog__loader-anim">
          <svg xmlns="http://www.w3.org/2000/svg" width="50" height="34" viewBox="0 0 24 24">
            <circle class="spinner_b2T7" cx="4" cy="12" r="3"></circle><circle class="spinner_b2T7 spinner_YRVV" cx="12" cy="12" r="3"></circle><circle class="spinner_b2T7 spinner_c9oY" cx="20" cy="12" r="3"></circle>
          </svg>
        </div>
        <span>Загружаем ещё</span>
      </div>
    </div>
    <div class="pagin__body" data-em-pagin="{{ paginate.pages }}">
      <input type="text" name="em-pagin" value="{{ paginate.current_page }}" hidden />
      <div class="pagin__btn" data-pagin-left></div>
      <div class="pagin__wrapper">
        <div class="pagin__slider"></div>
      </div>
      <div class="pagin__btn" data-pagin-right></div>
    </div>
  {%- endif -%}
  {% comment %}
    {%- if paginate.pages > 1 -%}
        <div class="catalog__loader">
            <div class="catalog__loader-body">
                <div class="catalog__loader-anim">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="34" viewBox="0 0 24 24"><style>.spinner_b2T7{animation:spinner_xe7Q .8s linear infinite}.spinner_YRVV{animation-delay:-.65s}.spinner_c9oY{animation-delay:-.5s}@keyframes spinner_xe7Q{93.75%,100%{r:3px}46.875%{r:.2px}}</style><circle class="spinner_b2T7" cx="4" cy="12" r="3"></circle><circle class="spinner_b2T7 spinner_YRVV" cx="12" cy="12" r="3"></circle><circle class="spinner_b2T7 spinner_c9oY" cx="20" cy="12" r="3"></circle></svg>
                </div>
                <span>Загружаем ещё</span>
            </div>
        </div>
        <div class="pagin__body" data-em-pagin="{{ paginate.pages }}">
            <input type="text" name="em-pagin" value="{{ paginate.current_page }}" hidden/>
            {% if paginate.current_page > 1 %}
                <a href="{{ paginate.previous.url }}" class="pagin__btn" data-pagin-left></a>
            {% endif %}
            <div class="pagin__wrapper">
                <div class="pagin__slider">
                    {% for part in paginate.parts %}
                        {% if part.is_link %}
                            <a href="{{ part.url }}"
                                class="pagin__number"
                                data-pagin-index="{{ part.title }}"
                            >
                                {{ part.title }}
                            </a>
                        {% else %}
                            <div class="pagin__number {% if part.title == paginate['current_page'] %}pagin__action{% endif %}"
                                data-pagin-index="{{ part.title }}"
                            >
                                {{ part.title }}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% if paginate.current_page < paginate.pages %}
                <a href="{{ paginate.next.url }}" class="pagin__btn" data-pagin-right></a>
            {% endif %}
        </div>
    {%- endif -%}
  {% endcomment %}
</div>

<script>
  console.log("render catalog body: {{ 'now' | date: '%s.%L' | minus: ctl_body_time }}");
</script>
