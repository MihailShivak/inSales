{% assign filter_active = false %}
{% assign display_filter = false %}
{% assign collection_size = settings.collection_count | default: '12' %}
{% assign microdata_displayed_products = 0 %}

{% paginate products by collection_size %}
  {% assign last_displayed_product = products | last %}

  <script type="application/ld+json">
    {
    	"@context": "https://schema.org",
    	"@type": "CollectionPage",
    	"name": "{{ collection.title | strip_html }}",
    	"url": "{{ request.base_url }}{{ collection.url }}?page={{ paginate.current_page }}",
    	"description": "Купить {{ collection.title | downcase | strip_html | strip_newlines}} в интернет магазине Duman. {{ collection.description | strip_html | strip_newlines }} Новинки. Заказ онлайн с доставкой по России. – страница № {{ paginate.current_page }}",
    	"mainEntity": {
    		"@type": "ItemList",
    		"itemListElement": [{% for product in products %}{% assign microdata_displayed_products = microdata_displayed_products | plus: 1 %}
    			{
    				"@type": "ListItem",
    				"position": {{ microdata_displayed_products }},
    				"url": "{{ request.base_url }}{{ product.url }}",
    				"item": {
    					"@type": "Product",
    					"name": "{{ product.title | strip_html }}",
    					"image": "{{ product.first_image.large_url | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }}",
    					"offers": {
    						"@type": "Offer",
    						"price": "{{ product.price }}",
    						"priceCurrency": "RUB",
    						"availability": "https://schema.org/InStock",
    						"url": "{{ request.base_url }}{{ product.url }}"
    					}
    				}
    			}{%if product.id != last_displayed_product.id %},{% endif %}{% endfor %}
    		],
    		"numberOfItems": {{ microdata_displayed_products }}
    	}
    }
  </script>

  {% comment %} === Хлебные крошки для категории === {% endcomment %}
  {% capture breadcrumbs %}
<div class="breadcrumbs__body">
  <ul class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a href="/" class="breadcrumbs__link">Главная</a>
    </li>
    {% if collection.handle == 'all' %}
      <li class="breadcrumbs__item breadcrumbs__item--current">
        <span>Каталог</span>
      </li>
    {% else %}
      {% assign parent_collection = nil %}
      {% if collection.current_collections.size > 1 %}
        {% for col in collection.current_collections %}
          {% unless col.handle == collection.handle %}
            {% assign parent_collection = col %}
          {% endunless %}
        {% endfor %}
      {% endif %}
      {% if parent_collection %}
        <li class="breadcrumbs__item">
          <a href="{{ parent_collection.url }}" class="breadcrumbs__link">{{ parent_collection.title }}</a>
        </li>
      {% endif %}
      <li class="breadcrumbs__item breadcrumbs__item--current">
        <span>{{ collection.title }}</span>
      </li>
    {% endif %}
  </ul>
</div>
{% endcapture %}
  <div class="breadcrumbs">
    <div class="breadcrumbs__container">{{ breadcrumbs }}</div>
  </div>

  {% for widgetDrop in widget_lists['collection-list'].widgets %}
    {% widget widgetDrop %}
  {% endfor %}
{% endpaginate %}
