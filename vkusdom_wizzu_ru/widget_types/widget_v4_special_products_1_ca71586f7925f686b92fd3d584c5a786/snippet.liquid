{% if data.blocks.size > 0 %}
  {% for block in data.blocks %}
    {% if block.collection.products_count_without_cache > 0 %}
      <div class="special-products js-special-products" itemscope itemtype="https://schema.org/ItemList">
        {% assign number_of_items = block.collection.products.size %}
        {% assign count_special_products = widget_settings.count_special_products | to_integer %}
        {% if block.collection.products.size > count_special_products %}
          {% assign number_of_items = count_special_products %}
        {% endif %}
        <meta itemprop="numberOfItems" content="{{ number_of_items }}">
        {% assign block_name = block.name | default: block.collection.title %}
        <div class="special-products__head">
          <div class="h2 special-products__title heading">{{ block_name }}</div>
          <div class="special-products__slider-controls">
            <div class="special-products__slider-arrow special-products__slider-arrow-prev js-move-slide">
              <span class="special-products__slider-arrow-icon icon-arrow-left"></span>
            </div>
            <div class="special-products__slider-arrow special-products__slider-arrow-next js-move-slide">
              <span class="special-products__slider-arrow-icon icon-arrow-right"></span>
            </div>
          </div>
        </div>
        <div
          class="splide js-special-products-slider"
          data-slide-min-width="{{ widget_settings.slide-width }}"
          data-slide-min-width-mobile="{{ widget_settings.slide-width-mobile }}"
          data-slide-gap="{{ widget_settings.slide-gap }}">
          <div class="splide__track">
            <div class="splide__list">
              {% for product in block.collection.products limit: widget_settings.count_special_products %}
                {% assign product_variants_first = product.variants | where: "available" | first %}

                {% if widget_settings.product-desc-limit != "all" %}
                  {% assign preview_text = product.short_description | strip_html | truncatewords: widget_settings.product-desc-limit %}
                {% else %}
                  {% assign preview_text = product.short_description | strip_html %}
                {% endif %}

                <div class="splide__slide" itemprop="itemListElement" itemscope itemtype="http://schema.org/{% if page_has_list_item %}Product{% else %}ListItem{% endif %}">
                  {% unless page_has_list_item %}
                  <meta itemprop="position" content="{{ forloop.index }}">
                  {% endunless %}
                  <form
                    action="{{ cart_url }}"
                    method="post"
                    data-product-id="{{ product.id }}"
                    data-product-updated-at="{{ product.updated_at }}"
                    class="product-preview {% if settings.product_not_available == "shown" %} is-zero-count-shown {% endif %} {% if settings.product_not_available == "preorder" %} is-zero-count-preorder {% endif %} {% if settings.product_not_available == "hidden" %} is-zero-count-hidden {% endif %} {% if product.show_variants? and product.variants.size > 1 %}is-more-variants{% endif %} {% unless product_variants_first.available %}is-all-variants-not-available{% endunless %} {% if account.forbid_order_over_existing %}is-forbid-order-over-existing{% endif%} {% if product.old_price_varies? %}is-more-old-prices{% endif%}"
                    {% unless page_has_list_item %}
                    itemprop="item"
                    itemscope
                    itemtype="https://schema.org/Product"
                    {% endunless %}
                  >
                    {% capture first_offer_microdata %}
                    <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                      <link itemprop="url" href="{{ product.url }}">
                      <meta itemprop="sku" content="{{ product.variants.first.id }}">
                      <meta itemprop="price" content="{{ product.variants.first.price }}">
                      <meta itemprop="priceCurrency" content="{{ account.currency_iso_code }}">
                      <link itemprop="availability" href="https://schema.org/{% if product.variants.first.available %}InStock{% else %}OutOfStock{% endif %}">
                    </div>
                    {% endcapture %}

                    <meta itemprop="description" content="{{ preview_text | escape }}">
                    <meta itemprop="sku" content="{{ product.sku }}">

                    {% if product.rating %}
                    <div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
                      <meta itemprop="ratingValue" content="{{ product.rating }}">
                      <meta itemprop="worstRating" content="1">
                      <meta itemprop="bestRating" content="5">
                      <meta itemprop="ratingCount" content="{{ product.reviews_count }}">
                      <meta itemprop="reviewCount" content="{{ product.reviews_count }}">
                    </div>
                    {% endif %}

                    <div class="product-preview__content">
                      <div class="product-preview__area-photo">
                        <div
                          class="product-preview__photo"
                          itemprop="image"
                          itemscope
                          itemtype="https://schema.org/ImageObject"
                        >
                          {% if settings.favorite_enabled %}
                            <span class="button button_size-s favorites_btn" data-ui-favorites-trigger="{{ product.id }}">
                              <span class="btn-icon icon-favorites-o"></span>
                              <span class="btn-icon icon-favorites-f"></span>
                            </span>
                          {% endif %}
                          <div class="img-ratio img-ratio_cover">
                            <div class="img-ratio__inner">
                              {% assign img_title = product.title | escape %}
                              <meta itemprop="name" content="{{ img_title }}">
                              {% if widget_settings.hide-variants != true %}
                                <a href="{{ product.url }}" class="product-preview__photo-variant"></a>
                              {% else %}
                              <a href="{{ product.url }}">
                                {% assign img_width = widget_settings.slide-width | to_integer | times: 2 | default: 500 %}
                                {% assign img_width_mobile = widget_settings.slide-width-mobile | to_integer | times: 1.5 | default: 400 %}
                                {% assign product_img = product.first_image %}


                                {% if product_img.original_url contains 'no_image' %}
                                    <picture>
                                      <img
                                        src="{{ account.url }}{{ product_img.original_url  }}"
                                        alt="{{ img_title }}"
                                        title="{{ img_title }}"
                                        itemprop="contentUrl"
                                      >
                                    </picture>
                                {% else %}
                                  <picture>
                                    <source
                                      media="(min-width:481px)"
                                      srcset="{{ product_img | image_url: img_width, format: 'webp', resizing_type: 'fit_width', quality: 100  }}"
                                      type="image/webp"
                                      loading="lazy"
                                    >

                                    <source
                                      media="(max-width:480px)"
                                      srcset="{{ product_img | image_url: img_width_mobile, format: 'webp', resizing_type: 'fit_width', quality: 100  }}"
                                      type="image/webp"
                                      loading="lazy"
                                    >
                                    {% if forloop.index < 5 %}
                                      <link
                                        rel="preload"
                                        href="{{ product_img | image_url: img_width_mobile, format: 'webp', resizing_type: 'fit_width', quality: 100  }}"
                                        as="image"
                                        media="(max-width:480px)" />
                                    {% endif %}

                                    <img
                                      src="{{ product_img | image_url: img_width, resizing_type: 'fit_width', quality: 100  }}"
                                      loading="lazy"
                                      alt="{{ img_title }}"
                                      title="{{ img_title }}"
                                      itemprop="contentUrl"
                                    >
                                  </picture>
                                {% endif %}
                              </a>
                            {% endif %}
                            </div>
                          </div>
                          <div class="product-preview__available">
                            <span data-product-card-available='{
                                                    "availableText": "{{ messages.available }}",
                                                    "notAvailableText": "{{ messages.not_available }}"
                                                    }'>
                              {% if product_variants_first.available %}
                                {{ messages.available }}
                              {% else %}
                                {{ messages.not_available }}
                              {% endif %}
                            </span>
                          </div>
                          <div class="stickers">
                            {% include 'system_stickers', sticker_class: 'sticker', sticker_property: 'label' %}
                            <div
                              class="sticker sticker-sale"
                              data-product-card-sale-value
                              data-sticker-title="sticker-sale"></div>
                            <div class="sticker sticker-preorder" data-sticker-title="sticker-preorder">{{ messages.pre_order }}</div>
                          </div>
                        </div>
                      </div>
                      <div class="product-preview__area-sku">
                        <div class="product-preview__sku">
                          {% if editor_mode? or widget_settings.product_hide_sku != true %}
                            <span data-product-card-sku='{
                                                  "skuLabel": "{{messages.sku_label}}"
                                                  }'>
                              {{ messages.sku_label }}{{ product_variants_first.sku }}
                            </span>
                          {% endif %}
                        </div>
                      </div>

                      <div class="product-preview__area-title">
                        <div class="product-preview__title" itemprop="name">
                          <a href="{{product.url}}" itemprop="url">{{ product.title }}</a>
                        </div>
                      </div>

                      <div class="product-preview__area-description">
                        {% if editor_mode? or widget_settings.hide-description != true %}
                          <div class="product-preview__description">
                            {{ preview_text }}
                          </div>
                        {% endif %}
                      </div>

                      <div class="product-preview__area-variants">
                        {% if product.show_variants? %}
                          {% if editor_mode? or widget_settings.hide-variants != true %}
                            <div class="product-preview__variants">
                              {% capture product_variants_options %}{ "default": "option-radio"
                                {% if widget_settings.display-property-color == "text" %}, "Цвет": "option-span"
                                {% endif %}
                                {% if widget_settings.display-property-color == "picture" %}, "Цвет": "option-radio"
                                {% endif %}
                                }{% endcapture %}
                              <div
                                style="display:none"
                                class="hide"
                                name="variant_id"
                                data-product-variants='{{ product_variants_options }}'>
                                {% for variant in product.variants %}
                                  <div
                                    itemprop="offers"
                                    itemscope
                                    itemtype="https://schema.org/Offer"
                                  >
                                    <link itemprop="url" href="{{ product.url }}">
                                    <meta itemprop="sku" content="{{ variant.id }}">
                                    <meta itemprop="price" content="{{ variant.price }}">
                                    <meta itemprop="priceCurrency" content="{{ account.currency_iso_code }}">
                                    <link itemprop="availability" href="https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}">
                                  </div>

                                  <option value="{{ variant.id }}">{{ variant.title | escape }}</option>
                                {% endfor %}
                              </div>
                            </div>
                          {% else %}
                            {{ first_offer_microdata }}

                            <input
                              type="hidden"
                              name="variant_id"
                              value="{{ product.variants.first.id }}" />
                          {% endif %}
                        {% else %}
                          {{ first_offer_microdata }}

                          <input
                            type="hidden"
                            name="variant_id"
                            value="{{ product.variants.first.id }}" />
                        {% endif %}
                      </div>

                      <div class="product-preview__area-bottom">
                        <div class="product-preview__price">
                          <span class="product-preview__price-old" data-product-card-old-price></span>
                          <span class="product-preview__price-cur" data-product-card-price-from-cart></span>
                        </div>

                        <div class="product-preview__price-cur product-preview__price-range">
                          {% if product.price_varies? %}
                            <span class="product-preview__price-label">{{ messages.from_upper }}</span>
                            {{ product.price_min | money }}
                          {% else %}
                            {% if product.price < product.old_price %}
                              <span class="product-preview__price-old">{{ product.old_price | money }}</span>
                            {% endif %}
                            <span class="product-preview__price-cur">{{ product.price | money }}</span>
                          {% endif %}
                        </div>

                        <div class="product-preview__controls">


                        {% if product.show_cart_button %}
                          <div class="add-cart-counter" data-add-cart-counter>
                            <button
                              type="button"
                              class="button add-cart-counter__btn"
                              data-add-cart-counter-btn>
                              <span class="add-cart-counter__btn-label">{{ messages.btn_buy_text }}</span>
                              <span class="button__icon icon-cart"></span>
                            </button>
                            <div class="add-cart-counter__controls">
                              <button
                                data-add-cart-counter-minus
                                class="button add-cart-counter__controls-btn"
                                type="button">-</button>
                              <a href="{{cart_url}}" class="button add-cart-counter__detail">
                                <span class="add-cart-counter__detail-text">
                                  <span class="add-cart-counter__detail-label">{{ messages.btn_buy_active_text }}</span>
                                  <span data-add-cart-counter-count class="add-cart-counter__detail-count"></span>
                                  {{ product.unit }}
                                </span>
                                <span class="add-cart-counter__detail-dop-text">{{ messages.btn_buy_active_detail }}</span>
                              </a>
                              <button
                                data-add-cart-counter-plus
                                class="button add-cart-counter__controls-btn"
                                type="button">+</button>
                            </div>
                          </div>

                          <button
                            data-product-card-preorder
                            class="button button_wide product-preview__preorder-btn"
                            type="button">{{ messages.pre_order }}</button>

                          <a href="{{product.url}}" class="button button_wide product-preview__detail-btn">{{ messages.more_details }}</a>

                          <a href="{{product.url}}" class="button button_wide product-preview__detail-select-btn">{{ messages.select }}</a>


                          {% else %}
                            <a href="{{product.url}}" class="button button_wide buy_button_action">{{ messages.more_details }}</a>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  </form>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      {% assign page_has_list_item = true %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign image_title = null %}
{% assign block_name = null %}
{% assign product_variants_first = null %}
{% assign preview_text = null %}
