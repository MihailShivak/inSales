      </svg>
      <span class="header__top-link">{{ widget_settings['url_1-title'] }}</span>
    </a>
  </div>
  <div class="header__bottom">
    <a href="/" class="header__logo">
      <div class="header__mob-shop__title">Доставим из магазина</div>
      <img
        src="{{ logo_default }}"
        data-shop-logo
        data-barakat="{{ logo_barakat }}"
        data-fermerskaya="{{ logo_fermerskaya }}"
        alt="Логотип"
      >
    </a>
    <div class="header__search">
      <div class="input-group__wrapper" data-js-search>
        <div class="header__icon icon_search"></div>
        <input
          autocomplete="off"
          type="text"
          placeholder="Найти нужный товар ..."
          class="input-group__input input"
          data-popup="#popup-search"
          data-search-input
        >
        <button type="button" data-js="input-clear" class="input-group__clear"></button>
      </div>
    </div>
    <div class="header__address">
      <div class="input-group__wrapper">
        <div class="header__icon icon_address"></div>
        <input
          autocomplete="off"
          type="text"
          placeholder="Магазин доставки"
          class="input-group__input input"
          data-popup="#popup-delivery-shop"
          readonly
        >
        <button type="button" class="icon_arrow" data-popup="#popup-delivery-shop"></button>
      </div>
    </div>
    <div class="header__actions">
      <a href="/client_account/orders" class="header__icon-big icon_user"></a>
      <a href="/favorites" class="header__icon-big icon_favorites"></a>
      <a href="/cart_items" class="header__actions-wrapper" data-btn-cart>
        <div class="header__icon icon_cart">
          <span class="icon-counter" data-em-cart-count>1</span>
        </div>
        <span class="header__price" data-em-cart-price></span>
      </a>
      {% comment %} <button type="button" class="header__icon icon__cart"></button> {% endcomment %}
    </div>
  </div>
  <div class="header__mob">
    <div class="header__mob-logo">
      <a href="/">
        <div class="header__mob-shop__title">Доставим из магазина</div>
        <img
          class="header__mob-logo__img"
          src="{{ widget_settings.logo_img | replace: 'static.insales-cdn.com', 'ibicecdn.com/gastromania' }}"
          alt="Логотип"
        >
      </a>
      <button type="button" class="header__mob-shop__btn" data-popup="#popup-delivery-shop">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="5" viewBox="0 0 25 5" fill="none">
          <circle cx="2.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="2.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="2.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="2.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="12.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="12.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="12.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="12.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="22.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="22.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="22.5" cy="2.5" r="2.5" fill="#2394F0"/>
          <circle cx="22.5" cy="2.5" r="2.5" fill="#2394F0"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<div class="header__mob-fix {% unless template == "index" %} _disabled-mob {% endunless %}" data-em-header-fix>
  <div class="header__mob-logo">
