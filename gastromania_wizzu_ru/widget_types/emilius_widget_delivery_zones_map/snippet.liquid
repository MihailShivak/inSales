            <div class="map-container">
                <div id="zone-delivery-map" class="delivery-map"></div>
            </div>
        </div>
        <div class="modal__map-descript">
            <span>Выберите магазин</span>, чтобы увидеть его зону доставки
        </div>
        <button type="button" class="btn btn_small btn__disabled-grey" data-submit-request data-dl-select="unavailable" hidden>Оставить заявку</button>
        <button type="button" class="btn btn_small btn__disabled-grey" data-change-store data-dl-select="available">Перейти в магазин</button>
        <button type="button" class="btn__back" data-form-back data-dl-select="unavailable" hidden>Вернутсья назад</button>
    </div>
    <div class="modal-close modal__back-close"></div>
</div>

<!-- Модалка успеха -->
<div class="popup popup-delivery popup-success" id="popup-delivery-success">
    <div class="modal__content">
        <div class="modal__delivery-title">Заявка отправлена!</div>
        <div class="modal__success-info">
            <img class="success__heart" src="{{ "heart.png" |  asset_url | replace: 'static.insales-cdn.com', 'ibicecdn.com/gastromania' }}" alt="">
            <div class="modal__success-text">
                <div class="success-text">Благодарим Вас за интерес к нашему сервису.</div>
                <div class="success-text">
                    Чем больше заявок мы получим, тем быстрее начнём доставку в вашем районе.
                </div>
            </div>
        </div>        
        <div class="btn__wrapper-success">
            <button type="button" class="btn btn_small" data-comeback-delivery>Выбрать другой район</button>
            <a href="https://wizzu.ru/" class="btn__back">Вернуться в демо-версию каталога</a>
        </div>
    </div>
    <div class="modal-close modal__back-close"></div>
</div>

<!-- Модалка с предупреждением -->
{% if widget_settings.show_popup %}
    <div class="modal popup-warning popup_hide" id="popup-message-warning">
        <div class="modal__content">
            <div class="modal__title">{{ widget_settings.title }}</div>
            <div class="modal__text">{{ widget_settings.desc }}</div>
            <div class="btn__wrapper">
                <button type="button" class="btn btn_average btn_warning-accept" data-close-popup="popup-message-warning">{{ widget_settings.btn-text }}</button>
            </div>
        </div>
    </div>
{% endif %}