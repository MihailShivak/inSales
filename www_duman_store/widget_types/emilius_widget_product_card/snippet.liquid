                                        </svg>
                                        <div class="payments__btn-icon"></div>
                                    </button>
                                    <div class="payment__subtitle">Разбить платеж</div>
                                    <div class="payment__btns" data-payments-card>
                                        <button type="button" class="btn btn_payment _active" data-payplait-four>на 4 части</button>
                                        <button type="button" class="btn btn_payment">на 6 частей</button>
                                    </div>
                                    <div class="payment__desc"><span>{{ payment_share | money }}</span> сейчас, остальное — потом</div>
                                </div>
                                <div class="payment-item">
                                    <button type="button" class="payment__head" data-popup="#popup-parts">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="84" height="12" viewBox="0 0 84 12" fill="none">
                                        <path d="M14.9089 0H12.9066V10.1533H14.9089V0Z" fill="black"/>
                                        <path d="M10.6067 0.568146H8.60443V10.7212H10.6067V0.568146Z" fill="black"/>
                                        <path d="M6.30444 1.20242H4.30222V11.3574H6.30444V1.20242Z" fill="black"/>
                                        <path d="M2.00223 1.84375H0L7.62939e-06 12H2.00224L2.00223 1.84375Z" fill="black"/>
                                        <path d="M67.7912 5.40947L64.5673 1.82506H62.6826V10.1242H64.6504V4.8292L67.5937 7.96631H67.9574L70.8501 4.8292V10.1242H72.8179V1.82506H70.9332L67.7912 5.40947Z" fill="black"/>
                                        <path d="M82.1928 1.82506L77.3155 7.21921V1.82506H75.3477V10.1242H77.1505L82.0278 4.73006V10.1242H83.9956V1.82506H82.1928Z" fill="black"/>
