{
  "{{ messages.text_filling }}": [
    {
      "group_name": "{{ messages.title_name }}",
      "items": [
        {
          "class": "checkbox",
          "name": "if-page-title",
          "label": "{{ messages.title_checkbox_label }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "text",
          "name": "title",
          "label": "{{ messages.title_text_label }}",
          "value": null,
          "type": "text"
        }
      ] 
    },
    {
      "group_name": "{{ messages.subtitle_name }}",
      "items": [
        {
          "class": "checkbox",
          "name": "if-breadcrumbs",
          "label": "{{ messages.subtitle_checkbox_label }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "text",
          "name": "subtitle",
          "label": "{{ messages.subtitle_text_label }}",
          "value": null,
          "type": "text"
        }
      ]
    },
    {
      "group_name": "{{ messages.p_bg }}",
      "items": [
        {
          "class": "checkbox",
          "name": "if-image",
          "label": "{{ messages.p_if_auto }}",
          "value": null,
          "type": "checkbox",
          "help": "{{ messages.p_if_auto_help }}"
        },
        {
          "name":"image-bg",
          "label":"{{ messages.p_image }}",
          "value":null,
          "type":"file"
        }
      ]
    }
  ],
  "{{ messages.text_style }}": [
    {
      "items": [
        {
          "name":"color-text",
          "label":"{{ messages.p_text_color }}",
          "value":"",
          "type":"color",
          "clearable":true
        },
        {
          "name": "text-align",
          "options": [
            [
              "{{ messages.text_align_left }}",
              "left"
            ],
            [
              "{{ messages.text_align_center }}",
              "center"
            ],
            [
              "{{ messages.text_align_right }}",
              "right"
            ]
          ],
          "value": "center",
          "label": "{{ messages.text_align }} {{ messages.p_horizontal }}",
          "type": "select"
        },
        {
          "class":"range",
          "name":"custom-layout-pt",
          "min":0,
          "max":500,
          "step":10,
          "label":"{{ messages.padding_top }}",
          "type":"range",
          "unit":"px"
        },
        {
          "class":"range",
          "name":"custom-layout-pb",
          "min":0,
          "max":500,
          "step":10,
          "label":"{{ messages.padding_bottom }}",
          "type":"range",
          "unit":"px"
        },
        {
          "class": "range",
          "name": "title-font-size",
          "min": 1,
          "max": 5,
          "step": 0.1,
          "label": "{{ messages.text_size }} {{ messages.text_size_title }}",
          "type": "range",
          "unit": "rem"
        },
        {
          "class": "range",
          "name": "subtitle-font-size",
          "min": 1,
          "max": 2,
          "step": 0.1,
          "label": "{{ messages.text_size }} {{ messages.text_size_subtitle }}",
          "type": "range",
          "unit": "rem"
        }
      ]
    }
  ],
  "{{ messages.p_img_style }}":[
    {
      "group_name": "{{ messages.p_props }}",
      "items": [
        {
          "class": "range",
          "name": "border-radius",
          "label": "{{ messages.p_border_radius }}",
          "min": 0,
          "max" : 50,
          "step": 1,
          "unit": "px",
          "type": "range"
        }
      ]
    },
    {
      "group_name": "{{ messages.p_bg }}",
      "items":[
        {
          "name":"bg-image-color",
          "label":"{{ messages.p_bg_color }}",
          "value":"",
          "type":"color",
          "clearable":true
        },
        {
          "class": "range",
          "name": "bg-image-opacity",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "label": "{{ messages.p_bg_opacity }}",
          "type": "range",
          "unit": ""
        }
      ]
    }
  ],
  "{{ messages.p_mobile_set }}": [
    {
      "items":[
        {
          "class":"range",
          "name":"custom-layout-pt-sm",
          "min":0,
          "max":500,
          "step":10,
          "label":"{{ messages.padding_top }}",
          "type":"range",
          "unit":"px"
        },
        {
          "class":"range",
          "name":"custom-layout-pb-sm",
          "min":0,
          "max":500,
          "step":10,
          "label":"{{ messages.padding_bottom }}",
          "type":"range",
          "unit":"px"
        },
        {
          "class": "range",
          "name": "title-font-size-sm",
          "min": 0.5,
          "max": 5,
          "step": 0.1,
          "label": "{{ messages.text_size }} {{ messages.text_size_title }}",
          "type": "range",
          "unit": "rem"
        },
        {
          "class": "range",
          "name": "subtitle-font-size-sm",
          "min": 0.5,
          "max": 2,
          "step": 0.1,
          "label": "{{ messages.text_size }} {{ messages.text_size_subtitle }}",
          "type": "range",
          "unit": "rem"
        }
      ]
    }
  ],
  "{{ messages.settings_gen }}": [
    {
      "group_name":"{{ messages.indentation }}",
      "items":[
        {
          "class":"range",
          "name":"layout-mt",
          "min":0,
          "max":10,
          "step":0.5,
          "label":"{{ messages.margin_top }}",
          "type":"range",
          "unit":"vw"
        },
        {
          "class":"range",
          "name":"layout-mb",
          "min":0,
          "max":10,
          "step":0.5,
          "label":"{{ messages.margin_bottom }}",
          "type":"range",
          "unit":"vw"
        }
      ]
    },
    {
      "group_name":"{{ messages.background }}",
      "items":[
        {
          "class":"checkbox",
          "name":"layout-wide-bg",
          "label":"{{ messages.wide_background }}",
          "value":null,
          "type":"checkbox"
        }
      ]
    },
    {
      "group_name":"{{ messages.content_settings }}",
      "items":[
        {
          "class":"range",
          "name":"layout-content-max-width",
          "min":400,
          "max":2000,
          "step":2,
          "label":"{{ messages.content_max_width }}",
          "type":"range",
          "unit":"px"
        },
        {
          "class":"checkbox",
          "name":"layout-wide-content",
          "label":"{{ messages.wide_content }}",
          "value":null,
          "type":"checkbox"
        },
        {
          "class":"checkbox",
          "name":"layout-edge",
          "label":"{{ messages.edge }}",
          "value":null,
          "type":"checkbox"
        }
      ]
    },
    {
      "group_name":"{{ messages.adaptive }}",
      "items": [
        {
          "class": "checkbox",
          "name": "hide-desktop",
          "label": "{{ messages.hide_desktop }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "checkbox",
          "name": "hide-mobile",
          "label": "{{ messages.hide_mobile }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    }
  ]
}