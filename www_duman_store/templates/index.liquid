{% assign schema_product_ids = '' %}
{% assign schema_product_items = '' %}
{% assign schema_position = 0 %}
{% assign schema_has_items = false %}

{% for widgetDrop in widget_lists.index-list.widgets %}
  {% widget widgetDrop %}
{% endfor %}

<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": "Интернет-магазин дизайнерской женской одежды DUMAN",
	"url": "https://www.duman.store",
	"description": "DUMAN - бренд женской casual одежды из Новосибирска. Платья, рубашки, костюмы, брюки, юбки: эксклюзивный крой и качественные ткани. Широкий ассортимент удобной и практичной одежды на каждый день.",
	"mainEntity": {
		"@type": "ItemList",
    "itemListElement": [
      {{ schema_product_items | strip | replace_last: ',', '' }}
    ],
    "numberOfItems": {{ schema_position }}
  }
}
</script>