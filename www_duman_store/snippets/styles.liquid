<link href="{{ 'theme_default.css' | asset_url }}" rel="stylesheet" type="text/css" />

{% comment %} CSS default {% endcomment %}
<link href="{{ 'theme.css' | asset_url }}" rel="stylesheet" type="text/css" />
<link href="{{ 'icons.css' | asset_url }}" rel="stylesheet" type="text/css" />

{% comment %} Минификация CSS {% endcomment %}
{% comment %} <link href="{{ 'theme.min.css' | asset_url }}" rel="stylesheet" type="text/css" /> {% endcomment %}
{% comment %} <link href="{{ 'icons.min.css' | asset_url }}" rel="stylesheet" type="text/css" /> {% endcomment %}

{% if template contains "page" or template contains "blog" or template contains "article" %}
    <link href="{{ 'page.css' | asset_url }}" rel="stylesheet" type="text/css" />
{% endif %}