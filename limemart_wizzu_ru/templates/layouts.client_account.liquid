												</svg> {% endcomment %}
											</a>
											<a href="https://www.instagram.com/wizzu.ru?utm_source=website&utm_medium=store-icons&utm_campaign=own&utm_content=futter-icons&utm_term=instagram-button" target="_blank">
												<svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 38 38" fill="none">
												<rect width="38" height="38" rx="19" fill="url(#paint0_linear_500_317)"/>
