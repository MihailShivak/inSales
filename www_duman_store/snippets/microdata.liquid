{%- if template contains 'product' -%}
{%- assign product_description = product.description | strip_html -%}
{%- unless product.description -%}
{%- assign product_description = product.short_description | strip_html -%}
{%- endunless -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/", 
  "@type": "Product", 
  "name": "{{ product.title | escape  }}",
  "image": "{{ product.images.first.original_url }}",
  "description": {{ product_description | escape | json  }},
  "brand": "{{ product.properties.brend.characteristics.first.name }}",
  "sku": "{{ product.sku }}",
  "offers": {
  	"@type": "AggregateOffer",
    "lowPrice": "{{ product.price_min }}",
    "highPrice": "{{ product.price_max }}",
    "priceCurrency": "{{ account.currency_code }}",
    "offerCount": "{{ product.variants.size }}",
    "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
    	"url": "{{ product.url }}",
    	"priceCurrency": "{{ account.currency_code }}",
    	"price": "{{ variant.price }}",
        "sku": "{{ variant.id }}",
    	"availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]  
  }
  {%- if product.rating -%},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.rating }}",
    "worstRating": "1",
    "bestRating": "5",
    "ratingCount": "{{ product.reviews_count }}",
    "reviewCount": "{{ product.reviews_count }}"
  },
  "review": [
  	{%- for review in product.reviews -%}
    {
      "@type": "Review",
      "name": "{{ product.title | escape  }}",
      "reviewBody": {{ review.content | strip_html | escape | json }},
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{% if review.rating %}{{ review.rating }}{% else %}5{% endif %}",
        "bestRating": "5",
        "worstRating": "1"
      },
      "datePublished": "{{ review.created_at | date: "%Y-%m-%d" }}",
      "author": {"@type": "Person", "name": "{{ review.author }}"}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>

{%- comment -%} BreadcrumbList для товара {%- endcomment -%}
  {%- assign root_collection = nil -%}
  {%- for col in product.collections -%}
    {%- if col.level == 1 -%}
      {%- assign root_collection = col -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- unless root_collection -%}
    {%- assign sorted_cols = product.collections | sort: 'level' -%}
    {%- assign root_collection = sorted_cols.first -%}
  {%- endunless -%}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": {{ shop.url | append: '/' | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Каталог",
        "item": {{ shop.url | append: '/collection/all' | json }}
      }{%- if root_collection -%},
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ root_collection.title | json }},
        "item": {{ shop.url | append: root_collection.url | json }}
      }{%- endif -%},
      {
        "@type": "ListItem",
        "position": {% if root_collection %}4{% else %}3{% endif %},
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
    ]
  }
  </script>

  {%- elsif template contains 'collection' -%}
  {%- comment -%} === BreadcrumbList для категории === {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": {{ shop.url | append: '/' | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Каталог",
        "item": {{ shop.url | append: '/collection/all' | json }}
      }{%- if collection.handle != 'all' -%},
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }{%- endif -%}
    ]
  }
  </script>

