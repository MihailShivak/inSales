{% capture product_time %}{{'now' | date: '%s.%L' }}{% endcapture %}

{% assign is_offline_only = false %}
{% for property in product.properties %}
  {% if property.name == 'Доступен только офлайн' or property.handle == 'dostupen-tolko-oflain' %}
    {% for char in property.characteristics %}
      {% if char.name == 'Да' or char.handle == 'da' %}
        {% assign is_offline_only = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if is_offline_only %}{% break %}{% endif %}
{% endfor %}

<!-- breadcrumbs -->
{% assign root_collection = null %}
{% for col in product.collections %}
  {% if col.level == 1 %}
    {% assign root_collection = col %}
    {% break %}
  {% endif %}
{% endfor %}

{% unless root_collection %}
  {% assign sorted_collections = product.collections | sort: 'level' %}
  {% assign root_collection = sorted_collections.first %}
{% endunless %}

{% assign collection_back_url = root_collection.url | default: '/collection/all' %}

{% capture breadcrumbs %}
<div class="breadcrumbs__body">
  <ul class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a href="/" class="breadcrumbs__link">Главная</a>
    </li>
    <li class="breadcrumbs__item">
      <a href="/collection/all" class="breadcrumbs__link">Каталог</a>
    </li>
    {% if root_collection %}
    <li class="breadcrumbs__item">
      <a href="{{ root_collection.url }}" class="breadcrumbs__link">{{ root_collection.title }}</a>
    </li>
    {% endif %}
    <li class="breadcrumbs__item breadcrumbs__item--current">
      <span>{{ product.title }}</span>
    </li>
  </ul>
</div>
{% endcapture %}
<!-- breadcrumbs end -->

{% if collection_back_url %}
  <div class="breadcrumbs-chevron">
    <a href="{{ collection_back_url }}" class="chevron__link">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7.65374 9.99989L13.931 16.2772C14.0966 16.4427 14.1773 16.6377 14.1731 16.862C14.1688 17.0864 14.0839 17.2814 13.9183 17.447C13.7526 17.6125 13.5576 17.6953 13.3333 17.6953C13.109 17.6953 12.914 17.6125 12.7483 17.447L6.35582 11.0672C6.20513 10.9165 6.09346 10.7477 6.02082 10.5607C5.94818 10.3738 5.91187 10.1868 5.91187 9.99989C5.91187 9.81295 5.94818 9.626 6.02082 9.43906C6.09346 9.25211 6.20513 9.08329 6.35582 8.9326L12.7483 2.53989C12.914 2.37433 13.1112 2.29371 13.3398 2.29802C13.5684 2.30232 13.7655 2.38725 13.931 2.55281C14.0966 2.71836 14.1794 2.91336 14.1794 3.13781C14.1794 3.36211 14.0966 3.55704 13.931 3.7226L7.65374 9.99989Z" fill="white"/>
      </svg>
    </a>
  </div>
{% endif %}

<div class="breadcrumbs">
  <div class="breadcrumbs__container">{{ breadcrumbs }}</div>
</div>

<!-- product-card -->
{% assign img_title = product.title | escape %}
<section class="product-card">
  <div class="product-card__container">
    <div class="product-card__body">
      <div class="product-card__gallery swiper">
        <div class="product-card__gallery-wrapper swiper-wrapper">
          {% assign popup_i = 0 %}

          {% comment %} Видео {% endcomment %}
          {% comment %} Дописать обработку видео в попапе {% endcomment %}
          {% if product.video_links.size > 0 %}
            {% capture videos_html %}
                            {% for video in product.video_links %}
                                {% assign popup_i = popup_i | plus: 1 %}
                                <div class="product-card__gallery-item swiper-slide">
                                    <button type="button" data-popup="#popup-gallery" data-popup-id="{{ popup_i }}" class="product-card__img">
                                        <video data-em-video="{{ video.url }}" data-video-i="{{ popup_i }}"
											autoplay 
											muted 
											playsinline webkit-playsinline loop
											preload="metadata"
											class="product__gallery-video">
                                            <!-- Fallback для браузеров без поддержки HLS -->
                                            {% comment %} <source src="{{ product.video_links[0].url }}.mp4" type="video/mp4"> {% endcomment %}
                                            Ваш браузер не поддерживает воспроизведение видео.
                                        </video>
                                        <picture>
                                            <!-- webp -->
                                            <source media="(min-width: 1500px)" 
                                                srcset="{{ product.first_image | image_url: 1200, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                                                type="image/webp">
                                            <source media="(min-width: 1024px)" 
                                                srcset="{{ product.first_image | image_url: 850, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                                                type="image/webp">
                                            <source media="(min-width: 350px)" 
                                                srcset="{{ product.first_image | image_url: 1400, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                                                type="image/webp">

                                            <!-- Fallback версии в оригинальном формате -->
                                            <source media="(min-width: 1500px)" 
                                                srcset="{{ product.first_image | image_url: 1200 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}">
                                            <source media="(min-width: 1024px)" 
                                                srcset="{{ product.first_image | image_url: 850 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}">
                                            <source media="(min-width: 350px)" 
                                                srcset="{{ product.first_image | image_url: 1400 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}">

                                            <img class="product__preview-video" 
                                                src="{{ product.first_image | image_url: 950 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2' }}" 
                                                title="{{ img_title }}" alt="{{ img_title }}">
                                        </picture>
                                    </button>
                                </div>
                            {% endfor %}
                        {% endcapture %}
          {% endif %}

          {% if videos_html and product.fields.video_output_order.value != 'конец' %}
            {{ videos_html }}
          {% endif %}
          {% if product.images.size > 0 %}
            {% for image in product.images %}
              <div class="product-card__gallery-item swiper-slide">
                {% assign popup_i = popup_i | plus: 1 %}
                <button
                  type="button"
                  data-popup="#popup-gallery"
                  data-popup-id="{{ popup_i }}"
                  class="product-card__img"
                >
                  <picture>
                    <!-- webp -->
                    <source
                      media="(min-width: 1700px)"
                      srcset="{{ image | image_url: 1500, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                      type="image/webp"
                    >
                    <source
                      media="(min-width: 1500px)"
                      srcset="{{ image | image_url: 1200, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                      type="image/webp"
                    >
                    <source
                      media="(min-width: 1024px)"
                      srcset="{{ image | image_url: 850, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                      type="image/webp"
                    >
                    <source
                      media="(min-width: 350px)"
                      srcset="{{ image | image_url: 1400, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                      type="image/webp"
                    >

                    <!-- Fallback версии в оригинальном формате -->
                    <source
                      media="(min-width: 1700px)"
                      srcset="{{ image | image_url: 1500 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                    >
                    <source
                      media="(min-width: 1500px)"
                      srcset="{{ image | image_url: 1200 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                    >
                    <source
                      media="(min-width: 1024px)"
                      srcset="{{ image | image_url: 850 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                    >
                    <source
                      media="(min-width: 350px)"
                      srcset="{{ image | image_url: 1400 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2'}}"
                    >

                    <img
                      src="{{ image | image_url: 950 | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2' }}"
                      title="{{ img_title }}"
                      alt="{{ img_title }}"
                      data-ll-status="loaded"
                    >
                  </picture>
                </button>
              </div>
            {% endfor %}
          {% else %}
            <div class="product-card__gallery-item swiper-slide">
              <div type="button" class="product-card__img image-none">
                <img
                  src="{{ 'no_image.svg' | asset_url }}"
                  title="{{ img_title }}"
                  alt="{{ img_title }}"
                  class="image-none"
                >
              </div>
            </div>
            <div class="product-card__gallery-item swiper-slide">
              <div type="button" class="product-card__img image-none">
                <img
                  src="{{ 'no_image.svg' | asset_url }}"
                  title="{{ img_title }}"
                  alt="{{ img_title }}"
                  class="image-none"
                >
              </div>
            </div>
          {% endif %}
          {% if videos_html and product.fields.video_output_order.value == 'конец' %}
            {{ videos_html }}
          {% endif %}
        </div>
        <div class="product-card__gallery-pagination"></div>
      </div>
      <div class="mob-breadcrumbs" data-mob-breadcrumbs hidden>{{ breadcrumbs }}</div>
      <div class="product-card__info">
        <form action="{{ cart_url }}" method="post" class="product-card__form" data-product-id="{{ product.id }}">
          <div class="product-card-info__group">
            {% if product.available %}
              <div class="product-card__badges">
                {%- for collection in product.collections -%}
                  {%- if collection.handle == 'sale' and product.price < product.old_price -%}
                    <span class="badge-sale">
                      <span>SUPER SALE</span>
                      <span>
                        {{-
                          product.old_price
                          | minus: product.price
                          | divided_by: product.old_price
                          | times: 100
                          | round: 0
                        -}}
                        %</span
                      >
                    </span>
                  {%- elsif collection.handle == 'novinki' -%}
                    <span class="products-item__badge">Новинка</span>
                  {%- endif -%}
                {%- endfor -%}
                {% if is_offline_only %}
                  <span class="products-item__badge">Доступен только офлайн</span>
                {% endif %}
              </div>
            {% endif %}
            <h1 class="product-card-info__title">{{ product.title | editable }}</h1>
            <div class="product-card-info__prices-wrapper">
              <div class="product-card-info__prices-list">
                {% if product.available == false
                  and product.properties['skoro-v-prodazhe'].characteristics.first.name == 'Да'
                %}
                  <div class="products-item__button btn btn_outline btn_small">Скоро в продаже</div>
                {% elsif product.old_price and product.price < product.old_price %}
                  <div class="product-card-info__prices-item _price-new">{{ product.price | money }}</div>
                  <div class="product-card-info__prices-item _price-old">{{ product.old_price | money }}</div>
                {% else %}
                  <div class="product-card-info__prices-item">{{ product.price | money }}</div>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="product-card-info__group">
            <div class="product-card-info__options-wrapper" data-product-colors>
              {% for option in product.options %}
                {% if option.title == 'Цвет' %}
                  <div class="product-card-info__options-title">Цвет: {{ option.values.first.title }}</div>
                  {% assign currentColor = option.values.first.title %}
                  {% break %}
                {% endif %}
              {% endfor %}
              <div
                class="product-card-info__options colors-list"
                {%- if product.available -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.available -%}
                      data-first-variant="{{ variant.id }}"
                      data-variant-sku="{{ variant.sku }}"
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  data-first-variant="{{ product.variants.first.id }}"
                  data-variant-sku="{{ product.variants.first.sku }}"
                {%- endif -%}
              ></div>
              {% comment %}
                <div class="product-card-info__options colors-list">
                    {% assign name = product.canonical_collection.url | remove: '/collection/' %}
                    {% for prod in collections[name].products %}
                        {% if prod.sku == product.sku %}
                            {% for option in prod.options %}
                                {% if option.title == 'Цвет' %}
                                    {% for value in option.values %}
                                        {% if value.title == currentColor %}
                                            <div class="colors-list__item _active">
                                                <img data-src="{% if value.image_url %}{{ value.image_url | image_url: 32}}{% endif %}" alt="">
                                            </div>
                                        {% else %}
                                            <a href="{{ prod.url }}" class="colors-list__item {% if value.title == currentColor %} _active {% endif %}">
                                                <img data-src="{% if value.image_url %}{{ value.image_url | image_url: 32}}{% endif %}" alt="">
                                            </a>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>
              {% endcomment %}
            </div>
            <div class="product-card-info__options-wrapper">
              <div class="product-card-info__options-title">
                Размер: <span data-variant-select></span>
                <span class="options__title-last" hidden>, последний</span>
              </div>
              <div class="product-card-info__options checkbox-list" data-product-variants-list>Загружаем...</div>
              {% if is_offline_only %}
                <div
                  class="product-card-info__offline-notice"
                  style="display: flex; align-items: flex-start; gap: 8px; margin-top: 12px; margin-bottom: 16px; color: #A46C4A; font-size: 14px; line-height: 1.4;"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="#A46C4A"
                    style="flex-shrink: 0; margin-top: 2px;"
                  >
                    <path d="M7.99967 1.33203C4.3237 1.33203 1.33301 4.32272 1.33301 7.9987C1.33301 11.6747 4.3237 14.6654 7.99967 14.6654C11.6757 14.6654 14.6663 11.6747 14.6663 7.9987C14.6663 4.32272 11.6757 1.33203 7.99967 1.33203ZM7.99967 2.33203C11.1352 2.33203 13.6663 4.86316 13.6663 7.9987C13.6663 11.1342 11.1352 13.6654 7.99967 13.6654C4.86414 13.6654 2.33301 11.1342 2.33301 7.9987C2.33301 4.86316 4.86414 2.33203 7.99967 2.33203ZM7.99967 4.66536C7.82286 4.66536 7.65329 4.7356 7.52827 4.86063C7.40325 4.98565 7.33301 5.15522 7.33301 5.33203C7.33301 5.50884 7.40325 5.67841 7.52827 5.80344C7.65329 5.92846 7.82286 5.9987 7.99967 5.9987C8.17649 5.9987 8.34606 5.92846 8.47108 5.80344C8.5961 5.67841 8.66634 5.50884 8.66634 5.33203C8.66634 5.15522 8.5961 4.98565 8.47108 4.86063C8.34606 4.7356 8.17649 4.66536 7.99967 4.66536ZM7.99186 6.99154C7.85937 6.99361 7.73311 7.04818 7.64083 7.14327C7.54854 7.23837 7.49777 7.3662 7.49967 7.4987V11.1654C7.49874 11.2316 7.51098 11.2974 7.53569 11.3589C7.56039 11.4204 7.59707 11.4763 7.64359 11.5235C7.69012 11.5707 7.74555 11.6082 7.80668 11.6337C7.86781 11.6593 7.93341 11.6725 7.99967 11.6725C8.06594 11.6725 8.13154 11.6593 8.19267 11.6337C8.2538 11.6082 8.30923 11.5707 8.35575 11.5235C8.40228 11.4763 8.43896 11.4204 8.46366 11.3589C8.48837 11.2974 8.50061 11.2316 8.49967 11.1654V7.4987C8.50063 7.43178 8.48815 7.36534 8.46296 7.30333C8.43777 7.24133 8.40039 7.18501 8.35304 7.13771C8.30568 7.09041 8.24931 7.05311 8.18727 7.028C8.12523 7.00289 8.05878 6.99049 7.99186 6.99154Z" fill="#A46C4A"></path>
                  </svg>
                  <span>Товар доступен только для примерки и покупки в офлайн-магазине</span>
                </div>
              {% endif %}
            </div>
            <div class="product-card-info__buttons">
              <button
                type="button"
                class="product-card-info__button btn btn_large btn_primary button__hide"
                data-em-select-variant
                {% if is_offline_only %}
                  style="display: none;"
                {% endif %}
              >
                <span>Выберите размер</span>
              </button>
              <div class="fav_boc_btns">
                <button
                  type="button"
                  class="product-card-info__button btn-icon btn-icon_large btn-icon_secondary btn-icon_whishlist favorites-not-added"
                  data-em-favorites-trigger="{{ product.id }}"
                  {% if is_offline_only %}
                    style="flex: 0 0 auto;"
                  {% endif %}
                ></button>
                {% if is_offline_only %}
                  <a
                    class="map-link product-card-info__button btn btn_large btn_primary"
                    href="https://yandex.ru/maps/-/CTcbq254"
                    rel="noopener"
                    target="_blank"
                    style="flex: 1 1 auto; text-align: center; text-decoration: none; display: inline-flex; align-items: center; justify-content: center;"
                  >
                    На карте
                  </a>
                {% else %}
                  <button
                    type="button"
                    class="buy-one-click product-card-info__button btn btn_large btn_secondary"
                    data-popup="#popup-buy-one-click"
                    data-boc-trigger
                    data-variant-id="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}"
                    data-product-title="{{ product.title | escape }}"
                  >
                    Купить в 1 клик
                  </button>
                {% endif %}
              </div>
            </div>
            {% if product.available or product.properties['skoro-v-prodazhe'].characteristics.first.name != 'Да' %}
              {% assign payment_share = product.price | divided_by: 4 | round: 0 %}

              <div class="payments">
                <div class="payment-item">
                  <button type="button" class="payment__head" data-popup="#popup-plait">
                    <svg xmlns="http://www.w3.org/2000/svg" width="87" height="24" viewBox="0 0 87 24" fill="none">
                      <path d="M23.445 17.8995H18.4301C18.4301 16.1954 17.7531 14.5611 16.5481 13.3561C15.3432 12.1511 13.7088 11.4741 12.0047 11.4741C10.3006 11.4741 8.6663 12.1511 7.46131 13.3561C6.25632 14.5611 5.57937 16.1954 5.57937 17.8995H0.564453C0.564453 14.8654 1.76976 11.9555 3.91523 9.81001C6.0607 7.66454 8.97058 6.45923 12.0047 6.45923C15.0389 6.45923 17.9487 7.66454 20.0942 9.81001C22.2397 11.9555 23.445 14.8654 23.445 17.8995Z" fill="#6969FF"/>
