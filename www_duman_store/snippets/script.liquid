<script src="https://dumansto.re/assets/js/city_autoselect.js" charset="utf-8"></script>

<script>
  (function () {
    var done = false;

    function showPage() {
      if (done) return;
      done = true;
      document.body.classList.add('settings_loaded');
    }

    function showSlowConnection() {
      if (done) return;
      var loading = document.querySelector('.preloader__loading');
      var slow = document.querySelector('.preloader__slow');
      if (loading) loading.style.display = 'none';
      if (slow) slow.classList.add('_visible');
    }

    // Ждём загрузки всех <link rel="stylesheet"> в DOM.
    // link.sheet становится не-null только после применения CSS.
    function waitForCSS() {
      var links = Array.from(document.querySelectorAll('link[rel="stylesheet"]'));

      if (links.length === 0) {
        showPage();
        return;
      }

      const pending = links.filter((l) => !l.sheet);

      if (pending.length === 0) {
        showPage();
        return;
      }

      var remaining = pending.length;
      const onDone = () => {
        remaining--;
        if (remaining <= 0) showPage();
      };

      pending.forEach((link) => {
        link.addEventListener('load', onDone);
        link.addEventListener('error', onDone);
      });
    }

    // Через 10 секунд показываем сообщение о плохом соединении
    setTimeout(showSlowConnection, 10000);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', waitForCSS);
    } else {
      waitForCSS();
    }
  })();
</script>