<script type="text/template" data-template-id="product-viewed">
  <div class="product-item swiper-slide <%= avialable ? '' : 'product-item_disabled' %>" data-product-id="<%= product_id %>" data-variant-id="<%= variant_id %>">
      <div class="products-item__actions">
          <button type="button" class="products-item__action icon_favorite"
              data-ui-favorites-trigger="<%= product_id %>">
          </button>
      </div>
      <a href="<%= url %>">
          <div class="products-item__img">
              <img src="<%= image %>" alt="<%= title %>" loading="lazy">
              <% if(old_price > 0) { %>
                  <span class="products-item__badge">-<%= deltPrice %>%</span>
              <% } %>
          </div>
          <div class="products-item__info">
              <div class="products-item__title"><%= title %></div>
              <div class="products-item__descr"><%= descript %></div>
          </div>
      </a>
      <div class="products-item__prices">
          <span class="products-item__price<% if(old_price > 0) { %> products-item__price-new<% } %>">
              <% if(!avialable) { %>
                  Закончился
              <% } else if (gram > 0) { %>
                  <%= (priceNotFormat / gram ).toFixed(1).replace(/\.0$/, '') %> ₽<span class="item__price-step_mini"> за <%= (1000 / gram ).toFixed() %>г.</span>
              <% } else { %>
                  <%= price %>
              <% } %>
          </span>
          <% if(avialable && old_price > 0) { %>
              <span class="products-item__price-old">
                  <s>
                      <% if(gram > 0) { %>
                          <%= (old_price / gram ).toFixed(1).replace(/\.0$/, '') %> ₽
                      <% } else { %>
                          <%= Shop.money.format(old_price) %>
                      <% } %>
                  </s>
              </span>
          <% } %>
      </div>
      <% if(avialable) { %>
          <div class="btn__add btn btn_small<% if(isInCart) { %> cart-added<% } %>" data-product-add="<%= variant_id %>">
              <button type="button" class="quantity__button quantity__button_minus" data-btn-minus>-</button>
              <span>В корзину</span>

              <input type="text" class="quantity__input" value="<% if(isInCart) { %><%= quantity %><%= unit ? ' ' + unit : '' %><% } %>"
                  data-max-qantity="<%= maxQuantity.quantity %>"
                  data-max-qantity-default="<%= maxQuantity.maxQuantityDefault %>"
                  data-package-qantity="<%= package %>"
                  data-product-unit="<%= unit %>"
              />
              <button type="button" class="quantity__button quantity__button_plus" data-btn-plus>+</button>
          </div>
      <% } %>
      <% if(maxQuantity.isAccept) { %>
          <div class="product__message-error" style="display:none;">Нельзя добавить больше <%= maxQuantity.quantity %><%= unit %></div>
      <% } %>
  </div>
</script>
