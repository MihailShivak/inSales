{% comment %} ! Выбранный фильтр {% endcomment %}
<script type="text/template" data-template-id="filter-selected">
    <div class="selected-filters__item" 
        data-selected-filter-id="<%= itemID %>" 
        data-filter-id="<%= id %>"
    >
        <% if (img) { %>
            <img class="selected-filters__item-color color" src="<%= img %>">
        <% } %>
        <div class="selected-filters__item-title"><%= title %></div>
        <button type="button" class="selected-filters__delete" data-remove-filter></button>
    </div> 
</script>

{% comment %} ! Выбранный фильтр цены {% endcomment %}
<script type="text/template" data-template-id="filter-selected-price">
    <div class="selected-filters__item" data-filter-id="<%= id %>">
        <div class="selected-filters__item-title">
            <span><%= Shop.money.format(priceMin) %></span> - <span><%= Shop.money.format(priceMax) %></span>
        </div>
        <button type="button" class="selected-filters__delete" data-remove-filter="price"></button>
    </div>
</script>