                                    <input autocomplete="off" 
                                        type="text" name="shipping_address[full_locality_name]" 
                                        data-error="Введите город" placeholder=""
                                        data-em-input-city
                                        class="em-input__city order__input input">
                                    <div class="select__body city-select__body">
                                        <div class="select__options" data-em-select-container-city hidden>
                                            <div data-simplebar="init" class="select__scroll">
                                                <div class="simplebar-content" data-em-select-sity></div>
                                            </div>
                                        </div>
                                    </div>
                                    {% comment %} <button type="button" data-em-input-clear class="order__input-clear"></button> {% endcomment %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__label">Способы доставки</div>
                            <div class="order__input-group">
                                <div class="order__options order-options" data-em-deliveries></div>
                            </div>
                        </div>
                    </div>
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__label">Адрес</div>
                            <div class="order__input-group">
                                <div class="order__input-wrapper" data-em-wrapper>
                                    <textarea autocomplete="off" placeholder="" 
                                        name="address" class="order__input input" 
                                        data-em-address
                                    ></textarea>
                                    {% comment %} <input 
                                        autocomplete="off" type="text" name="form[]" 
                                        data-error="Введите название улицы и номер дома" placeholder="Улица и дом" 
                                        class="order__input input"
                                        data-em-address> {% endcomment %}
                                    <button type="button" data-em-input-clear class="order__input-clear"></button>
                                </div>
                                <div class="order__input-grid order__input-grid_adress">
                                    {% comment %} <div class="order__input-wrapper">
                                        <input autocomplete="off" type="text" name="form[]" data-error="" placeholder="Квартира" class="order__input input">
                                    </div> {% endcomment %}
                                    <div class="order__input-wrapper" data-em-wrapper>
                                        <input autocomplete="off" placeholder="Подъезд" 
                                            type="number" min="1" max="1000"
                                            name="entrance"
                                            data-em-entrance
                                            class="order__input input">
                                    </div>
                                    <div class="order__input-wrapper" data-em-wrapper>
                                        <input autocomplete="off" placeholder="Этаж"
                                            type="number" min="1" max="1500"
                                            name="floor" 
                                            data-em-floor
                                            class="order__input input">
                                    </div>
                                    {% comment %} <div class="order__input-wrapper">
                                        <input autocomplete="off" type="text" name="form[]" data-error="" placeholder="Домофон" class="order__input input">
                                    </div> {% endcomment %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__label">Комментарий к&nbsp;заказу</div>
                            <div class="order__input-group">
                                <div class="order__input-wrapper">
                                    <textarea autocomplete="off" placeholder="" 
                                        class="order__input input" data-em-comment
                                    ></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="order__group">
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__title">2. Покупатель</div>
                        </div>
                        <div class="order__row">
                            <div class="order__label">Имя</div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__input-wrapper">
                                    <input autocomplete="off" type="text" name="name"
                                        placeholder="" 
                                        class="order__input input"
                                        data-em-name
                                    >
                                    <button type="button" data-em-input-clear class="order__input-clear"></button>
                                </div>
                            </div>
                        </div>
                        <div class="order__row">
                            <div class="order__label">Фамилия</div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__input-wrapper">
                                    <input autocomplete="off" type="text" name="surname" data-error="Введите фамилию" 
                                        placeholder="" 
                                        class="order__input input"
                                        data-em-surname
                                    >
                                    <button type="button" data-em-input-clear class="order__input-clear"></button>
                                </div>
                            </div>
                        </div>
                        <div class="order__row" hidden>
                            <div class="order__label">Дата рождения</div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__input-wrapper">
                                    <input 
                                        type="date" name="birthday" type="text" 
                                        class="order__input input input_datepicker"
                                        data-em-birthday
                                    >
                                </div>
                                <div class="order__input-note">
                                    Пришлем персональные предложения ко дню рождения
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__label">Телефон</div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__input-wrapper">
                                    <!-- placeholder="+7 (999) 999-99-99" -->
                                    <input 
                                        autocomplete="off" type="text" name="phone" 
                                        class="order__input input"
                                        data-em-phone data-mask-phone
                                    >
                                    <button type="button" data-em-input-clear class="order__input-clear"></button>
                                </div>
                            </div>
                        </div>
                        <div class="order__row" hidden>
                            <div class="order__label">Email</div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__input-wrapper">
                                    <input 
                                        autocomplete="off" type="text" 
                                        name="email" placeholder="" 
                                        class="order__input input"
                                        data-em-email>
                                    <button type="button" data-em-input-clear class="order__input-clear"></button>
                                </div>
                                <div class="order__input-note">
                                    Необходимо для отправки чека
                                </div>
                            </div>
                        </div>

                        <div class="order__row">
                            <div class="order__label">Удобный канал связи</div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__input-wrapper">
                                    <select class="em-select__channel form" data-em-select-channel>
                                        <option value="MAX">MAX</option>
                                        <option value="Telegram">Telegram</option>
                                        <option value="Email">Email</option>
                                    </select>
                                </div>
                                <div class="order__input-note">
                                    Где вам удобнее всего получать сообщения?
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__checkbox checkbox">
                                <label class="checkbox__label checkbox__label_filter">
                                    <input class="checkbox__input" 
                                        type="checkbox" value 
                                        name="subscribe">
                                    <span class="checkbox__text-wrapper">
                                        <span class="checkbox__point"></span>
                                        <span class="checkbox__text">Получать новости и узнавать о специальных предложениях в числе первых</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="order__group">
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__title">3. Оплата</div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__options order-options" data-em-payments></div>
                            </div>
                        </div>
                    </div>
                    <div class="order__row-wrapper">
                        <div class="order__row">
                            <div class="order__title"></div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__checkbox checkbox">
                                    <label class="checkbox__label checkbox__label_filter">
                                        <input class="checkbox__input" type="checkbox" value name="messenger_subscription">
                                        <span class="checkbox__text-wrapper">
                                            <span class="checkbox__point"></span>
                                            <span class="checkbox__text">Получать уведомления о заказе</span>
                                        </span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="order__row">
                            <div class="order__title"></div>
                            <div class="order__input-group" data-em-wrapper>
                                <div class="order__checkbox checkbox">
                                    <label class="checkbox__label checkbox__label_filter">
                                        <input class="checkbox__input" type="checkbox" value name="consent_to_personal_data">
                                        <span class="checkbox__text-wrapper">
                                            <span class="checkbox__point"></span>
                                            <span class="checkbox__text">
                                                <span class="checkbox__text-first">Согласие на обработку персональных данных (включить в бэк-офисе после публикации)</span>
                                                <span class="order__input-note">
                                                    Настоящим подтверждаю, что я ознакомлен и согласен с условиями
                                                    <a href="/page/oferta">оферты</a> и 
                                                    <a href="/page/oferta">политики конфиденциальности</a>
                                                </span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="order__sidebar">
                <div class="order__sidebar-title">
                    Ваш заказ
                    <span class="order__sidebar-title-count" data-cart-item-count>{{ cart.items_count }}</span>
                </div>
                <div class="order__sidebar-products-list" data-em-basket-items></div>
                <div class="order__sidebar-total" data-em-order-total>
                    <div class="order__sidebar-total-item order__sidebar-total-item_discount" data-em-sale-price hidden>
                        <span>Скидка</span>
                        <span class="dotts"></span>
                        <span data-em-value></span>
                    </div>
                    <div class="order__sidebar-total-item" data-em-items-price hidden>
                        <span>Сумма заказа</span>
                        <span class="dotts"></span>
                        <span data-em-value></span>
                    </div>
                    <div class="order__sidebar-total-item" data-em-delivery-price hidden>
                        <span>Доставка</span>
                        <span class="dotts"></span>
                        <span data-em-value></span>
                    </div>
                    <div class="order__sidebar-total-item order__sidebar-total-item_total" data-em-total-price>
                        <span>Итого</span>
                        <span class="dotts"></span>
                        <span data-em-value>Считаем рубли...</span>
                    </div>
                </div>
                <div class="order__sidebar-button-wrapper">
                    <button type="button" 
                        class="order__sidebar-button btn btn_primary btn_large" 
                        data-em-btn-submit disabled
                    >
                        Оформить заказ
                    </button>
                    <div class="order__sidebar-policy">
                        Нажимая на кнопку «Оформить заказ», я принимаю условия <a href="/page/oferta">публичной оферты</a> и <a href="/page/oferta">политики конфиденциальности</a>
                    </div>
                </div>
            </div>

            <!-- Карта ПВЗ через яндекс -->
            <div id="popup-ym-pickup-map" aria-hidden="false" class="popup">
                <div class="popup__wrapper">
                    <div class="popup__content">
                        <button data-close type="button" class="popup__close">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M2.75 2.04297L2.04297 2.75L2.39844 3.10156L7.29297 8L2.04297 13.25L2.75 13.957L8 8.70703L12.8945 13.6055L13.25 13.957L13.957 13.25L13.6055 12.8945L8.70703 8L13.957 2.75L13.25 2.04297L8 7.29297L3.10156 2.39844L2.75 2.04297Z" fill="#111111"></path>
                            </svg>
                        </button>
                        <div class="popup__body">
                            <div class="popup__title popup__title-bottom">Пункты самовывоза</div>
                            {% comment %} <div class="popup__text popup__text_sub">
                                <p>Описание</p>
                            </div> {% endcomment %}
                            <div id="em-pickup-map"></div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- Блок товара -->
<script type="text/template" data-template-id="order-item">
    <div class="order__sidebar-products-item popup-basket-item" data-em-order-id="<%= variant_id %>">
        <div class="popup-basket-item__image-wrapper">
            <img title="<%= title %>" alt="<%= title %>" data-ll-status="loaded" class="entered _lazy-loaded" src="<%= image %>">
        </div>
        <div class="popup-basket-item__body">
            <div class="popup-basket-item__name-wrapper">
                <a href="#" class="popup-basket-item__name"><%= title %></a>
                <% if(isDiscount) { %>
                    <div class="products-item__prices" data-is-discount="true">
                        <span class="products-item__price products-item__price_new"><%= priceFormat %></span>
                        <span class="products-item__price products-item__price_old"><%= priceOld %></span>
                    </div>
                <% } else { %>
                    <div class="products-item__price"
                        data-custom-price="<%= price %>" 
                        data-is-discount="false"
                    ><%= priceFormat %></div>
                <% } %>
            </div>
            <div class="popup-basket-item__size" data-em-item-quantity="<%= quantity %>"><%= quantity %> шт, размер L (подумать)</div>
        </div>
    </div>
</script>

<!-- Блок доставки -->
<script type="text/template" data-template-id="delivery-item">
    <div class="order-options__item">
        <label class="order-options__item-label">
            <input id="item-delivery_<%= elementId %>" 
                class="order-options__item-input" type="radio" 
                <%= delivery.selected ? "checked" : "" %>
                value="<%= elementId %>"
                data-original-id="<%= delivery.id %>"
                name="em-deliveries"
                <%= delivery.isError ? "disabled" : "" %>
                hidden
            >
            <span class="order-options__item-body">
                <span class="order-options__item-point"></span>
                <span class="order-options__item-info">
                    <span class="order-options__item-title-wrapper">
                        <span class="order-options__item-title"><%= delivery.title %></span>
                        <span class="order-options__item-price" data-em-<%= deliveryItemPrice %>>
                            <%= price %>
                        </span>
                    </span>
                    <%= delivery.isError ? `<span class="order__options-error">${delivery.message}</span>` : "" %>
                    <% if(delivery.customer_pickup) { %>
                        <%= pickupLabelHTML %>
                        <button type="button" data-popup="#popup-ym-pickup-map" class="order-options__item-link">
                            Выбрать на карте
                        </button>
                    <% } else if (delivery?.charge_up_to && delivery.charge_up_to > 0) { %>
                        <span class="order-options__item-note">Бесплатная доставка от <%= delivery.charge_up_to %>р</span>
                    <% } else { %>
                        <span class="order-options__item-note">Доставка бесплатная</span>
                    <% } %>
                </span>
            </span>
        </label>
    </div>
</script>

<!-- Блок оплаты -->
<script type="text/template" data-template-id="payment-item">
</script>

<!-- Блок оплаты -->
<script type="text/template" data-template-id="payment-item">
    <div class="order-options__item">
        <label class="order-options__item-label">
            <input id="order-pay_<%= key %>" class="order-options__item-input" 
                <%= payment.selected ? "checked" : "" %>
                value="<%= key %>" 
                name="em-payments" 
                type="radio"
                hidden
            >
            <span class="order-options__item-body">
                <span class="order-options__item-point"></span>
                <span class="order-options__item-info">
                    <% if(key == 6156350) { %>
                        <!-- Оплата через СБП -->
                        <span class="order-options__item-info-label">Удобно!</span>
                    <% } %>
                    <span class="order-options__item-title-wrapper">
                        <% if(key == 11901145) { %>
                            <!-- Иконка плайта -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="23" height="12" viewBox="0 0 23 12" fill="none">
                            <path d="M22.8805 11.4403H17.8656C17.8656 9.73616 17.1887 8.10185 15.9837 6.89686C14.7787 5.69187 13.1444 5.01491 11.4403 5.01491C9.73616 5.01491 8.10185 5.69187 6.89686 6.89686C5.69187 8.10185 5.01491 9.73616 5.01491 11.4403H0C0 8.40612 1.20531 5.49624 3.35078 3.35078C5.49624 1.20531 8.40612 0 11.4403 0C14.4744 0 17.3843 1.20531 19.5298 3.35078C21.6752 5.49624 22.8805 8.40612 22.8805 11.4403Z" fill="#6969FF"></path>
                            </svg>
                        <% } %>
                        <span class="order-options__item-title"><%= payment.title %></span>
                    </span>
                    <span class="order-options__note"><%= payment.description %></span>
                </span>
            </span>
        </label>
    </div>
</script>

