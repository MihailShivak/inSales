    },
    {
      "group_name":"{{ messages.content_settings }}",
      "items": [
        {
          "class": "range",
          "name": "layout-content-max-width",
          "min": 980,
          "max": 2000,
          "step": 2,
          "label": "{{ messages.content_max_width }}",
          "type": "range",
          "unit": "px"
        },
        {
          "class": "checkbox",
          "name": "layout-wide-content",
          "label": "{{ messages.wide_content }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "checkbox",
          "name": "layout-edge",
          "label": "{{ messages.edge }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    },
    {
      "group_name":"{{ messages.adaptive }}",
      "items": [
        {
          "class": "checkbox",
          "name": "hide-desktop",
          "label": "{{ messages.hide_desktop }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "checkbox",
          "name": "hide-mobile",
          "label": "{{ messages.hide_mobile }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    }
