                                        <path d="M42.9393 3.48489C42.8189 6.33912 42.2167 8.1815 41.0377 8.1815H40.7427V10.1738L41.057 10.1907C43.421 10.3225 44.7276 8.24799 44.942 3.717H48.0515V10.1242H50.0156V1.82506H43.0055L42.9393 3.48489Z" fill="black"/>
                                        <path d="M35.5318 1.70911C32.8704 1.70911 30.9556 3.55148 30.9556 5.97413C30.9556 8.4802 33.039 10.2573 35.5318 10.2573C38.1283 10.2573 40.1454 8.38107 40.1454 5.97413C40.1454 3.5672 38.1283 1.70911 35.5318 1.70911ZM35.5318 8.26502C34.0277 8.26502 33.0028 7.2858 33.0028 5.97413C33.0028 4.62983 34.0289 3.67721 35.5318 3.67721C37.0348 3.67721 38.0945 4.67335 38.0945 5.97413C38.0945 7.27492 37.0203 8.26502 35.5318 8.26502Z" fill="black"/>
                                        <path d="M28.8686 1.84071H21.9235L21.8573 3.50054C21.7585 5.89177 21.1347 8.16572 19.9557 8.19836L19.4102 8.21529V12L21.3948 11.996V10.1254H28.2893V11.996H30.2908V8.19836H28.8686V1.84071ZM26.9008 8.19836H22.7015C23.412 7.12002 23.7925 5.55932 23.8588 3.73386H26.9008V8.19836Z" fill="black"/>
                                        </svg>
                                        <div class="payment__desc">4 платежа по {{ payment_share | money }}</div>
                                        <div class="payments__btn-icon"></div>
                                    </button>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    <div class="product-card-info__group product-card__descr">
                        <div data-spollers class="product-card-info__descr product-card-descr">
                            {% if product.description %}
                                <div class="product-card-descr__item">
                                    <button type="button" data-spoller class="product-card-descr__title">
                                        <span class="product-card-descr__title-icon"></span>
                                        <span>Описание</span>
                                    </button>
                                    <div class="product-card-descr__body">
                                        <div class="product-card-descr__text-wrapper">
                                            {{ product.description }}
                                            <button class="btn btn_payment _active" data-popup="sizes">Таблица размеров</button>
                                            <p class="product-card-descr__italic">Замеры изделий могут отличаться на 1-2 см</p>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if product.fields.obmery_izdeliya.value != '' %}
                                <div class="product-card-descr__item">
                                    <button type="button" data-spoller class="product-card-descr__title">
                                        <span class="product-card-descr__title-icon"></span>
                                        <span>Обмеры изделия</span>
                                    </button>
                                    <div class="product-card-descr__body">
                                        <div class="product-card-descr__text-wrapper">
                                            {{ product.fields.obmery_izdeliya.value }}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if product.properties.size > 0 %}
                                <div class="product-card-descr__item">
                                    <button type="button" data-spoller class="product-card-descr__title">
                                        <span class="product-card-descr__title-icon"></span>
                                        <span>Характеристики</span>
                                    </button>
                                    <div class="product-card-descr__body">
                                        <div class="product-card-descr__text-wrapper">
                                            {% for property in product.properties %}
                                                {% if property.handle == "badge"  %}
                                                    {% continue %}
                                                {% endif %}
                                                {{property.name | capitalize}}:<br> {% for item in property.characteristics %}{{item.name}}<br>{% endfor %}<br>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% for field in product.fields %}
                                {% if field.value != '' %}
                                    <div class="product-card-descr__item">
                                        <button type="button" data-spoller class="product-card-descr__title">
                                            <span class="product-card-descr__title-icon"></span>
                                            <span>{{ field.title }}</span>
                                        </button>
                                        <div class="product-card-descr__body">
                                            <div class="product-card-descr__text-wrapper">
                                                {{ field.value }}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                            <div class="product-card-descr__item">
                                <button type="button" data-spoller class="product-card-descr__title">
                                    <span class="product-card-descr__title-icon"></span>
                                    <span>Доставка в г Москва</span>
                                </button>
                                <div class="product-card-descr__body">
                                    <button type="button" data-popup="#popup-city" class="product-card-descr__popup-btn">изменить город</button>
                                    <div data-spollers class="product-card-descr__delivery product-delivery" data-delivery-options></div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="product-card-info__reviews" hidden>Отзывы <span>(3)</span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

