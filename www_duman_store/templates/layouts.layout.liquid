  <body data-multi-lang="{{ language.not_default? }}" data-theme-template="{{ template }}" data-sidebar-type="{{ sidebar_type }}" data-sidebar-position="{{ sidebar_position }}">
    {% include "popups" %}
    <div class="preloader">
      <div class="preloader__loading">
        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24"><style>.spinner_b2T7{animation:spinner_xe7Q .8s linear infinite}.spinner_YRVV{animation-delay:-.65s}.spinner_c9oY{animation-delay:-.5s}@keyframes spinner_xe7Q{93.75%,100%{r:3px}46.875%{r:.2px}}</style><circle class="spinner_b2T7" cx="4" cy="12" r="3"/><circle class="spinner_b2T7 spinner_YRVV" cx="12" cy="12" r="3"/><circle class="spinner_b2T7 spinner_c9oY" cx="20" cy="12" r="3"/></svg>
        <p class="preloader__text">Ожидание загрузки страницы ...</p>
      </div>
      <div class="preloader__slow">
        <p class="preloader__slow-text">Похоже, соединение с интернетом нестабильно</p>
        <a class="preloader__reload" href="javascript:location.reload()">Обновить страницу</a>
      </div>
    </div>
    {% include "system_no_js_alert" %}
    <div class="page_layout {% if sidebar_show %}page_layout_{{ sidebar_type }}_{{ sidebar_position }}{% else %}page_layout-clear{% endif %} {{- settings.fixed_sidebar_border -}} {% if template contains 'collection' %}page_layout_section_top{% endif %}">
      <header>
      {% for widgetDrop in widget_lists.header-list.widgets %}
        {% widget widgetDrop %}
      {% endfor %}
      </header>

      {% if template contains 'collection' %}
      <section class="page_section_top">
        {% for widgetDrop in widget_lists.collection-section_top-list.widgets %}
          {% widget widgetDrop %}
        {% endfor %}
      </section>
      {% endif %}

      <main>
        {{ content_for_layout }}
      </main>

      {% if sidebar_show or editor_mode? %}
      <aside>
        <section data-sidebar>
          {% if template contains 'blog' or template contains 'article' %}
            {% for widgetDrop in widget_lists.sidebar_blog-list.widgets %}
              {% widget widgetDrop %}
            {% endfor %}
          {% else %}
            {% for widgetDrop in widget_lists.sidebar-list.widgets %}
              {% widget widgetDrop %}
            {% endfor %}
          {% endif %}
        </section>
      </aside>
      {% endif %}

      <footer>
        {% for widgetDrop in widget_lists.footer-list.widgets %}
          {% widget widgetDrop %}
        {% endfor %}
      </footer>
    </div>
    
    <div data-fixed-panels="bottom">
      {% for widgetDrop in widget_lists.bottom-panel-list.widgets %}
        {% widget widgetDrop %}
      {% endfor %}
    </div>

    <div class="outside-widgets">
      {% for widgetDrop in widget_lists.outside-list.widgets %}
        {% widget widgetDrop %}
      {% endfor %}
    </div>
    <script>console.log("render layouts: {{ 'now' | date: '%s.%L' | minus: layouts_time }}");</script>
    {% include "template-product" %}
    <a href="https://max.ru/u/f9LHodD0cOI-rRBMBTnZ_yCHvDWsNpaTWlxqL5rrEUEVHqB_IU0mg7BqicI
" target="_blank" rel="noopener" class="my-amo-extra-btn" id="myAmoExtraBtn" aria-label="Макс">
      <span class="my-amo-extra-btn-tooltip">Макс</span>
