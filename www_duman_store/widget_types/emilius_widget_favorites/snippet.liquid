<section class="catalog" id="wishlist-catalog" data-link-not-image="{{ 'no_image.svg' | asset_url }}">
    <div class="catalog__container">
        <div class="catalog__grid catalog__grid_alt" id="filters" data-js="catalog-wrapper">
            <div class="catalog__top" data-em-menu-top>
                {% comment %} <a href="/collection/all" class="catalog__back"></a> {% endcomment %}
                <div class="catalog__title-wrapper" data-em-menu-top>
                    <div class="catalog__title">
                        <h1>Вишлист</h1>
                        <span class="catalog__title-count" data-em-favorites-counter></span>
                    </div>
                    {% comment %} ! Кнопка в мобилке поделиться вишлистом
                    <div class="basket__actions-mob">
                        <button type="button" class="basket__actions-mob-item basket__actions-mob-item_share" data-share-favorites></button>
                    </div> {% endcomment %}
                </div>
                <button data-mob-popup-open="filters" type="button" class="catalog__filters-button">
                    <span class="icon-counter" hidden>0</span>
                </button>
                {% comment %} <button type="button" class="catalog__share-button btn btn_small btn_secondary btn_share" data-share-favorites>
                    <span>Поделиться</span>
                </button> {% endcomment %}
                {% comment %} ! Пока отключил, потом нужно доделать {% endcomment %}
                <div class="basket__actions" hidden>
                    <div class="basket__actions-share">
                        <button type="button" class="basket__actions-share-btn" data-share-favorites>Поделиться</button>
                        <button type="button" class="basket__actions-share-text" style="display:none;">
                            <svg width="18" height="17" viewBox="0 0 18 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.00008 0.166016C4.40508 0.166016 0.666748 3.90435 0.666748 8.49935C0.666748 13.0943 4.40508 16.8327 9.00008 16.8327C13.5951 16.8327 17.3334 13.0943 17.3334 8.49935C17.3334 3.90435 13.5951 0.166016 9.00008 0.166016ZM12.5672 7.06643L8.4005 11.2331C8.27841 11.3552 8.11841 11.416 7.95841 11.416C7.79841 11.416 7.63841 11.3552 7.51633 11.2331L5.433 9.14977C5.18883 8.9056 5.18883 8.51018 5.433 8.26602C5.67716 8.02185 6.07258 8.02185 6.31675 8.26602L7.958 9.90727L11.6826 6.18268C11.9267 5.93852 12.3222 5.93852 12.5663 6.18268C12.8105 6.42685 12.8109 6.82227 12.5672 7.06643Z" fill="#975730"/>
                            </svg>
                            <span>Ссылка на вишлист скопирована!</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="catalog__body">
                <div class="catalog__top-panel" data-filter-panel>
                    <form action="/" method="get" class="catalog__filters-wrapper">
                        {% comment %} Переключатель сетки, пока убираем
                        <div class="catalog__filters-switcher switcher" hidden>
                            <button type="button" class="switcher__button" data-js="catalog-button"></button>
                            <span class="switcher__label">Каталог</span>
                        </div> {% endcomment %}
                        <select name="panel[order]" data-show-selected data-fade-select data-class-modif="catalog-sort" class="catalog__sort">
                            <option data-class="_active" value="1" selected>По умолчанию</option>
                            <option value="2">Сначала дешевле</option>
                            <option value="3">Сначала дороже</option>
                        </select>
                        <div class="catalog__filters-group filters" data-spollers data-one-spoller></div>
                    </form>
                    <div class="catalog__selected-filters selected-filters" hidden>
                        <div class="selected-filters__list"></div>
                        <button type="button" class="selected-filters__clear" data-clear-filtres>Очистить всё</button>
                    </div>
                </div>
                <div class="catalog__error" hidden>Товары не найдены</div>
                <div class="catalog__list catalog__list_wishlist" data-js="catalog-list"></div>

                <div class="catalog__loader" hidden>
                    <div class="catalog__loader-body">
                        <div class="catalog__loader-anim">
                            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="34" viewBox="0 0 24 24"><circle class="spinner_b2T7" cx="4" cy="12" r="3"></circle><circle class="spinner_b2T7 spinner_YRVV" cx="12" cy="12" r="3"></circle><circle class="spinner_b2T7 spinner_c9oY" cx="20" cy="12" r="3"></circle></svg>
                        </div>
                        <span>Загружаем ещё</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="catalog__container catalog__container_alt" hidden>
            <div class="catalog__empty-wrapper">
                <div class="catalog__empty">
                    <div class="catalog__empty-text-wrapper">
                        <div class="catalog__empty-title">Вишлист пока пуст</div>
                        <div class="catalog__empty-text">В каталоге можно найти много классных товаров</div>
                    </div>
                    <a href="/collection/all" class="catalog__empty-btn btn btn_primary btn_small">К каталогу</a>
                </div>
            </div>
        </div>
    </div>
</section>

{% comment %} Мобильные фильтры {% endcomment %}
<div id="filters-mob" data-mob-popup="filters" class="mob-popup mob-popup_filters" style="transform:translateX(-100%);">
    <div class="mob-popup__top">
        <button data-mob-popup-close type="button" class="mob-popup__back"></button>
        <div class="mob-popup__title">Фильтры</div>
        <div class="mob-popup__actions">
            {% comment %} <button data-mob-popup-close type="button" class="mob-popup__actions-item mob-popup__actions-item_close-disabled"></button> {% endcomment %}
            <button data-mob-btn-clear="filters" type="button" class="mob-popup__actions-item-clear" hidden>Сбросить</button>
        </div>
    </div>
    <div class="mob-popup__body">
        <div class="mob-popup__group" data-filter-id="sort">
            <div class="mob-popup__group-title-wrapper">
                <div class="mob-popup__group-title">Сортировка</div>
            </div>
            <div class="mob-popup__options options-sort">
                <div class="options-sort__item">
                    <label class="options-sort__label">
                        <input hidden class="options-sort__input" checked type="radio" value="1" name="filters-sort">
                        <span class="options-sort__text">По актуальности</span>
                    </label>
                </div>
                <div class="options-sort__item">
                    <label class="options-sort__label">
                        <input hidden class="options-sort__input" type="radio" value="2" name="filters-sort">
                        <span class="options-sort__text">Сначала дешевле</span>
                    </label>
                </div>
                <div class="options-sort__item">
                    <label class="options-sort__label">
                        <input hidden class="options-sort__input" type="radio" value="3" name="filters-sort">
                        <span class="options-sort__text">Сначала дороже</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="mob-popup__bottom">
        <button type="button" class="mob-popup__button btn btn_medium btn_primary" data-mob-apply>
            <span>Показать все товары</span>
        </button>
    </div>
</div>

<div data-mob-popup="filter-colors" class="mob-popup mob-popup_filters" style="transform:translateX(-100%);">
    <div class="mob-popup__top">
        <button data-mob-popup-back type="button" class="mob-popup__back"></button>
        <div class="mob-popup__title">Цвет</div>
        <div class="mob-popup__actions">
            <button data-mob-btn-clear="filter-colors" type="button" class="mob-popup__actions-item-clear" hidden>Сбросить</button>
        </div>
    </div>
    <div class="mob-popup__body">
        <div class="mob-popup__row">
            <div class="mob-popup__filter-list"></div>
        </div>
    </div>
    <div class="mob-popup__bottom">
        <button type="button" class="mob-popup__button btn btn_medium btn_primary" data-mob-popup-back>
            <span>Готово</span>
        </button>
    </div>
</div>

<div class="service-message service-message_mob service-message_basket-share" style="display:none;">
    <span class="service-message__text">Ссылка на вишлист скопирована!</span>
</div>

<script type="text/template" data-template-id="favorite-product">
    <div class="catalog__list-item products-item" <% if (available){ %>data-js="product-item"<% } %> data-cust-product-id="<%= product_id %>">
        <div class="products-item__img-wrapper">
            <a href="<%= url %>" class="products-item__img">
                <img src="<%= image.replace('static.insales-shop.ru', 'ibicecdn.com/dumanstore') %>" alt="<%= title %>" class="entered _lazy-loaded">
            </a>
            <div class="products-item__actions">
                <button type="button" class="products-item__action products-item__action-whishlist" data-em-favorites-trigger="<%= product_id %>"></button>
                <% if (available) { %>
                    <button type="button" 
                    class="products-item__action products-item__action-addcart<% if (values.length == 1 && Cart.order.getItemByID(values[0]?.id) !== undefined) { %> _active<% } %>" 
                        <% if (values.length > 1) { %>
                            data-js="product-item-addcard"
                            data-add-cart="<%= product_id %>"
                        <% } else { %>
                            data-btn-cart-add="<%= values[0]?.id %>"
                        <% } %>
                    ></button>
                <% } %>
            </div>
            <!--noindex-->
            <div class="products-item__sizes-wrapper" data-js="product-sizes-wrapper">
                <button type="button" class="products-item__sizes-close" data-js="product-sizes-close"></button>
                <div class="products-item__sizes-content">
                    <div class="products-item__sizes-title">Выберите размер</div>
                    <div class="products-item__sizes-list checkbox-list">
                        <% 
                        var note = "", count = 0;
                        values.forEach(function (value) {
                            if (!value.available || value.quantity == 0) return;
                            if (value.quantity == 1) {
                                note = [note, value.title].join(', ').trim();
                                count++;
                            } %>
                            <div class="checkbox-list__item checkbox-btn">
                                <label class="checkbox-btn__label">
                                    <input class="checkbox-btn__input" type="radio" value="<%= value.id %>" data-size-select name="<%= product_id %>">
                                    <div class="checkbox-btn__text-wrapper">
                                        <span class="checkbox-btn__text"><%= value.option_values[0]?.title ?? value.title %></span>
                                    </div>
                                </label>
                            </div>
                        <% }); %>
                    </div>
                    <% if (count == 1) { %>
                        <div class="products-item__sizes-text"><%= note.substr(2) %> — последний размер</div>
                    <% } else if (count > 1) { %>
                        <div class="products-item__sizes-text"><%= note.substr(2) %> — последние размеры</div>
                    <% } %>
                    <% if (urlNotAvailable) { %>
                        <div class="products-item__sizes-text">Товар закончился</div>
                        <a href="<%= urlNotAvailable %>" class="products-item__button btn btn_outline btn_small">Смотреть похожие</a>  
                    <% } %>
                    {% comment %}
                    <div class="products-item__sizes-bottom sizes__bottom-mob" hidden>
                        <button data-popup="#" type="button" class="products-item__sizes-table">
                            <span>Таблица размеров</span>
                        </button>
                    </div>
                    {% endcomment %}
                    <div class="product-item__sizes__buttons">
                        <button type="button" class="btn-icon btn-icon_medium btn-icon_secondary btn-icon_remove" data-size-remove hidden></button>
                        <button type="button" class="btn btn_medium btn_primary btn-item_added" data-size-cart-add disabled>
                            <span>Размер не выбран</span>
                        </button>
                    </div>
                </div>
                <% if (false) { %>
                    <div class="products-item__sizes-bottom sizes__bottom-pc" hidden>
                        <button data-popup="#" type="button" class="products-item__sizes-table">
                            <span>Таблица размеров</span>
                        </button>
                    </div>
                <% } %>
            </div>
            <!--/noindex-->
            <div class="products-item__sizes-filling" ></div>
        </div>
        <div class="products-item__info">
            <a href="<%= url %>" class="products-item__title"><%= title %></a>
            <div class="products-item__properties">
                <div class="products-item__prices">
                    <span class="products-item__price"><%= price %></span>
                </div>
            </div>
            <% if (urlNotAvailable) { %>
                <div class="products-item__product-ended">Товар закончился</div>
                <a href="<%= urlNotAvailable %>" class="products-item__button btn btn_outline btn_small">
                    <span>Смотреть похожие</span>
                    <span>Похожие</span>
                </a>
            <% } else { %>
                <!--noindex-->
                <div class="products-item__badges" hidden>
                    <span class="products-item__badge">Новинка</span>
                    <span class="products-item__badge">Предзаказ</span>
                </div>
                <!--/noindex-->
            <% } %>
        </div>
    </div>
</script>

{% include "template-filter" %}