{% if blogs.blog.articles.size > 0 %}
  <div class="page__wrapper page__from">
    <h2 class="page__title">Статьи от Екатерины</h2>
    <div class="page__from-grid">
      {% for article in blogs.blog.articles %}
        <div class="page__from-item">
          <div class="from-item__img-wrapper">
            <a href="{{ article.url }}">
              <picture>
                <source
                  media="(max-width:650px)"
                  srcset="{{ article.image | image_url: 750, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}"
                  type="image/webp"
                  data-ll-status="loaded"
                  class="entered"
                >
                <source
                  srcset="{{ article.image | image_url: 1100, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}"
                  type="image/webp"
                  data-ll-status="loaded"
                  class="entered"
                >

                <source
                  media="(max-width:650px)"
                  srcset="{{ article.image | image_url: 750 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}"
                  data-ll-status="loaded"
                  class="entered"
                >

                <img
                  src="{{ article.image | image_url: 1100 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}"
                  alt="{{ article.title }}"
                  title="{{ article.title }}"
                  data-ll-status="loaded"
                  class="entered"
                >
              </picture>
            </a>
            {% unless article.tags == empty %}
              <div class="from-item__tags">
                {% for tag in article.tags %}
                  <a href="{{ tag.url }}">{{ tag.title }}</a>
                {% endfor %}
              </div>
            {% endunless %}
          </div>
          <div class="from-item__info">
            <a href="{{ article.url }}" class="from-item__info-title">{{ article.title }}</a>
            <div class="from-item__info-subtitle" data-em-date="{{ article.created_at | date: "%d.%m.%Y" }}">
              {{ article.created_at | data: '%d %b %Y' }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <a href="{{ blogs.blog.url }}" class="page__from-btn btn btn_secondary">Загрузить ещё</a>
  </div>
{% endif %}

{% assign collection = blockPage.collection %}
{% if collection and collection.products_count > 0 %}
  <div class="page__wrapper page__choice" data-js-slider="products-slider-wrapper">
    <div class="page__choice-head">
      <h2 class="page__title">Выбор Екатерины</h2>
      <div class="products-slider__arrows">
        <button type="button" class="products-slider__arrow products-slider__arrow-prev swiper-button-prev"></button>
        <button type="button" class="products-slider__arrow products-slider__arrow-next swiper-button-next"></button>
      </div>
    </div>
    <div class="products-slider__list swiper">
      <div class="products-slider__list-wrapper swiper-wrapper">
        {% for product in collection.products limit: 10 %}
          {% if product.properties.predzakaz.characteristics.first.name == 'Да' %}
            {% assign isPreorder = true %}

            {% if product.properties['skoro-v-prodazhe'].characteristics.first.name == 'Да' %}
              {% assign isSoon = true %}
            {% else %}
              {% assign isSoon = false %}
            {% endif %}
          {% else %}
            {% assign isPreorder = false %}
            {% assign isSoon = false %}
          {% endif %}

          <form
            class="products-slider__slide products-item swiper-slide"
            {% if product.available or isPreorder and isSoon == false %}
              data-js="product-item"
            {% endif %}
            method="post"
            data-cust-product-id="{{ product.id }}"
          >
            <div class="products-item__img-wrapper">
              <a href="{{ product.url }}" class="products-item__img" target="_blank">
                {% if product.images.size > 0 %}
                  <picture>
                    <source
                      media="(max-width:700px)"
                      type="image/webp"
                      srcset="
                        {{ product.first_image | image_url: 700,  format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }},
                        {{ product.first_image | image_url: 1200, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }} 2x
                      "
                    >
                    <source
                      type="image/webp"
                      srcset="
                        {{ product.first_image | image_url: 980,  format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }},
                        {{ product.first_image | image_url: 1600, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }} 2x
                      "
                    >
                    {% comment %}
                      <source type="image/webp"
                      srcset="{{ product.first_image | image_url: 1400, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }},
                              {{ product.first_image | image_url: 1800, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }} 2x">
                    {% endcomment %}

                    <img
                      src="{{ product.first_image | image_url: 980 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }}"
                      srcset="
                        {{ product.first_image | image_url: 980 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }},
                        {{ product.first_image | image_url: 1600 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }} 2x
                      "
                      alt="{{ product.title }}"
                      class="entered _lazy-loaded"
                      loading="lazy"
                    >
                  </picture>
                {% else %}
                  <img
                    src="{{ 'no_image.svg' | asset_url }}"
                    data-src="{{ 'no_image.svg' | asset_url }}"
                    alt="{{ product.title }}"
                    class="image-none entered _lazy-loaded"
                    loading="lazy"
                  >
                {% endif %}
              </a>
              <div class="products-item__actions">
                <button
                  type="button"
                  class="products-item__action products-item__action-whishlist"
                  data-em-favorites-trigger="{{ product.id }}"
                >
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.2077 15.9163C11.0789 15.9163 10.951 15.8768 10.8427 15.7984L5.99935 12.3113L1.15602 15.7984C0.965182 15.9355 0.714349 15.9547 0.505599 15.8476C0.297265 15.7409 0.166016 15.5259 0.166016 15.2913V2.79134C0.166016 1.29801 1.38102 0.0830078 2.87435 0.0830078H9.12435C10.6177 0.0830078 11.8327 1.29801 11.8327 2.79134V15.2913C11.8327 15.5259 11.7014 15.7409 11.4927 15.8476C11.4027 15.8934 11.3052 15.9163 11.2077 15.9163Z"/>
                  </svg>
                </button>
                {% if product.available or isPreorder and isSoon == false %}
                  <button
                    type="button"
                    class="products-item__action products-item__action-addcart"
                    {%- if product.variants.size > 1 -%}
                      data-em-js="product-item-addcard"
                      data-add-cart="{{ product.id }}"
                    {%- else -%}
                      data-btn-cart-add="{{ product.variants.first.id }}"
                    {%- endif -%}
                  ></button>
                {% else %}
                  <button
                    type="button"
                    class="products-item__action products-item__action-subscribe"
                    data-popup="#popup-subscribe"
                  ></button>
                {% endif %}
              </div>
              {% assign firstVariant = null %}
              {% if product.available or isPreorder and isSoon == false %}
                {% assign latestSizes = '' %}
                {% assign countLatestSizes = 0 %}
                <!-- noindex -->
                <div class="products-item__sizes-wrapper" data-em-js="product-sizes-wrapper">
                  <button type="button" class="products-item__sizes-close" data-js="product-sizes-close"></button>
                  <div class="products-item__sizes-content">
                    <div class="products-item__sizes-title">Выберите размер</div>
                    <div class="products-item__sizes-list checkbox-list">
                      {% for variant in product.variants %}
                        {% if variant.available == false or variant.quantity == 0 %}
                          {% if isPreorder == false or isSoon %}
                            <button
                              type="button"
                              class="checkbox-list__item checkbox-btn"
                              data-popup="#popup-subscribe"
                            >
                              <div class="checkbox-btn__label checkbox__item-not-available">
                                <div class="checkbox-btn__text-wrapper">
                                  <span class="checkbox-btn__text">
                                    {{- variant.option_values[0].title | default: variant.title -}}
                                  </span>
                                </div>
                              </div>
                            </button>
                            {% continue %}
                          {% endif %}
                        {% elsif variant.quantity == 1 %}
                          {% assign latestSizes = latestSizes | append: ' ' | append: variant.title %}
                          {% assign countLatestSizes = countLatestSizes | plus: 1 %}
                        {% endif %}
                        {% unless firstVariant %}
                          {% assign firstVariant = variant %}
                        {% endunless %}
                        <div class="checkbox-list__item checkbox-btn">
                          <label class="checkbox-btn__label">
                            <input
                              class="checkbox-btn__input"
                              type="radio"
                              name="{{ product.id }}"
                              value="{{ variant.id }}"
                              data-size-select
                            >
                            <div class="checkbox-btn__text-wrapper">
                              <span class="checkbox-btn__text">
                                {{- variant.option_values[0].title | default: variant.title -}}
                              </span>
                            </div>
                          </label>
                        </div>
                      {% endfor %}
                    </div>
                    {% if countLatestSizes == 1 %}
                      <div class="products-item__sizes-text">{{ latestSizes }} — последний размер</div>
                    {% elsif countLatestSizes > 1 %}
                      <div class="products-item__sizes-text">{{ latestSizes }} — последние размеры</div>
                    {% endif %}
                    {% comment %}
                      <div class="products-item__sizes-bottom sizes__bottom-mob">
                          <button data-popup="#" type="button" class="products-item__sizes-table">
                              <span>Таблица размеров</span>
                          </button>
                      </div>
                    {% endcomment %}
                    <div class="product-item__sizes__buttons">
                      <button
                        type="button"
                        class="btn-icon btn-icon_medium btn-icon_secondary btn-icon_remove"
                        data-size-remove
                        hidden
                      ></button>
                      <button
                        type="button"
                        class="btn btn_medium btn_primary btn-item_added"
                        data-size-cart-add
                        disabled
                      >
                        <span>Размер не выбран</span>
                      </button>
                    </div>
                  </div>
                  {% comment %}
                    <div class="products-item__sizes-bottom sizes__bottom-pc">
                        <button data-popup="#" type="button" class="products-item__sizes-table">
                            <span>Таблица размеров</span>
                        </button>
                    </div>
                  {% endcomment %}
                </div>
                <!-- /noindex -->
              {% endif %}
              <div class="products-item__sizes-filling" data-js="product-sizes-close"></div>
            </div>
            <div class="products-item__info">
              <a href="{{ product.url }}" class="products-item__title">{{ product.title | escape }}</a>
              <div class="products-item__properties">
                <div class="products-item__prices">
                  {% if product.available == false and isSoon %}
                    <div class="products-item__button btn btn_outline btn_small">Скоро в продаже</div>
                  {% elsif product.old_price and product.price < product.old_price %}
                    <span class="products-item__price products-item__price_new">{{ product.price | money }}</span>
                    <span class="products-item__price products-item__price_old">{{ product.old_price | money }}</span>
                  {% else %}
                    <span class="products-item__price">{{ product.price | money }}</span>
                  {% endif %}
                </div>
                <div
                  class="products-item__colors colors-list"
                  {%- if firstVariant -%}
                    data-first-variant="{{ firstVariant.id }}"
                    data-variant-sku="{{ firstVariant.sku }}"
                  {%- else -%}
                    data-first-variant="{{ product.variants.first.id }}"
                    data-variant-sku="{{ product.variants.first.sku }}"
                  {%- endif -%}
                ></div>
              </div>
              {% if product.available %}
                <!-- noindex -->
                <div
                  class="products-item__badges"
                  {%- if product.properties.badge -%}
                    data-badges-id="{%- for item in product.properties.badge.characteristics -%}{{- item.name -}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}"
                  {%- endif -%}
                >
                  {% for collection in product.collections %}
                    {% if collection.handle == 'sale' and product.price < product.old_price %}
                      <span class="badge-sale">
                        <span>SUPER SALE</span>
                        <span>
                          {{-
                            product.old_price
                            | minus: product.price
                            | divided_by: product.old_price
                            | times: 100
                            | round: 0
                          -}}
                          %</span
                        >
                      </span>
                    {% elsif collection.handle == 'novinki' %}
                      <span class="products-item__badge">Новинка</span>
                    {% endif %}
                  {% endfor %}
                  {% if product.properties.badge %}
                    <span class="products-item__badge _disabled-badge">Загрузка</span>
                  {% endif %}
                </div>
                <!-- /noindex -->

              {% elsif isPreorder and isSoon == false %}
                <!-- noindex -->
                <div class="products-item__badges">
                  <span class="products-item__badge">Предзаказ</span>
                </div>
                <!-- /noindex -->

              {% elsif isSoon == false %}
                <div class="products-item__product-ended">Товар закончился</div>
                <a
                  href="{{ product.canonical_collection.url }}"
                  class="products-item__button btn btn_outline btn_small"
                >
                  <span>Смотреть похожие</span>
                  <span>Похожие</span>
                </a>
              {% endif %}

              {% comment %}
                <div class="products-item__badges" hidden>
                    <span class="products-item__badge">Новинка</span>
                </div>
              {% endcomment %}
            </div>
          </form>
        {% endfor %}
        {% if widget_settings.category and products.size > 10 %}
          <div class="products-slider__slide products-item swiper-slide" data-js="product-item">
            <div class="products-item__img-wrapper">
              <a href="{{ widget_settings.category }}" class="products-item__img products-item__more" target="_blank">
                <div class="products-item__more-text">Смотреть все</div>
              </a>
            </div>
            <div class="products-item__info"></div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% comment %} ! Прикрутить swiper.js {% endcomment %}
{% if account.reviews_not_spam.size > 0 %}
