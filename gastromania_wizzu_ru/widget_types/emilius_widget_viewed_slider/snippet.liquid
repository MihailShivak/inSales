<div class="viewed" data-products-limit="{{ widget_settings.range }}" hidden>
    <div class="viewed__head">
        <div class="title__large">{{ widget_settings.title }}</div>
        <div class="viewed__arrows">
            <button type="button" class="slider__controls-arrow swiper-btn-prev">
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25" fill="none">
                <path d="M16.2598 22.2603L7.25977 12.7603L16.2598 3.26025" stroke="#181818" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <button type="button" class="slider__controls-arrow swiper-btn-next">
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25" fill="none">
                <path d="M8.74023 22.2603L17.7402 12.7603L8.74023 3.26025" stroke="#181818" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>
    </div>
    <div class="swiper">
        <div class="swiper-wrapper"></div>
    </div>
</div>