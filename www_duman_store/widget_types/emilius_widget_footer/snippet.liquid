                        </div>
                    </div>
                    <a class="footer_sitemap" href="/page/sitemap">Карта сайта</a>
                </div>
                <div class="footer__col">
                    <div class="footer__menu">
                        {% assign customer_menu = linklists[widget_settings['customer-menu-1']] %}
                        <div class="footer__menu-label">{{ customer_menu.title }}</div>
                        <div class="footer__menu-list">
                            {% for link in customer_menu.links %}
                                <div class="footer__menu-item"><a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a></div>
							{% endfor %}
                        </div>
                    </div>
                </div>
                <div class="footer__col">
                    <div class="footer__menu">
                        {% assign customer_menu = linklists[widget_settings['customer-menu-2']] %}
                        <div class="footer__menu-label">Покупателям</div>
                        <div class="footer__menu-list">
                            {% for link in customer_menu.links %}
                                <div class="footer__menu-item"><a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a></div>
							{% endfor %}
                        </div>
                    </div>
                </div>
                <div class="footer__col">
                    <div class="footer__form-wrapper">
                        <div class="footer__form-head">
                            <div class="footer__form-title">{{ widget_settings.form-title }}</div>
                            <div class="footer__form-descr">{{ widget_settings.form-description }}</div>
                        </div>
                        <form method="POST" action="https://cp.unisender.com/ru/subscribe?hash={{ widget_settings.form_hash}}" name="subscribtion_form" class="footer__form" target="_blank">
                            <input type="hidden" name="charset" value="UTF-8">
                            <input type="hidden" name="default_list_id" value="{{ widget_settings.form_id }}">
                            <input type="hidden" name="overwrite" value="2">
                            <input type="hidden" name="is_v5" value="1">
                            <input data-reqiured="Email" autocomplete="off" type="email" name="email" data-error="Ошибка" placeholder="Email" class="footer__form-input input-promocode">
                            <button type="submit" {% unless widget_settings.form_id or widget_settings.form_hash %}disabled{% endunless %} class="footer__form-button btn btn_medium btn_primary">Подписаться</button>
                            <label class="footer__form-policy-agree">
                                <input type="checkbox" required>
                                Согласен с обработкой персональных данных
                            </label>
                        </form>
                        <div class="footer__note">
                            Подписываясь на рассылку, вы соглашаетесь с <a href="/page/oferta">обработкой персональных данных</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer__bottom">
                <div class="footer__bottom-col">
                    <span>© {{ 'now' | date: "%Y" }} Duman</span>
                </div>
                <div class="footer__bottom-col">
                    <a href="{{ widget_settings.bottom-section-link }}">{{ widget_settings.bottom-section-title }}</a>
                    {% if widget_settings.bottom-section-link-2 %}
                        <a href="{{ widget_settings.bottom-section-link-2 }}">{{ widget_settings.bottom-section-title-2 }}</a>
                    {% endif %}
                </div>
            </div>
            <div class="footer__bottom">
                <div class="footer__bottom-col">
                    <a href="https://rogalev.online/">Разобрано и собрано вместе<br>с Дмитрием Рогалёвым</a>
                </div>
            </div>
        </div>
    </div>
</footer>
{% endif %}

<script>console.log("render footer: {{ 'now' | date: '%s.%L' | minus: footer_time }}");</script>