<div id="popup-subscribe" aria-hidden="true" class="popup">
  <div class="popup__wrapper">
    <div class="popup__content">
      <button data-close type="button" class="popup__close"></button>
      <div class="popup__body{% unless client %} _disabled-form{% endunless %}" data-subscribe-client="{%- if client -%}true{%- endif -%}">
        <div class="popup__title-wrapper">
          <div class="popup__title">Узнать о поступлении</div>
          <div class="popup__subtitle">Мы уведомим вас, когда <span></span> появится в наличии</div>
          <div class="popup__error"{% if client %} hidden{% endif %}>
            <button data-popup="#popup-login" type="button">Авторизуйтесь</button> для отравки формы
          </div>
          <div class="popup__error popup__error-not" hidden>
            Вы не выбрали товар
          </div>
          <div class="account__contacts-message account-success" data-em-message hidden>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9.55021 15.15L18.0252 6.675C18.2252 6.475 18.4585 6.375 18.7252 6.375C18.9919 6.375 19.2252 6.475 19.4252 6.675C19.6252 6.875 19.7252 7.1125 19.7252 7.3875C19.7252 7.6625 19.6252 7.9 19.4252 8.1L10.2502 17.3C10.0502 17.5 9.81687 17.6 9.55021 17.6C9.28354 17.6 9.05021 17.5 8.85021 17.3L4.55021 13C4.35021 12.8 4.25437 12.5625 4.26271 12.2875C4.27104 12.0125 4.37521 11.775 4.57521 11.575C4.77521 11.375 5.01271 11.275 5.28771 11.275C5.56271 11.275 5.80021 11.375 6.00021 11.575L9.55021 15.15Z" fill="#789D4A"></path>
              </svg>
              <span class="account__success-info">данные сохранены</span>
              <button type="button" class="btn-close-grey" data-em-message-close>
                  <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2.75 2.04297L2.04297 2.75L2.39844 3.10156L7.29297 8L2.04297 13.25L2.75 13.957L8 8.70703L12.8945 13.6055L13.25 13.957L13.957 13.25L13.6055 12.8945L8.70703 8L13.957 2.75L13.25 2.04297L8 7.29297L3.10156 2.39844L2.75 2.04297Z" fill="#111111"></path>
                  </svg>
              </button>
          </div>
        </div>
        <form action="#" method="post" 
          {% if settings.feedback_captcha_enabled %} data-recaptcha="true" {% endif %}
          class="popup__form form-popup"
        >
          <div class="form-popup__group">
            <div class="form-popup__input-group input-group">
              <div class="input-group__label">Имя</div>
              <div data-js="input-wrapper" class="input-group__wrapper">
                <input data-required autocomplete="off" type="text" name="name" data-error="Введите имя" placeholder="" class="input-group__input input">
                <button type="button" data-js="input-clear" class="input-group__clear"></button>
              </div>
              {% comment %} <div class="form-error" data-form-error="">Некорректный формат почты</div> {% endcomment %}
            </div>
            <div class="form-popup__input-group input-group">
              <div class="input-group__label">Телефон</div>
              <div data-js="input-wrapper" class="input-group__wrapper">
                <input type="text" autocomplete="off" name="phone" data-error="Введите телефон" placeholder="" 
                  class="input-group__input input" data-mask-phone>
                <button type="button" data-js="input-clear" class="input-group__clear"></button>
              </div>
            </div>
            <div class="form-popup__input-group input-group">
              <div class="input-group__label">Email</div>
              <div data-js="input-wrapper" class="input-group__wrapper">
                <input data-required="email" autocomplete="off" type="text" name="email" data-error="Введите email" placeholder="" class="input-group__input input">
                <button type="button" data-js="input-clear" class="input-group__clear"></button>
              </div>
            </div>

            {% if settings.feedback_captcha_enabled %}
              <div class="form-popup__input-group input-group feedback__field-area" data-feedback-form-field-area>
                  <div 
                      data-feedback-form-recaptcha='{
                      "isRequired": true, 
                      "errorMessage": "{{ messages.recaptcha_error | escape }}"
                      }' 
                      data-error="Пройдите капчу"
                      class="feedback__recaptcha">
                  </div>
                  <input type="text" name="em-recaptcha" class="input" hidden>
                  <div data-feedback-form-field-error class="feedback__field-error form-popup__input-mess-error"></div>
              </div>
          {% endif %}
          {% comment %} <input hidden type="text" value="Сообщить о поступлении" name="feedback[subject]" />
          <input hidden type="text" value="Товар не выбран" name="feedback[content]" /> {% endcomment %}
          </div>
          <div class="form-popup__group">
            <button type="button" class="form-popup__button btn btn_large btn_primary"{%- unless client -%} disabled{%- endunless -%} data-em-form-submit>Подписаться</button>
            <div class="form-popup__policy">
              Нажимая на кнопку «Подписаться», вы соглашаетесь с <a href="{{ widget_settings.url_1 }}">политикой конфиденциальности</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div id="popup-subscribe-success" aria-hidden="true" class="popup">
  <div class="popup__wrapper">
    <div class="popup__content">
      <button data-close type="button" class="popup__close"></button>
      <div class="popup__body">
        <div class="popup__title-wrapper">
          <div class="popup__title">Вы подписались на товар!</div>
          <div class="popup__subtitle">Мы сообщим, когда он появится в продаже</div>
        </div>
        <button type="button" data-close class="popup__button btn btn_medium btn_primary">Продолжить покупки</button>
      </div>
    </div>
  </div>
</div>