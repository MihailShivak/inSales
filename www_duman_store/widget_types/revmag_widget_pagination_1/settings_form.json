{
  "{{ messages.c_design }}": [
    {
      "group_name": "{{ messages.c_colors }}",
      "items": [
        {
          "name":"color-border",
          "label":"{{ messages.c_border }}",
          "value":"",
          "type":"color",
          "clearable":false
        },
        {
          "name":"bg-no-active",
          "label":"{{ messages.c_no_active }}",
          "value":"",
          "type":"color",
          "clearable":false
        },
        {
          "name":"bg-active",
          "label":"{{ messages.c_active }}",
          "value":"",
          "type":"color",
          "clearable":false
        }
      ]
    }
  ],
  "{{ messages.layout_settings }}":[
    {
      "group_name":"{{ messages.background }}",
      "items":[
        {
          "name":"bg",
          "label":"{{ messages.layout_background_color }}",
          "value":"",
          "type":"color",
          "clearable":true
        },
        {
          "class":"checkbox",
          "name":"layout-wide-bg",
          "label":"{{ messages.wide_background }}",
          "value":null,
          "type":"checkbox"
        }
      ]
    },
    {
      "group_name":"{{ messages.indentation }}",
      "items":[
        {
          "class":"range",
          "name":"layout-mt",
          "min":0,
          "max":10,
          "step":0.5,
          "label":"{{ messages.margin_top }}",
          "type":"range",
          "unit":"vw"
        },
        {
          "class":"range",
          "name":"layout-mb",
          "min":0,
          "max":10,
          "step":0.5,
          "label":"{{ messages.margin_bottom }}",
          "type":"range",
          "unit":"vw"
        },
        {
          "class":"range",
          "name":"layout-pt",
          "min":0,
          "max":10,
          "step":0.5,
          "label":"{{ messages.padding_top }}",
          "type":"range",
          "unit":"vw"
        },
        {
          "class":"range",
          "name":"layout-pb",
          "min":0,
          "max":10,
          "step":0.5,
          "label":"{{ messages.padding_bottom }}",
          "type":"range",
          "unit":"vw"
        }
      ]
    },
    {
      "group_name":"{{ messages.content_settings }}",
      "items":[
        {
          "class":"range",
          "name":"layout-content-max-width",
          "min":400,
          "max":2000,
          "step":2,
          "label":"{{ messages.content_max_width }}",
          "type":"range",
          "unit":"px"
        },
        {
          "class":"checkbox",
          "name":"layout-wide-content",
          "label":"{{ messages.wide_content }}",
          "value":null,
          "type":"checkbox"
        },
        {
          "class":"checkbox",
          "name":"layout-edge",
          "label":"{{ messages.edge }}",
          "value":null,
          "type":"checkbox"
        }
      ]
    },
    {
      "group_name":"{{ messages.adaptive }}",
      "items": [
        {
          "class": "checkbox",
          "name": "hide-desktop",
          "label": "{{ messages.hide_desktop }}",
          "value": null,
          "type": "checkbox"
        },
        {
          "class": "checkbox",
          "name": "hide-mobile",
          "label": "{{ messages.hide_mobile }}",
          "value": null,
          "type": "checkbox"
        }
      ]
    }
  ]
}