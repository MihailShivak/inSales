          <div class="product-card-info__group product-card__review">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M8.00016 1.33325C4.32426 1.33325 1.3335 4.32402 1.3335 7.99992C1.3335 9.09169 1.62107 10.1115 2.0874 11.0214L1.36475 13.6093C1.19643 14.2104 1.7908 14.8041 2.39209 14.636L4.98128 13.9133C5.89051 14.379 6.90915 14.6666 8.00016 14.6666C11.6761 14.6666 14.6668 11.6758 14.6668 7.99992C14.6668 4.32402 11.6761 1.33325 8.00016 1.33325ZM8.00016 2.33325C11.1356 2.33325 13.6668 4.86449 13.6668 7.99992C13.6668 11.1353 11.1356 13.6666 8.00016 13.6666C6.99917 13.6666 6.06425 13.406 5.24821 12.9511C5.13299 12.8868 4.99703 12.8707 4.86995 12.9062L2.40771 13.5937L3.09521 11.1327C3.13073 11.0057 3.11458 10.8697 3.05029 10.7545C2.59471 9.93774 2.3335 9.00142 2.3335 7.99992C2.3335 4.86449 4.86473 2.33325 8.00016 2.33325Z" fill="#514B47"/>
            </svg>
            {% if account.reviews_enabled? and product.reviews_count > 0 %}
              <button type="button" data-popup="#popup-list-review">{{ product.reviews_count }} отзыва </button>
            {% else %}
              <div>
                <span>Отзывов пока нет, </span><button type="button" data-popup="#popup-send-review" class="product-card__review-btn">оставить</button><span> первый</span>
              </div>
            {% endif %}
          </div>
          <div class="product-card-info__group product-card__descr">
            <div data-spollers class="product-card-info__descr product-card-descr">
              {% if product.description %}
                <div class="product-card-descr__item">
                  <button type="button" data-spoller class="product-card-descr__title">
                    <span class="product-card-descr__title-icon"></span>
                    <span>Описание</span>
                  </button>
                  <div class="product-card-descr__body">
                    <div class="product-card-descr__text-wrapper">
                      {{ product.description }}
                      <button class="btn btn_payment _active" data-popup="sizes">Таблица размеров</button>
                      <p class="product-card-descr__italic">Замеры изделий могут отличаться на 1-2 см</p>
                    </div>
                  </div>
                </div>
              {% endif %}
              {% if product.fields.obmery_izdeliya.value != '' %}
                <div class="product-card-descr__item">
                  <button type="button" data-spoller class="product-card-descr__title">
                    <span class="product-card-descr__title-icon"></span>
                    <span>Обмеры изделия</span>
                  </button>
                  <div class="product-card-descr__body">
                    <div class="product-card-descr__text-wrapper">
                      {{ product.fields.obmery_izdeliya.value }}
                    </div>
                  </div>
                </div>
              {% endif %}
              {% if product.properties.size > 0 %}
                <div class="product-card-descr__item">
                  <button type="button" data-spoller class="product-card-descr__title">
                    <span class="product-card-descr__title-icon"></span>
                    <span>Характеристики</span>
                  </button>
                  <div class="product-card-descr__body">
                    <div class="product-card-descr__text-wrapper">
                      {% for property in product.properties %}
                        {% if property.handle == 'badge' %}
                          {% continue %}
                        {% endif %}
                        {{ property.name | capitalize }}:<br>
                        {% for item in property.characteristics -%}
                          {{- item.name -}}
                          <br>
                        {% endfor -%}
                        <br>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endif %}
              {% for field in product.fields %}
                {% if field.value != '' %}
                  <div class="product-card-descr__item">
                    <button type="button" data-spoller class="product-card-descr__title">
                      <span class="product-card-descr__title-icon"></span>
                      <span>{{ field.title }}</span>
                    </button>
                    <div class="product-card-descr__body">
                      <div class="product-card-descr__text-wrapper">
                        {{ field.value }}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
              <div class="product-card-descr__item">
                <button type="button" data-spoller class="product-card-descr__title">
                  <span class="product-card-descr__title-icon"></span>
                  <span>Загружаем доставки...</span>
                </button>
                <div class="product-card-descr__body">
                  <button type="button" data-popup="#popup-city" class="product-card-descr__popup-btn">
                    изменить город
                  </button>
                  <div data-spollers class="product-card-descr__delivery product-delivery" data-delivery-options></div>
                </div>
              </div>
            </div>
            <button type="button" class="product-card-info__reviews" hidden>Отзывы <span>(3)</span></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Фото в попапе -->
{% if popup_i > 0 %}
  <div id="popup-gallery" aria-hidden="true" class="popup popup-gallery">
    <div class="popup-gallery__content popup__content" data-js-slider="gallery-slider">
      <button type="button" data-close class="popup__close popup-gallery__close"></button>

      <button type="button" class="gallery-slider__plus">+</button>
      <button type="button" class="gallery-slider__arrow swiper-button-prev"></button>
      <button type="button" class="gallery-slider__arrow swiper-button-next"></button>

      <div class="popup-gallery__thumbs swiper">
        <div class="popup-thumbs__list swiper-wrapper">
          {% if product.video_links.size > 0 %}
            {% for video in product.video_links %}
              <div class="popup-thumb__item swiper-slide">
                <img
                  class="entered _lazy-loaded"
                  data-src="{{ product.first_image.large_url | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2' }}"
                  alt=""
                >
              </div>
            {% endfor %}
          {% endif %}
          {% for image in product.images %}
            <div class="popup-thumb__item swiper-slide">
              <img
                class="entered _lazy-loaded"
                data-src="{{ image.large_url | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2' }}"
                alt=""
              >
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="popup-gallery__list swiper">
        <div class="popup-gallery__list-wrapper swiper-wrapper">
          {% if product.video_links.size > 0 %}
            {% assign popup_i = 0 %}
            {% for video in product.video_links %}
              {% assign popup_i = popup_i | plus: 1 %}
              <div class="popup-gallery__item swiper-slide" data-close>
                <video
                  data-em-video="{{ video.url }}"
                  data-video-i="{{ popup_i }}"
                  data-em-video-controls="true"
                  preload="metadata"
                  controls
                  controlslist="nodownload"
                  playsinline
                  loop
                  preload="metadata"
                  class="popup__gallery-video"
                >
                  <!-- Fallback для браузеров без поддержки HLS -->
                  {% comment %}
                    <source src="{{ video.url }}.mp4" type="video/mp4">
                    <source src="{{ video.url }}.m3u8" type="application/vnd.apple.mpegurl">
                  {% endcomment %}
                  Ваш браузер не поддерживает воспроизведение видео.
                </video>
              </div>
            {% endfor %}
          {% endif %}
          {% for image in product.images %}
            <div class="popup-gallery__item swiper-slide">
              <picture>
                <!-- webp -->
                {% comment %}
                  <source type="image/webp"
                  data-srcset="{{ image.original_url | image_url: 2048, format: 'webp' | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2' }}" >
                {% endcomment %}
                <img
                  class="popup__gallery-img"
                  data-src="{{ image.original_url | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstorel2' }}"
                  alt=""
                >
              </picture>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  {% assign popup_i = null %}
{% endif %}

