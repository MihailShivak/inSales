{% comment %} {% include "system_v4_fonts" %} {% endcomment %}
<style>
@charset "UTF-8";

@font-face {
    font-family: TTFors;
    font-display: swap;
    src: url("{{ 'TTFors-Regular.woff2' | asset_url }}") format("woff2"), url("{{ 'TTFors-Regular.woff' | asset_url }}") format("woff");
    font-weight: 400;
    font-style: normal;
}

@font-face {
    font-family: TTFors;
    font-display: swap;
    src: url("{{ 'TTFors-Medium.woff2' | asset_url }}") format("woff2"), url("{{ 'TTFors-Medium.woff' | asset_url }}") format("woff");
    font-weight: 500;
    font-style: normal;
}

@font-face {
    font-family: KudryashevHeadline;
    font-display: swap;
    src: url("{{ 'kudryashevheadline-sans.woff2' | asset_url }}") format("woff2"), url("{{ 'kudryashevheadline-sans.woff' | asset_url }}") format("woff");
    font-weight: 500;
    font-style: normal;
}

