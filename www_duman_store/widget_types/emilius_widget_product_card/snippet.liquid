<script>
  (function () {
    const $ = window.jQuery;
    if (!$) return;

    const $bocBtn = $('.buy-one-click[data-card-product-add]');

    // Наблюдаем за изменениями в форме товара
    const observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
          const $selectVariantBtn = $('[data-em-select-variant]');
          if (!$selectVariantBtn.hasClass('button__hide')) {
            // Кнопка "Выберите размер" скрыта - значит размер выбран
            const variantId =
              $('[data-product-variants-list]').data('selected-variant-id') ||
              $('input[name="id"]:checked').val() ||
              $('input[name="id"]').val();

            if (variantId) {
              $bocBtn.attr('data-variant-id', variantId);
              $bocBtn.removeClass('button__hide');
            }
          } else {
            $bocBtn.addClass('button__hide');
          }
        }
      });
    });

    // Начинаем наблюдение
    const $selectVariantBtn = $('[data-em-select-variant]');
    if ($selectVariantBtn.length) {
      observer.observe($selectVariantBtn[0], { attributes: true });
    }
  })();
</script>

