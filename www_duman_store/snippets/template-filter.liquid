
{% comment %} ! Шаблон ПК блока фильтра {% endcomment %}
<script type="text/template" data-template-id="filter-item">
    <div class="filters__group" data-filter-id="<%= id %>">
        <button type="button" data-spoller data-spoller-fade data-spoller-close class="filters__title-wrapper">
            <span class="filters__title">
                <%= title %><span class="filters__title-count"></span>
            </span>
        </button>
        <div class="filters__body" hidden>
            <div class="filters__label"><%= title %></div>
            <div class="filters__list">
                <% for (const value of values) { %>
                    <div class="filters__list-item checkbox">
                        <label class="checkbox__label checkbox__label_filter">
                            <input data-error="" class="checkbox__input" type="checkbox" value="<%= value.id %>" data-property-id="<%= id %>">
                            <span class="checkbox__text-wrapper">
                                <span class="checkbox__point"></span>
                                <% if (id == 1607435 && value.image_url) { %>
                                    <span class="checkbox__text checkbox__text_color">
                                        <img class="checkbox__text-icon" src="<%= value.image_url %>" >
                                        <%= value.title %>
                                    </span>
                                <% } else { %>
                                    <span class="checkbox__text"><%= value.title %></span>
                                <% } %>
                            </span>
                        </label>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</script>


{% comment %} ! Шаблон фильтра в мобилке {% endcomment %}
<script type="text/template" data-template-id="filter-item-mob">
    <div class="mob-popup__group" data-filter-id="<%= id %>">
        <div class="mob-popup__group-title-wrapper">
            <div class="mob-popup__group-title"><%= title %></div>
        </div>
        <div class="mob-popup__checkbox-list checkbox-list">
            <% values.forEach(function (value, index) { %>
                <div class="checkbox-list__item checkbox-btn">
                    <label class="checkbox-btn__label">
                        <input data-error="Ошибка" class="checkbox-btn__input" type="checkbox" value="<%= value.id %>" data-property-id="<%= id %>">
                        <div class="checkbox-btn__text-wrapper">
                            <span class="checkbox-btn__text"><%= value.title %></span>
                        </div>
                    </label>
                </div>
            <% }); %>
        </div>
    </div>
</script>

{% comment %} ! Шаблон фильтра цветов в мобилке {% endcomment %}
<script type="text/template" data-template-id="filter-color-mob">
    <div class="mob-popup__group" data-filter-id="<%= id %>">
        <div class="mob-popup__group-title-wrapper">
            <div class="mob-popup__group-title"><%= title %></div>
            <% if (values.length > 8) { %>
                <button data-mob-popup-open="filter-colors" type="button" class="mob-popup__group-more">Все</button>
            <% } %>
        </div>
        <div class="mob-popup__checkbox-list checkbox-list" >
            <% values.slice(0, 8).forEach(function (value, index) { %>
                <div class="checkbox-list__item checkbox-btn checkbox-btn_color">
                    <label class="checkbox-btn__label">
                        <input data-error class="checkbox-btn__input" type="checkbox" value="<%= value.id %>" data-property-id="<%= id %>">
                        <div class="checkbox-btn__text-wrapper">
                            <span class="checkbox-btn__text checkbox-btn__text_color">
                                <% if (value.image_url) { %>
                                    <img class="checkbox__text-icon" src="<%= value.image_url %>">
                                <% } %>
                                <%= value.title %>
                            </span>
                        </div>
                    </label>
                </div>
            <% }); %>
        </div>
    </div>
</script>

{% comment %} ! Шаблон попапа фильтра цветов в мобилке {% endcomment %}
<script type="text/template" data-template-id="filter-popup-color-mob">
    <% values.forEach(function (value, index) { %>
        <div class="mob-popup__filter-list-item checkbox">
            <label class="checkbox__label checkbox__label_filter">
                <input data-index="<%= index %>" class="checkbox__input" type="checkbox" value="<%= value.id %>" data-property-id="<%= id %>">
                <span class="checkbox__text-wrapper">
                    <span class="checkbox__point"></span>
                    <span class="checkbox__text checkbox__text_color">
                        <% if (value.image_url) { %>
                            <img class="checkbox__text-icon" src="<%= value.image_url %>">
                        <% } %>
                        <span class="checkbox-btn__text"><%= value.title %></span>
                    </span>
                </span>
            </label>
        </div>
    <% }); %>
</script>

{% comment %} ! Фильтр ПК цены {% endcomment %}
<script type="text/template" data-template-id="filter-price">
    <div class="filters__group" data-filter-id="price">
        <button type="button" data-spoller data-spoller-fade data-spoller-close class="filters__title-wrapper">
            <span class="filters__title">
                Цена <span class="filters__title-count"></span>
            </span>
        </button>
        <div class="filters__body" hidden>
            <div class="filters__label">Цена</div>
            <div data-range class="filters__price price-filter">
                <div class="price-filter__inputs">
                    <div class="price-filter__input-wrap">
                        <input data-range-from="<%= priceMin %>" autocomplete="off" type="text" value="<%= priceMin %>" name="price_min" class="price-filter__input">
                        <span>от</span>
                    </div>
                    <div class="price-filter__input-wrap">
                        <input data-range-to="<%= priceMax %>" autocomplete="off" type="text" value="<%= priceMax %>" name="price_max" class="price-filter__input">
                        <span>от</span>
                    </div>
                </div>
                <div data-range-item class="price-filter__range"></div>
            </div>
        </div>
    </div>
</script>

