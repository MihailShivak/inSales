                  </svg>
                {% endfor %}
              </div>
            {% endif %}
            <div class="page__reviews-text">{{ item.content | default: 'Без описания' | truncate: 500, '...' }}</div>
            <div class="page__reviews-name">{{ item.author }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<div class="page__subscribe">
  <div class="page__subscribe-wrapper">
    <h2 class="page__title page__subscribe-title">Подпишитесь на личные заметки Екатерины</h2>
    <div class="page__subscribe-subtitle">Никакого спама, только стиль и анонсы коллекций</div>
    {% comment %} ! Сделать подстановку хэша (form_hash) {% endcomment %}
    <form
      method="POST"
      action="https://cp.unisender.com/ru/subscribe?hash=6x6h415quodmsx55zzie37qc4zkahmou1dwx4j1dtxfec66ufjqry"
      name="subscribtion_form"
      class="page__subscribe-form"
      target="_blank"
    >
      <input type="hidden" name="charset" value="UTF-8">
      <input type="hidden" name="default_list_id" value="1">
      <input type="hidden" name="overwrite" value="2">
      <input type="hidden" name="is_v5" value="1">
      <input
        data-reqiured="Email"
        autocomplete="off"
        type="email"
        name="email"
        data-error="Ошибка"
        placeholder="Email"
        class="footer__form-input input-promocode"
      >
      {% comment %} {% unless widget_settings.form_id or widget_settings.form_hash %}disabled{% endunless %} {% endcomment %}
      <button type="submit" class="footer__form-button btn btn_medium btn_primary">Подписаться</button>
      <label class="page__subscribe-policy-agree">
        <input type="checkbox" required class="page__checkbox-input">
        <a href="/page/agreement">Согласен с обработкой</a> персональных данных
      </label>
    </form>
    <div class="page__subscribe-note">Присоединились 2 000+ подписчиков</div>
  </div>
</div>
</div>
</div>
