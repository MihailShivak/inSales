<!DOCTYPE html>
<html class="{{ default_checkout2_layout_class }}">
<head data-bbb>
    {% include "head" %}
</head>
<body class="adaptive" data-multi-lang="{{ language.not_default? }}">
    {% include "system_no_js_alert" %}
    <div class="page_layout page_layout-clear">
        <header>
            {% assign isOrder = true %}
            {% for widgetDrop in widget_lists.header-list.widgets %}
                {% widget widgetDrop %}
            {% endfor %}
        </header>

        <main>
            {% assign standart_checkout = true %}
            {% if standart_checkout == true %}
                <div class="layout">
                    <div class="layout__content layout__content-order">
                        <section id="new_order">
                            <div class="order__container order__container_alt">
                                <div id="new_order_form" data-dev class="order__form">
                                    <input type="hidden" name="lang" value="{{ language.locale }}"/>
                                    <div class="order__head"{% unless client %} id="data-client-login"{% endunless %}>
                                        <a href="/cart_items" class="order__link-back">Вернуться в корзину</a>
                                        {% unless client %}
                                            <div class="order__note" id="data-client-login">
                                                <div class="order__note-text">
                                                    Для оформления заказа 
                                                    <button data-popup="#popup-login" type="button" class="order__note-link">войдите</button> или 
                                                    <button data-popup="#popup-login" type="button" class="order__note-link">зарегистрируйтесь</button> 
                                                </div>
                                            </div>
                                        {% endunless %}
                                        {% comment %} {% unless client %}
                                            <div class="order__note" id="data-client-login">
                                                <div class="order__note-text">
                                                    <button data-popup="#popup-login" type="button" class="order__note-link">Авторизуйтесь</button> и получите 5% бонусных баллов с покупки
                                                </div>
                                            </div>
                                        {% endunless %} {% endcomment %}
                                    </div>
                                    <div class="order__body">
                                        <div class="order__group">
                                            <div class="order__row-wrapper">
                                                <div class="order__row">
                                                    <div class="order__title">1. Доставка</div>
                                                </div>
                                            </div>
                                            <div class="order__input-wrapper" data-js="input-wrapper" id="orderAddress"></div>
                                            <div class="order__row-wrapper">
                                                <div class="order__row">
                                                    <div class="order__label">Способы доставки</div>
                                                    <div class="order__input-group" data-wrapper-error="Ошибка выбора доставки">
                                                        <div class="order__options order-options deliveries_bobr" data-delivery-methods></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="order__row-wrapper" data-adress-delivery></div>
                                            <div class="order__row-wrapper">
                                                <div class="order__row">
                                                    <div class="order__label">Комментарий к&nbsp;заказу</div>
                                                    <div class="order__input-group">
                                                        <div class="order__input-wrapper" data-form-comment></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="order__group">
                                            <div class="order__row-wrapper">
                                                <div class="order__row">
                                                    <div class="order__title">2. Покупатель</div>
                                                </div>
                                                <div class="order__row">
                                                    <div class="order__label">Имя</div>
                                                    <div class="order__input-group">
                                                        <div class="order__input-wrapper" data-form-client-name data-wrapper-error="Введите имя" data-wrapper-required>
                                                            <button type="button" data-js="input-clear" class="order__input-clear"></button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="order__row">
                                                    <div class="order__label">Фамилия</div>
                                                    <div class="order__input-group">
                                                        <div class="order__input-wrapper" data-form-client-surname data-wrapper-error="Введите фамилию" data-wrapper-required>
                                                            <button type="button" data-js="input-clear" class="order__input-clear"></button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="order__row" data-wrapper-client-hidd>
                                                    <div class="order__label">Дата рождения</div>
                                                    <div class="order__input-group">
                                                        <div class="order__input-wrapper" data-from-datebirth></div>
                                                        <div class="order__input-note">
                                                            Пришлем персональные предложения ко дню рождения
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="order__row-wrapper">
                                                <div class="order__row">
                                                    <div class="order__label">Телефон</div>
                                                    <div class="order__input-group">
                                                        <div class="order__input-wrapper" data-form-phone data-wrapper-error="Заполните телефон" data-wrapper-required="tel" >
                                                            <button type="button" data-js="input-clear" class="order__input-clear"></button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="order__row" data-wrapper-client-hidd>
                                                    <div class="order__label">Email</div>
                                                    <div class="order__input-group">
                                                        <div class="order__input-wrapper" data-form-email data-wrapper-error="Введите email" data-wrapper-required="email">
                                                            <button type="button" data-js="input-clear" class="order__input-clear"></button>
                                                        </div>
                                                        <div class="order__input-note">
                                                            Необходимо для отправки чека
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="order__row-wrapper" data-wrapper-client-hidd>
                                                <div class="order__row">
                                                    <div class="order__checkbox checkbox">
                                                        <label class="checkbox__label checkbox__label_filter" data-from-subscribe>
                                                            <span class="checkbox__text-wrapper">
                                                                <span class="checkbox__point"></span>
                                                                <span class="checkbox__text">Получать новости и узнавать о специальных предложениях в числе первых</span>
                                                            </span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="order__group">
                                            <div class="order__row-wrapper">
                                                <div class="order__row">
                                                    <div class="order__title order__title-pay">3. Оплата</div>
                                                    <div class="order__input-group" data-wrapper-error="Ошибка выбора оплаты">
                                                        <div class="order__options order-options" data-payment-list></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="order__row-wrapper">
                                                <div class="order__row order__subscription">
                                                    <div class="order__checkbox checkbox">
                                                        <label class="checkbox__label checkbox__label_filter" data-form-subscription>
                                                            <span class="checkbox__text-wrapper">
                                                                <span class="checkbox__point"></span>
                                                                <span class="checkbox__text">Получать уведомления о заказе</span>
                                                            </span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="order__sidebar">
                                        <div class="order__sidebar-title">
                                            Ваш заказ <span class="order__sidebar-title-count" data-cart-item-count></span>
                                        </div>
                                        <div class="order__sidebar-products-list">
                                            {% for item in cart.items %}
                                                <div class="order__sidebar-products-item popup-basket-item">
                                                    <div class="popup-basket-item__image-wrapper">
                                                        <img data-src="{{ item.variant.first_image.large_url }}" src="{{ item.variant.first_image.large_url }}" alt="{{ item.title }}">
                                                    </div>
                                                    <div class="popup-basket-item__body">
                                                        <div class="popup-basket-item__name-wrapper">
                                                            <a href="{{ item.product.url | add_param: 'variant_id', item.variant.id }}" class="popup-basket-item__name">{{ item.title }}</a>
                                                            <div class="popup-basket-item__price">{{ item.total_price | money }}</div>
                                                        </div>
                                                        <div class="popup-basket-item__size">{{ item.quantity }} шт,
                                                            {% if item.variant.option_values.size > 0 %}
                                                                {% for option_value in item.variant.option_values %}
                                                                    {% if option_value.option_name.title == 'Размер' %}
                                                                        {{ option_value.option_name.title }} {{ option_value.title }}
                                                                    {% endif %}
                                                                {% endfor %}
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <div class="order__sidebar-total">
                                            <div class="order__sidebar-total-item order__sidebar-total-item_discount" hidden>
                                                <span id="discount-title">Скидка</span>
                                                <span class="dotts"></span>
                                                <span id="discounts-price"></span>
                                            </div>
                                            <div class="order__sidebar-total-item">
                                                <span>Сумма заказа</span>
                                                <span class="dotts"></span>
                                                <span id="items_price"></span>
                                            </div>
                                            <div class="order__sidebar-total-item">
                                                <span>Доставка</span>
                                                <span class="dotts"></span>
                                                <span id="delivery_price"></span>
                                            </div>
                                            <div class="order__sidebar-total-item order__sidebar-total-item_total">
                                                <span>Итого</span>
                                                <span class="dotts"></span>
                                                <span id="total_price"></span>
                                            </div>
                                        </div>
                                        <div class="order__sidebar-button-wrapper">
                                            <button type="submit" class="order__sidebar-button btn btn_primary btn_large" id="create_order" disabled>Оформить заказ</button>
                                            <div class="order__sidebar-policy">
                                                Нажимая на кнопку «Оформить заказ», я принимаю условия <a href="/page/oferta">публичной оферты</a> и <a href="/page/oferta">политики конфиденциальности</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        {% yield %}
                    </div>
                </div>
            {% else %}
                <div data-show-check></div>
            {% endif %}
        </main>

        <footer>
            {% for widgetDrop in widget_lists.footer-list.widgets %}
                {% widget widgetDrop %}
            {% endfor %}
        </footer>

        <div class="outside-widgets">
            {% for widgetDrop in widget_lists.outside-list.widgets %}
                {% widget widgetDrop %}
            {% endfor %}
        </div>
    </div>
</body>
  {{ 'checkout2.core' | global_stylesheet_tag }}

  {%- capture css_js_lists -%}header-list, footer-list, outside-list, cart-list{%- endcapture -%}

  {% if sidebar_show %}
    {% if template contains 'blog' or template contains 'article' %}
      {% assign css_js_lists = css_js_lists | append: ', sidebar_blog-list' %}
    {% else %}
      {% assign css_js_lists = css_js_lists | append: ', sidebar-list' %}
    {% endif %}
  {% endif %}

  {% widgets_assets css_js_lists %}

  {% include "styles" %}
  {% include "script" %}

  {% comment %} Касотмизция оформления заказа {% endcomment %}
  <script src="{{ 'order.js' | asset_url }}" charset="utf-8"></script>

  {% include "microdata" %}
</html>
