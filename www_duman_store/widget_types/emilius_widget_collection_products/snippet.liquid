{% case widget_settings.type-select %}	
    {% when 'get-recetly-viewed' %}	
        {% assign title = 'Вы смотрели' %}
    {% when 'get-favorites' %}
        {% assign title = 'Вишлист' %}		
    {% when 'get-recommended' %}
        {% assign title = 'Рекомендуем' %}		
{% endcase %}

{% if widget_settings.type-select == 'get-recommended' and widget_settings.recommended-category %}
    {% assign products = collections[widget_settings.recommended-category].products %}
{% endif %}
{% assign limit = widget_settings.limit-products %}

<!-- products-wrapper -->
<section class="products-wrapper" 
    data-type-select="{{ widget_settings.type-select }}"
    data-limit-products="{{ widget_settings.limit-products }}"
    data-show-block="{{ widget_settings.hide_block }}"
{% unless products and widget_settings.hide_block == false %} hidden {% endunless %}>
    <div class="products-wrapper__container products-wrapper__container_alt">
        <div class="products-wrapper__head">
            <div class="products-wrapper__title-wrapper">
                <div class="products-wrapper__title">{{ title }}</div>
            </div>
        </div>
        <div class="products-wrapper__list" {% unless products %} hidden {% endunless %}>
            {% if products.size > 0 %}
            {% for product in products limit: widget_settings.limit-products %}
                {% assign firstVariant = null %}

                <form class="products-wrapper__item products-item" data-js="product-item" method="" data-cust-product-id="{{ product.id }}">
                    <div class="products-item__img-wrapper">
                        <a href="{{ product.url }}" class="products-item__img">
                            {% if product.images.size > 0 %}
                                <picture>
                                    <source media="(max-width:700px)" type="image/webp" 
                                        srcset="{{ product.first_image | image_url: 700,  format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }},
                                                {{ product.first_image | image_url: 1200, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }} 2x"> 
                                    <source type="image/webp" 
                                        srcset="{{ product.first_image | image_url: 1400, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }},
                                                {{ product.first_image | image_url: 1800, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }} 2x">
                                                    
                                    <img src="{{ product.first_image | image_url: 1400 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }}" 
                                        srcset="{{ product.first_image | image_url: 1400 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }},
                                                {{ product.first_image | image_url: 1800 | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstore' }} 2x" 
                                        alt="{{ product.title }}" class="entered _lazy-loaded" loading="lazy">
                                </picture>

                                {% comment %} <picture>
                                    <source media="(max-width:700px)" type="image/webp" data-srcset="{{ product.first_image | image_url: 700 }}, {{ product.first_image | image_url: 1200 }} 2x"> 
                                    <source media="(max-width:1020px)" type="image/webp" data-srcset="{{ product.first_image | image_url: 980 }}, {{ product.first_image | image_url: 1600 }} 2x"> 
                                    <source media="(max-width:1700px)" type="image/webp" data-srcset="{{ product.first_image | image_url: 980 }}, {{ product.first_image | image_url: 1600 }} 2x">
                                    <img data-src="{{ product.first_image | image_url: 980 }}" data-srcset="{{ product.first_image | image_url: 980 }}, {{ product.first_image | image_url: 1600 }} 2x" alt="{{ product.title }}" class="entered _lazy-loaded">
                                </picture> {% endcomment %}
                            {% else %}
                                <img src="{{ 'no_image.svg' | asset_url }}" data-src="{{ 'no_image.svg' | asset_url }}" alt="{{ product.title }}" class="image-none entered _lazy-loaded">
                            {% endif %}
                        </a>
                        <div class="products-item__actions">
                            <button type="button" class="products-item__action products-item__action-whishlist" data-em-favorites-trigger="{{ product.id }}"></button>
                            {% if product.available %}
                                <button type="button" class="products-item__action products-item__action-addcart"
                                    {%- if product.variants.size > 1 -%}
                                        data-js="product-item-addcard" 
                                        data-add-cart="{{ product.id }}"
                                    {%- else -%}
                                        data-btn-cart-add="{{ product.variants.first.id }}"
                                    {%- endif -%}
                                ></button>
                            {% else %}
                                <button type="button" class="products-item__action products-item__action-subscribe" 
                                    data-popup="#popup-subscribe"
                                ></button>
                            {% endif %}
                        </div>
                        {% if product.available %}
                            {% assign latestSizes = "" %}
                            {% assign countLatestSizes = 0 %}
                            <!--noindex-->
                            <div class="products-item__sizes-wrapper" data-js="product-sizes-wrapper">
                                <button type="button" class="products-item__sizes-close" data-js="product-sizes-close"></button>
                                <div class="products-item__sizes-content">
                                    <div class="products-item__sizes-title">Выберите размер</div>
                                    <div class="products-item__sizes-list checkbox-list">
                                        {% for variant in product.variants %}
                                            {% if variant.available == false or variant.quantity == 0 %}
                                                {% continue %}
                                            {% elsif variant.quantity == 1 %}
                                                {% assign latestSizes = latestSizes |  append: ' ' |  append: variant.title %}
                                                {% assign countLatestSizes = countLatestSizes | plus: 1 %}
                                            {% endif %}
                                            {% unless firstVariant %}
                                                {% assign firstVariant = variant %}
                                            {% endunless %}
                                            <div class="checkbox-list__item checkbox-btn">
                                                <label class="checkbox-btn__label">
                                                    <input class="checkbox-btn__input" type="radio" name="{{ product.id }}" value="{{ variant.id }}" data-size-select>
                                                    <div class="checkbox-btn__text-wrapper">
                                                        <span class="checkbox-btn__text">{{ variant.option_values[0].title | default: variant.title }}</span>
                                                    </div>
                                                </label>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    {% if countLatestSizes == 1 %}
                                        <div class="products-item__sizes-text">{{ latestSizes }} — последний размер</div>
                                    {% elsif countLatestSizes > 1 %}
                                        <div class="products-item__sizes-text">{{ latestSizes }} — последние размеры</div>
                                    {% endif %}
                                    {% comment %} <div class="products-item__sizes-bottom sizes__bottom-mob">
                                        <button data-popup="#" type="button" class="products-item__sizes-table">
                                            <span>Таблица размеров</span>
                                        </button>
                                    </div> {% endcomment %}
                                    <div class="product-item__sizes__buttons">
                                        <button type="button" class="btn-icon btn-icon_medium btn-icon_secondary btn-icon_remove" data-size-remove hidden></button>
                                        <button type="button" class="btn btn_medium btn_primary btn-item_added" data-size-cart-add disabled>
                                            <span>Размер не выбран</span>
                                        </button>
                                    </div>
                                </div>
                                {% comment %} <div class="products-item__sizes-bottom sizes__bottom-pc">
                                    <button data-popup="#" type="button" class="products-item__sizes-table">
                                        <span>Таблица размеров</span>
                                    </button>
                                </div> {% endcomment %}
                            </div>
                            <!--/noindex-->
                        {% endif %}
                        <div class="products-item__sizes-filling" data-js="product-sizes-close"></div>
                    </div>
                    <div class="products-item__info">
                        <a href="{{ product.url }}" class="products-item__title">{{ product.title }}</a>
                        <div class="products-item__properties">
                            <div class="products-item__prices">
                                {% if product.old_price and product.price < product.old_price %}
                                    <span class="products-item__price products-item__price_new">{{ product.price | money }}</span>
                                    <span class="products-item__price products-item__price_old">{{ product.old_price | money }}</span>
                                {% else %}
                                    <span class="products-item__price price">{{ product.price | money }}</span>
                                {% endif %}
                            </div>
                            
                            <div class="products-item__colors colors-list"
                                {%- if firstVariant -%}
                                    data-first-variant="{{ firstVariant.id }}" 
                                    data-variant-sku="{{ firstVariant.sku }}"
                                {%- else -%}
                                    data-first-variant="{{ product.variants.first.id }}" 
                                    data-variant-sku="{{ product.variants.first.sku }}"
                                {%- endif -%}
                            ></div>
                            {% comment %} <div class="products-item__colors colors-list">
                                {% assign name = product.canonical_collection.url | remove: '/collection/' %}
                                {% for prod in collections[name].products %}
                                    {% if prod.sku == product.sku %}
                                        {% for option in prod.options %}
                                            {% if option.title == 'Цвет' %}
                                                {% for value in option.values %}
                                                    <span class="products-item__colors-item color">
                                                        <img data-src="{{ value.image_url | image_url: 32}}" alt="">
                                                    </span>
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </div> {% endcomment %}
                        </div>
                        <!--noindex-->
                        <div class="products-item__badges" 
                            {%- if product.properties.badge -%}data-badges-id="{%- for item in product.properties.badge.characteristics -%}{{- item.name -}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}"{%- endif -%}
                        >
                            {% for collection in product.collections %}
                                {% if collection.handle == "sale" and product.price < product.old_price %}
                                    <span class="badge-sale">
                                        <span>SUPER SALE</span>
                                        <span>{{- product.old_price | minus: product.price | divided_by: product.old_price | times: 100 | round: 0 -}}%</span>
                                    </span>
                                {% elsif collection.handle == "novinki" %}
                                    <span class="products-item__badge">Новинка</span>
                                {% endif %}
                            {% endfor %}
                            {% if product.properties.badge %}
                                <span class="products-item__badge _disabled-badge">Загрузка</span>
                            {% endif %} 
                        </div>
                        <!--/noindex-->
                    </div>
                </form>
            {% endfor %}
            {% endif %}
        </div>
    </div>
</section>
<!-- products-list end -->

<script type="text/template" data-template-id="widget-product">
    <form class="products-wrapper__item products-item"
        <%= available || isPreorder && !isSoon ? 'data-js="product-item"' : '' %>
        method="post" 
        data-cust-product-id="<%= product_id %>" data-article="<%= article %>">
        <div class="products-item__img-wrapper">
            <a href="<%= url %>" class="products-item__img">
                <% if (image) { %>
                    <img src="<%= image.replace('static.insales-cdn.com', 'ibicecdn.com/dumanstore') %>" alt="<%= title %>">
                <% } else { %>
                    <img src="{{ 'no_image.svg' | asset_url }}" alt="<%= title %>" class="image-none">
                <% } %>
            </a>
            
            <div class="products-item__actions">
                <button type="button" class="products-item__action products-item__action-whishlist" data-em-favorites-trigger="<%= product_id %>"></button>
                <% if (available || isPreorder && !isSoon) { %>
                    <button  type="button" 
                        class="products-item__action products-item__action-addcart<% if (values.length == 1 && Cart.order.getItemByID(values[0]?.id) !== undefined) { %> _active<% } %>" 
                        <% if (values.length > 1) { %>
                            data-js="product-item-addcard"
                            data-add-cart="<%= product_id %>"
                        <% } else { %>
                            data-btn-cart-add="<%= values[0]?.id %>"
                        <% } %>
                    ></button>
                <% } else { %>
                    <button type="button" class="products-item__action products-item__action-subscribe" 
                        data-popup="#popup-subscribe"
                    ></button>
                <% } %>
            </div>
            <% 
            var firstVariant = null;
            if (available || isPreorder && !isSoon) { %>
                <!--noindex-->
                <div class="products-item__sizes-wrapper" data-js="product-sizes-wrapper">
                    <button type="button" class="products-item__sizes-close" data-js="product-sizes-close"></button>
                    <div class="products-item__sizes-content">
                        <div class="products-item__sizes-title">Выберите размер</div>
                        <div class="products-item__sizes-list checkbox-list">
                            <% 
                            var note = "", count = 0;
                            values.forEach(function (value) {
                                if ((!value.available || value.quantity == 0) && (!isPreorder || isSoon != false)) return;

                                if (!firstVariant) {
                                    firstVariant = value;
                                }
                                if (value.quantity == 1) {
                                    note = [note, value.title].join(', ').trim();
                                    count++;
                                } %>
                                <div class="checkbox-list__item checkbox-btn">
                                    <label class="checkbox-btn__label">
                                        <input class="checkbox-btn__input" type="radio" value="<%= value.id %>" data-size-select name="<%= product_id %>">
                                        <div class="checkbox-btn__text-wrapper">
                                            <span class="checkbox-btn__text"><%= value.option_values[0]?.title ?? value.title %></span>
                                        </div>
                                    </label>
                                </div>
                            <% }); %>
                        </div>
                        <% if (count == 1) { %>
                            <div class="products-item__sizes-text"><%= note.substr(2) %> — последний размер</div>
                        <% } else if (count > 1) { %>
                            <div class="products-item__sizes-text"><%= note.substr(2) %> — последние размеры</div>
                        <% } %>
                        {% comment %}
                        <% if (urlNotAvailable) { %>
                            <div class="products-item__sizes-text">Товар закончился</div>
                            <a href="<%= urlNotAvailable %>" class="products-item__button btn btn_outline btn_small">Смотреть похожие</a>  
                        <% } %>
                        
                        <div class="products-item__sizes-bottom sizes__bottom-mob" hidden>
                            <button data-popup="#" type="button" class="products-item__sizes-table">
                                <span>Таблица размеров</span>
                            </button>
                        </div>
                        {% endcomment %}
                        <div class="product-item__sizes__buttons">
                            <button type="button" class="btn-icon btn-icon_medium btn-icon_secondary btn-icon_remove" data-size-remove hidden></button>
                            <button type="button" class="btn btn_medium btn_primary btn-item_added" data-size-cart-add disabled>
                                <span>Размер не выбран</span>
                            </button>
                        </div>
                    </div>
                    {% comment %}
                        <div class="products-item__sizes-bottom sizes__bottom-pc" hidden>
                            <button data-popup="#" type="button" class="products-item__sizes-table">
                                <span>Таблица размеров</span>
                            </button>
                        </div>
                    {% endcomment %}
                </div>
                <!--/noindex-->
            <% } %>
            <div class="products-item__sizes-filling" data-js="product-sizes-close"></div>
        </div>
        <div class="products-item__info">
            <a href="<%= url %>" class="products-item__title"><%= title %></a>
            <div class="products-item__properties">
                <div class="products-item__prices">
                    <% if (!available && isSoon) { %>
                        <div class="products-item__button btn btn_outline btn_small">
                            Скоро в продаже
                        </div>
                    <% } else { %>
                        <span class="products-item__price"><%= price %></span>
                    <% } %>
                </div>
                <div class="products-item__colors colors-list"
                    <% if (firstVariant && firstVariant?.id !== undefined) { %>
                        data-first-variant="<%= firstVariant.id %>" 
                        data-variant-sku="<%= article ?? '' %>"
                    <% } else if (article) { %>
                        data-first-variant="<%= values[0].id %>" 
                        data-variant-sku="<%= article %>"
                    <% } %>
                ></div>
            </div>
            <% if (available) { %>
                <!--noindex-->
                <div class="products-item__badges">
                    <% if (isBadgeSale && firstVariant && firstVariant.old_price !== null) { %>
                        <% 
                            const oldPrice = Number(firstVariant.old_price);
                            const price = Number(firstVariant.price);
                        %>
                        <% if (price < oldPrice) { %>
                            <span class="badge-sale">
                                <span>SUPER SALE</span>
                                <span><%= Math.floor( (oldPrice - price) / oldPrice * 100 ) %>%</span>
                            </span>
                        <% } %>
                    <% } %>
                    <%= badges %>
                </div>
                <!--/noindex-->
                
            <% } else if (isPreorder && !isSoon) { %>
                <!--noindex-->
                <div class="products-item__badges">
                    <span class="products-item__badge">Предзаказ</span>
                </div>
                <!--/noindex-->

            <% } else if (!isSoon) { %>
                <div class="products-item__product-ended">Товар закончился</div>
                <a href="<%= urlNotAvailable ?? '/collection/all' %>" class="products-item__button btn btn_outline btn_small">
                    <span>Смотреть похожие</span>
                    <span>Похожие</span>
                </a>
            <% } %>
        </div>
    </form>
</script>