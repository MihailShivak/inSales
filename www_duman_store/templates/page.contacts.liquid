<!--
  TESTING-1-2-3-TESTING
  Самые лучшие цены в Новосибирске.
  Для Новосибирска этот стиль очень подходит.
  Доступна доставка товаров в Новосибирск.
  Как же прекрасен город Новосибирск весной!
-->
{% comment %} upd {% endcomment %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hostname = window.location.hostname;
    const isNovosibirsk = hostname === 'www.duman.store' || hostname === 'duman.store';

    const blockNs = document.getElementById('address-novosibirsk');
    const blockOther = document.getElementById('address-other');
    const titleEl = document.getElementById('address-title');

    if (!blockNs || !blockOther) return;

    if (isNovosibirsk) {
      if (titleEl) titleEl.textContent = 'Вы можете найти нас по адресу:';
      blockNs.style.display = 'block';
      blockOther.style.display = 'none';
    } else {
      if (titleEl) titleEl.textContent = 'Технический офис:';
      blockNs.style.display = 'none';
      blockOther.style.display = 'block';
    }
  });
</script>
