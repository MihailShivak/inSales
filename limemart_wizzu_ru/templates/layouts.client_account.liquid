												<clipPath id="clip0_2_40">
												<rect width="100" height="100" fill="white" transform="translate(0.5)"/>
												</clipPath>
												</defs>
												</svg>
												{% comment %} <svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 38 38" fill="none">
												<rect width="38" height="38" rx="19" fill="#0DC143"/>
