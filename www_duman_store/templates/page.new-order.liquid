<section class="order">
    <div class="order__container order__container_alt">
        <form action="#" class="order__form" data-em-order onsubmit="return false;">
            <div class="order__head">
                <a href="/cart_items" class="order__link-back">Вернуться в корзину</a>
                {% unless client %}
                    <div class="order__note">
                        <div class="order__note-text">
                            <button type="button" class="order__note-link" data-popup="#popup-login">Авторизуйтесь</button>, 
                            чтобы получить 5% бонусных баллов с покупки
                        </div>
                    </div>
