<!DOCTYPE html>
<html
	class="{{ default_checkout2_layout_class }}"
	style="
		{% include "system_v4_required_styles" %}
	">
	<head>
		{% include "head" %}
	</head>
	<body class="adaptive" data-multi-lang="{{ language.not_default? }}">
		{% include "system_no_js_alert" %}
		<div class="page_layout page_layout-clear">
			<header>
				{% for widgetDrop in widget_lists.header-list.widgets %}
					{% widget widgetDrop %}
				{% endfor %}
			</header>
			<main>
				<div class="layout {% if template contains 'order2' %}_orders{% endif %}">
					<div class="layout__content">
						{% unless client %}
							{% if template != "order2" %}
								<div class="panel__top">
									<div class="panel__top-wrapper filter__back-wrapper">
										<a href="/" class="panel__top-back">
											<svg xmlns="http://www.w3.org/2000/svg" width="17" height="18" viewBox="0 0 17 18" fill="none">
											<path d="M11 3.5L6 9L11 14.5" stroke="#181818" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											</svg>
											<span>Главная</span>
										</a>
										<h1 class="title__large">Вход или регистрация</h1>
									</div>
								</div>
							{% endif %}
						{% elsif template != "order2" %}
							<div class="breadcrumbs breadcrumbs__client">
								 {% if template == "account.orders2" %}
									<a href="/" class="btn__bread-back">
										<svg xmlns="http://www.w3.org/2000/svg" width="17" height="18" viewBox="0 0 17 18" fill="none">
										<path d="M11 3.5L6 9L11 14.5" stroke="#797979" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
										<span>Главная</span>
									</a>
								{% else %}
									<a href="/client_account/orders" class="btn__bread-back">
										<svg xmlns="http://www.w3.org/2000/svg" width="17" height="18" viewBox="0 0 17 18" fill="none">
										<path d="M11 3.5L6 9L11 14.5" stroke="#797979" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
										<span>Назад</span>
									</a>
								{% endif %}
							</div>
							<div class="panel__top">
								<div class="panel__top-wrapper filter__back-wrapper">
									<a href="{%- if template == "account.orders2" -%}/{%- else -%}/client_account/orders{%- endif -%}" class="panel__top-back">
										<svg xmlns="http://www.w3.org/2000/svg" width="17" height="18" viewBox="0 0 17 18" fill="none">
										<path d="M11 3.5L6 9L11 14.5" stroke="#181818" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
										<span>{%- if template == "account.orders2" -%}Главная{%- else -%}Назад{%- endif -%}</span>
									</a>
									{% if template == "account.orders2" %}
										<h1 class="title__large orders__title">Личный кабинет</h1>
									{% elsif client and template != "order2" %}
										{% comment %} <div class="title__medium">{% yield 'title' %}</div> {% endcomment %}
										<h1 class="title__large orders__title">{% yield 'title' %}</h1>
									{% else %}
										<h1 class="title__large orders__title">Личный кабинет</h1>
									{% endif %}
								</div>
							</div>
							{% if template contains 'account.orders2' %}
								<div class="client__wrapper client__grid">
									<div class="client__grid-item">
										<div class="item__svg">
											<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28" fill="none">
											<path d="M13.9997 14.0011C17.2214 14.0011 19.8331 11.3895 19.8331 8.16781C19.8331 4.94615 17.2214 2.33447 13.9997 2.33447C10.7781 2.33447 8.16641 4.94615 8.16641 8.16781C8.16641 11.3895 10.7781 14.0011 13.9997 14.0011Z" stroke="#2394F0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											<path d="M24.0215 25.6667C24.0215 21.1517 19.5298 17.5 13.9998 17.5C8.46981 17.5 3.97815 21.1517 3.97815 25.6667" stroke="#2394F0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											</svg>
										</div>
										<div class="item__info">
											<div class="item__info-title">{{ client.full_name }}</div>
											<div class="item__info-descript">{{ client.phone }}</div>
											<a href="/client_account/exit" class="item__info-exit">Выход</a>
											<a href="/page/acccount_delete" class="item__info-remove">Удаление аккаунта</a>
										</div>
									</div>
									<a href="/client_account/addresses" class="client__grid-item _wrapper-img">
										<div class="item__info">
											<div class="item__info-subtitle">Адрес доставки</div>
										</div>
										<div class="item__img">
											<img src="{{ "acc_home.png" | asset_url  }}" alt="">
										</div>
									</a>
									<a href="/client_account/contacts" class="client__grid-item _wrapper-img">
										<div class="item__info">
											<div class="item__info-subtitle">Контактные данные</div>
										</div>
										<div class="item__img">
											<img src="{{ "acc_doc.png" | asset_url  }}" alt="">
										</div>
									</a>
									<a href="#" data-href-scroll="orders_list" class="client__grid-item _wrapper-img">
										<div class="item__info">
											<div class="item__info-subtitle">История заказов</div>
										</div>
										<div class="item__img">
											<img class="client__img-cart" src="{{ "icon-cart-blue.svg" | asset_url }}" alt="">
										</div>
									</a>
									<a href="/client_account/discounts" class="client__grid-item _wrapper-img _disabled">
										<div class="item__info">
											<div class="item__info-subtitle">Скидки и бонусы</div>
											<div class="item__info-message">Скоро появится</div>
										</div>
										<div class="item__img">
											<img src="{{ "acc_fire.png" | asset_url  }}" alt="">
										</div>
									</a>
									<a href="#" target="_blank" class="client__grid-item _wrapper-img" data-em-order-inform>
										<div class="item__info">
											<div class="item__info-subtitle">Служба поддержки</div>
										</div>
										<div class="item__img">
											<img src="{{ "acc_phone.png" | asset_url  }}" alt="">
										</div>
									</a>
									<div class="client__grid-item">
										<div class="item__info">
											<div class="item__info-subtitle">Мы в соц. сетях</div>
										</div>
										<div class="item__imgs">
											<a href="https://vk.com/id1068368508?utm_source=website&utm_medium=askme-icons&utm_campaign=own&utm_content=askme-icons&utm_term=vk-button" target="_blank">
