<script>
  (function () {
    var preloader = window.__preloader || {
      // Фолбэк на случай, если head.liquid по какой-то причине не выполнился
      showPage: function () {
        document.body.classList.add('settings_loaded');
      },
      isDone: function () { return false; }
    };

    // Ждём загрузки всех <link rel="stylesheet"> в DOM.
    // link.sheet становится не-null только после применения CSS.
    function waitForCSS() {
      if (preloader.isDone()) return;

      var links = Array.from(document.querySelectorAll('link[rel="stylesheet"]'));

      if (links.length === 0) {
        preloader.showPage();
        return;
      }

      const pending = links.filter((l) => !l.sheet);

      if (pending.length === 0) {
        preloader.showPage();
        return;
      }

      var remaining = pending.length;
      const onDone = () => {
        remaining--;
        if (remaining <= 0) preloader.showPage();
      };

      pending.forEach((link) => {
        link.addEventListener('load', onDone);
        link.addEventListener('error', onDone);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', waitForCSS);
    } else {
      waitForCSS();
    }
  })();
</script>