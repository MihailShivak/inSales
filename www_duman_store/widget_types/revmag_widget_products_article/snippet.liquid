                                c11.185-13.559,20.127-28.813,26.483-45.197L498.141,339.156z"/>
                              <path style="fill:#65DDB9;" d="M512,256c0.035,16.481-1.562,32.918-4.767,49.081l-85.539-22.599c2.71-17.311,2.71-34.948,0-52.259
                                l85.539-22.952C510.411,223.321,512.009,239.643,512,256z"/>
                              <path style="fill:#65DDB9;" d="M498.141,172.844l-85.628,22.952c-6.356-16.384-15.298-31.638-26.483-45.197l62.676-62.676
                                C470.563,112.737,487.362,141.586,498.141,172.844z"/>
                              <path style="fill:#65DDB9;" d="M423.724,62.941l-62.676,62.676c-13.559-11.185-28.813-20.127-45.197-26.483l22.952-85.628
                                C370.061,24.294,398.91,41.084,423.724,62.941z"/>
                            </g>
                            </svg>
                          </div>
                        {% endunless %}

                        {% assign img_title = product.title | escape %}
                        {% if product.variants[0].first_image.id.size > 0 %}
                          {% assign first_id = product.variants[0].first_image.id %}
                        {% else %}
                          {% assign first_id = product.first_image.id %}
                        {% endif %}

                        <a href="{{ product.url }}" {% if product.images.size > 1 %}class="js-prevent-images"{% endif %}>
                          <div class="hover-images">
                            {% for image in product.images %}
                              <div class="hover-image {% if first_id == image.id %}first-load{% endif %} {% if product.images.size == 1 %}one-image{% endif %}" data-image-id="{{ image.id }}">
                                <div></div>
                                <div>
                                  <picture>
                                    <source data-srcset="{{ image | image_url: 600, resizing_type: 'fit_width', format: 'webp' }}" type="image/webp" class="lazyload">
                                    <img data-src="{{ image | image_url: 600, resizing_type: 'fit_width' }}" alt="{{ product.title }}" title="{{ product.title }}" class="lazyload">
                                  </picture>
                                </div>
                              </div>
                            {% endfor %}
                          </div>
                        </a>
                      </div>

                      {% if product.images.size == 0 %}
                        <a href="{{ product.url }}"><img data-src="{{ 'no_image.jpg' | asset_url }}" alt="{{ product.image }}" class="lazyload" /></a>
                      {% endif %}
                    </div>
                  </div>

                  <div class="product-item_info js-preload-block">
                    {% if editor_mode? or widget_settings.hide-sku != true %}
                      <div class="product-item_sku">
                        <span data-product-card-sku="{&quot;skuLabel&quot;: &quot;{{ messages.label_article }}: &quot;}"><span class="sku-label">{{ messages.label_article }}: </span><span class="sku-value"></span></span>
                      </div>
                    {% endif %}

                    <div class="product-item_title">
                      <a class="link-hover-underline" href="{{ product.url }}">{{ product.title }}</a> 
                    </div>

                    {% if editor_mode? or widget_settings.hide-description != true %}
                      {% if widget_settings.product-desc-limit != "all" %}
                        {% assign preview_text = product.short_description | strip_html | truncatewords: widget_settings.product-desc-limit %}
                      {% else %}
                        {% assign preview_text = product.short_description %}
                      {% endif %}

                      <div>
                        {% if preview_text.size > 0 %}
                          <div class="product-item_description editor">
                            {{ preview_text }}
                          </div>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if editor_mode? or widget_settings.hide-rating != true %}
                      <div>
                        {% if product.reviews_count > 0 and account.reviews_enabled? %}
                          <div class="product-item_rating">
                            <div class="stars">
                              {% for i in (1..5) %}
                                <div>
                                  {% if i > product.rating %}
                                    {% include 'svg' with 'icon_star_empty' %}
                                  {% else %}
                                    {% include 'svg' with 'icon_star_full' %}
                                  {% endif %}
                                </div>
                              {% endfor %}
                            </div>
                            <div class="reviews">
                              <a href="{{ product.url }}#review_form">{{ messages.snippet_reviews }}: {{ product.reviews_count }}</a>
                            </div>
                          </div>
                        {% endif %}
                      </div>
                    {% endif %}

                    <div>
                      {% if product.show_variants? %}
                        {% if widget_settings.hide-variants != true or widget_settins.hide-variants-sm != true %}
                          <div class="product-item_variants product-preview__variants">
                            {% assign var_image = '' %}
                            {% if settings.rev_variants_image.size > 0 %}
                              {% assign var_images = settings.rev_variants_image | split: ', ' %}
                              {% assign var_image_size = var_images.size | minus: 1 %}
                              
                              {% for i in (0..var_image_size) %}
                                {% capture var_image %}{{ var_image }}"{{ var_images[i] }}":"option-preview",{% endcapture %}
                              {% endfor %}
                            {% endif %}
                            <select 
                              class="hide" 
                              name="variant_id" 
                              data-product-variants='{ {{ var_image }} "default": "option-span"}' 
                            >
                              {% for variant in product.variants %}
                                <option 
                                  value="{{ variant.id }}" 
                                  data-variant-image-id="{{ variant.first_image.id }}"
                                >{{ variant.title | escape }}</option>
                              {% endfor %}
                            </select>
                          </div>
                        {% else %}
                          <input type="hidden" name="variant_id" value="{{ product.variants.first.id }}" />
                        {% endif %}
                      {% else %}
                        <input type="hidden" name="variant_id" value="{{ product.variants.first.id }}" />
                      {% endif %}
                    </div>
                  </div>
                </div>

                <div class="product-item_bottom js-preload-block">
                  <div class="product-item_prices">
                    <div class="product-preview__price">
                      {% unless product.is_bundle %}
                        {% if widget_settings.hide-variants == true or widget_settings.hide-variants-sm == true %}
                          <span class="product-price product-preview__price-cur price_min">{% if product.price_varies? %}{{ messages.from }}{% endif %} {{ product.price_min | money }}</span>
                        {% endif %}
                      {% endunless %}
                      <span class="product-price product-preview__price-cur" data-product-card-price-from-cart></span>
                      <span class="product-old_price product-preview__price-old" data-product-card-old-price></span>
                    </div>
                  </div> 

                  <div class="product-item_buy">
                    {% if settings.product_not_available == 'preorder' %}
                      <button data-product-card-preorder class="button button_wide preorder_bttn" type="button">{{messages.pre_order}}</button>
                    {% elsif settings.product_not_available == 'hidden' %}
                      <div class="js-available-container is-hidden">
                        <div>
                          <div>
                            {% include 'svg' with 'icon_not_available' %}
                          </div>
                          <span data-product-card-available='{ "availableText": "{{ messages.available }}", "notAvailableText": "{{ messages.not_available }}" }'></span> 
                        </div>
                      </div>
                    {% endif %}

                    <div>
                      <input type="hidden" name="quantity" value="1" />

                      {% if widget_settings.hide-variants == true or widget_settings.hide-variants-sm == true %}
                        <div class="show-more">
                          <a class="button" href="{{ product.url }}">{{ widget_messages.detail_btn_text }}</a>
                        </div>
                      {% endif %}

                      {% if settings.rev_product_buttons == 'standart' %}
                        <div class="add-cart-counter" data-add-cart-counter='{"step": "1"}'>
                          <button type="button" class="button button_wide add-cart-counter__btn" data-add-cart-counter-btn>
                            <svg fill="currentColor" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 489 489" style="enable-background:new 0 0 489 489;" xml:space="preserve"><g><path d="M440.1,422.7l-28-315.3c-0.6-7-6.5-12.3-13.4-12.3h-57.6C340.3,42.5,297.3,0,244.5,0s-95.8,42.5-96.6,95.1H90.3 c-7,0-12.8,5.3-13.4,12.3l-28,315.3c0,0.4-0.1,0.8-0.1,1.2c0,35.9,32.9,65.1,73.4,65.1h244.6c40.5,0,73.4-29.2,73.4-65.1 C440.2,423.5,440.2,423.1,440.1,422.7z M244.5,27c37.9,0,68.8,30.4,69.6,68.1H174.9C175.7,57.4,206.6,27,244.5,27z M366.8,462 H122.2c-25.4,0-46-16.8-46.4-37.5l26.8-302.3h45.2v41c0,7.5,6,13.5,13.5,13.5s13.5-6,13.5-13.5v-41h139.3v41 c0,7.5,6,13.5,13.5,13.5s13.5-6,13.5-13.5v-41h45.2l26.9,302.3C412.8,445.2,392.1,462,366.8,462z"/></g></svg> 
                            <span>{{ widget_messages.add_to_cart }}</span>
                          </button>

                          <div class="add-cart-counter__controls">
                            <button data-add-cart-counter-minus class="button add-cart-counter__controls-btn" type="button">-</button>
                            <a href="{{ settings.rev_product_redirect }}" class="button button_wide add-cart-counter__detail">
                              <span class="add-cart-counter__detail-text">{{ messages.btn_buy_active_text }} <span data-add-cart-counter-count></span> {{ product.unit }}</span>
                              <span class="add-cart-counter__detail-dop-text">{{ messages.btn_buy_active_detail }}</span>
                            </a>
                            <button data-add-cart-counter-plus class="button add-cart-counter__controls-btn" type="button">+</button>
                          </div>
                        </div>
                      {% else %}
                        <button class="button" data-item-add>
                          <svg fill="currentColor" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 489 489" style="enable-background:new 0 0 489 489;" xml:space="preserve"><g><path d="M440.1,422.7l-28-315.3c-0.6-7-6.5-12.3-13.4-12.3h-57.6C340.3,42.5,297.3,0,244.5,0s-95.8,42.5-96.6,95.1H90.3 c-7,0-12.8,5.3-13.4,12.3l-28,315.3c0,0.4-0.1,0.8-0.1,1.2c0,35.9,32.9,65.1,73.4,65.1h244.6c40.5,0,73.4-29.2,73.4-65.1 C440.2,423.5,440.2,423.1,440.1,422.7z M244.5,27c37.9,0,68.8,30.4,69.6,68.1H174.9C175.7,57.4,206.6,27,244.5,27z M366.8,462 H122.2c-25.4,0-46-16.8-46.4-37.5l26.8-302.3h45.2v41c0,7.5,6,13.5,13.5,13.5s13.5-6,13.5-13.5v-41h139.3v41 c0,7.5,6,13.5,13.5,13.5s13.5-6,13.5-13.5v-41h45.2l26.9,302.3C412.8,445.2,392.1,462,366.8,462z"/></g></svg>
                          <span>{{ widget_messages.add_to_cart }}</span>
                        </button>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}
{% assign preview_text = null %}