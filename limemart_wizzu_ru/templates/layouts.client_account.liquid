												</svg>
											</a>
										</div>
									</div>
								</div>
							{% endif %}
						{% endunless %}
						{% yield %}
						{% comment %} Старый код 
						<div class='checkout-v2-wrapper co-section--content_wrapper'>
							{% if client %}
								{% yield 'menu' %}
							{% endif %}
							<div class='co-section--content'>
								<div class='co-section--checkout_header co-checkout-block--padded'>
								<h1 class='co-checkout-title co-title co-title--h1'>
									{% yield 'title' %}
								</h1>
								</div>
								{% yield %}
							</div>
						</div>
						{% endcomment %}
					</div>
				</div>
			</main>
			<footer>
				{% for widgetDrop in widget_lists.footer-list.widgets %}
					{% widget widgetDrop %}
				{% endfor %}
			</footer>
		</div>
		<div class="outside-widgets">
			{% for widgetDrop in widget_lists.outside-list.widgets %}
				{% widget widgetDrop %}
			{% endfor %}
		</div>
	</body>
  {{ 'checkout2.core' | global_stylesheet_tag }}

  {%- capture css_js_lists -%}header-list, footer-list, sidebar-list, outside-list, {{ template }}-list, {{ template }}-section_top-list, {{ template }}-section_bottom-list{%- endcapture -%}

  {% if sidebar_show %}
    {% if template contains 'blog' or template contains 'article' %}
        {% assign css_js_lists = css_js_lists | append: ', sidebar_blog-list' %}
    {% else %}
        {% assign css_js_lists = css_js_lists | append: ', sidebar-list' %}
    {% endif %}
  {% endif %}

	<script>
		// Костыль, чтоб сменить стандартные заголовки в форме аторизации
		document.addEventListener("DOMContentLoaded", function() {
			if (window.location.pathname.includes("/client_account/session/new")) {
				const label = document.querySelector("form.co-form--login .co-input-label[for='email']");
				if (label) {
					label.innerText = "E-mail";
				}
			}
		});
	</script>

  {% widgets_assets css_js_lists %}

  {% include "styles" %}
  <link href="{{ 'em_login.css' | asset_url }}" rel="stylesheet" type="text/css" />
  <script src="{{ 'emilius_modules.js' | asset_url }}" charset="utf-8"></script>
  <script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU&apikey=82b416d9-91cb-4d67-a85c-4a66bbeeb85b&suggest_apikey=376c749f-7294-4a03-bd1e-89660416807e" type="text/javascript"></script>

</html>
