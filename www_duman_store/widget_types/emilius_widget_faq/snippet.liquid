{% capture cache_key_faq %}{{upd_cache}}_key_faq_{{ widget_settings.updated_at }}_{{ language.locale }}_{{ collection.handle }}{% endcapture %}
{% cache cache_key_faq %}
{% if data.blocks.size > 0 %}
<!-- 
{% help data.blocks %}
  -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign first_faq = true -%}

          {%- for block in data.blocks -%}
            {%- assign pass_current_collection = false -%}

            {%- if block.collection.handle == collection.handle -%}
              {%- assign pass_current_collection = true -%}
            {%- endif -%}

            {%- if collection.handle == "all" -%}
              {%- assign pass_current_collection = true -%}
            {%- endif -%}

            {%- if pass_current_collection -%}
              {%- unless first_faq -%},{%- endunless -%}
              {
                "@type": "Question",
                "name": {{ block.question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.answer | strip_html | json }}
                }
              }
              {%- assign first_faq = false -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
    <script id="faq-data" type="application/json">
        [{% for block in data.blocks %}{"question":"{{ block.question | escape }}","answer":"{{ block.answer | strip_html | escape }}","collection":"{{ block.collection.handle | escape }}"}{% unless forloop.last %},{% endunless %}{% endfor %}]
    </script>
{% endif %}
{% endcache %}
<div class="faq__container catalog__seo" hidden>
    <h2 class="block__faq-title">Часто задаваемые вопросы</h2>
    <div class="block__faq-wrapper" data-spollers></div>
</div>

{% comment %} upd {% endcomment %}