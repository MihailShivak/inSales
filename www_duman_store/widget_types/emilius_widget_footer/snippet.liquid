{% capture footer_time %}{{'now' | date: '%s.%L' }}{% endcapture %}

{% if isOrder %}
<footer class="footer footer_order">
    <div class="footer__container footer__container_alt">
        <div class="footer__body">
            <div class="footer__bottom">
                <div class="footer__copyright">
                    <span>© {{ 'now' | date: "%Y" }} Duman</span>
                </div>
                <div class="footer__links-list">
                    {% for link in linklists[widget_settings['customer-menu-3']].links %}
                        <a href="{{ link.url }}" class="footer__links-item">{{ link.title }}</a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</footer>

{% else %}

<footer class="footer">
    <div class="footer__container">
        <div class="footer__body {% if template == "cart" or template == "product" %}_footer-mob{% endif %}">
            <div class="footer__grid">
                <div class="footer__col">
                    <div class="footer__logo-wrapper">
                        {% if widget_settings.logo-img %}
                            <a href="/" class="footer__logo"><img src="{{ widget_settings.logo-img }}" alt="Логотип duman."></a>
                        {% endif %}
                        <div class="footer__logo-text">
                            {{ widget_settings.logo-text }}
                        </div>
                    </div>
                    <div class="footer__socials">
                        {% for link in linklists[widget_settings['social-links']].links %}
                            <a href="{{ link.url }}" class="footer__socials-item" target="_blank">{{ link.title }}</a>
                        {% endfor %}
                    </div>
