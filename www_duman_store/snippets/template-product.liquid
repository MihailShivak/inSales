{% capture cache_key_badges %}{{upd_cache}}_badges_{{ block_lists.list-badges.updated_at }}_{{ language.locale }}{% endcapture %}
{% cache cache_key_badges %}
<script id="badges-data" type="application/ld+json">
    [
        {%- for badge in block_lists.list-badges.blocks -%}
            {
                "title": "{{- badge.name -}}",
                "color": "{{- badge.color -}}",
                "background": "{{- badge.background -}}"

            }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
    ]
</script>
{% endcache %}

<script type="text/template" data-template-id="item-slider">
    <% 
        const article = product.variants[0].sku;
        const link = !product.available && !isPreorder && !isSoon ? 
            (urlNotAvailable ? urlNotAvailable : '/collection/all') : 
            product.url;
        var firstVariant = null;
    %>
    <form class="products-slider__slide products-item swiper-slide"    
        <%= product.available || isPreorder && !isSoon ? 'data-js="product-item"' : '' %>
        method="post" 
        data-cust-product-id="<%= product.id %>"
    >
        <div class="products-item__img-wrapper">
            <a href="<%= link %>" class="products-item__img">
                <% if (image) { %>
                    <picture>
                        <source srcset="<%= image.x1 %> 1x, <%= image.x2 %> 2x" type="image/webp">
                        <img src="<%= image.x2 %>" alt="<%= product.title %>" class="entered">
                    </picture>
                <% } else { %>
                    <img src="{{ 'no_image.svg' | asset_url }}" alt="<%= product.title %>" class="image-none entered">
                <% } %>
            </a>
            <div class="products-item__actions">
                <button type="button" 
                    class="products-item__action products-item__action-whishlist" 
                    data-em-favorites-trigger="<%= product.id %>">
                </button>
                <% if (product.available || isPreorder && !isSoon) { %>
                    <button type="button" 
                        class="products-item__action products-item__action-addcart"
                        <% if (product.variants.length > 1) { %>
                            data-js="product-item-addcard" 
                            data-add-cart="<%= product.id %>"
                        <% } else { %>
                            data-btn-cart-add="<%= product.variants[0]?.id %>"
                        <% } %>
                    ></button>
                <% } else { %>
                    <button type="button" class="products-item__action products-item__action-subscribe" 
                        data-popup="#popup-subscribe"
                    ></button>
                <% } %>
            </div>
            <% if (product.available || isPreorder && !isSoon) { %>
                <!--noindex-->
                <div class="products-item__sizes-wrapper" data-js="product-sizes-wrapper">
                    <button type="button" class="products-item__sizes-close" data-js="product-sizes-close"></button>
                    <div class="products-item__sizes-content">
                        <div class="products-item__sizes-title">Выберите размер</div>
                        <div class="products-item__sizes-list checkbox-list">
                            <% 
                            var note = "", count = 0;
                            product.variants.forEach(function (value) {
                                if ((!value.available || value.quantity == 0) && (!isPreorder || isSoon != false)) return;
                                if (!firstVariant) {
                                    firstVariant = value;
                                }
                                if (value.quantity == 1) {
                                    note = [note, value.title].join(', ').trim();
                                    count++;
                                } %>
                                <div class="checkbox-list__item checkbox-btn">
                                    <label class="checkbox-btn__label">
                                        <input class="checkbox-btn__input" type="radio" value="<%= value.id %>" data-size-select name="<%= product.id %>">
                                        <div class="checkbox-btn__text-wrapper">
                                            <span class="checkbox-btn__text"><%= value.option_values[0]?.title ?? value.title %></span>
                                        </div>
                                    </label>
                                </div>
                            <% }); %>
                        </div>
                        <% if (count == 1) { %>
                            <div class="products-item__sizes-text"><%= note.substr(2) %> — последний размер</div>
                        <% } else if (count > 1) { %>
                            <div class="products-item__sizes-text"><%= note.substr(2) %> — последние размеры</div>
                        <% } %>
                        {% comment %}
                        <div class="products-item__sizes-bottom sizes__bottom-mob" hidden>
                            <button data-popup="#" type="button" class="products-item__sizes-table">
                                <span>Таблица размеров</span>
                            </button>
                        </div>
                        {% endcomment %}
                        <div class="product-item__sizes__buttons">
                            <button type="button" class="btn-icon btn-icon_medium btn-icon_secondary btn-icon_remove" data-size-remove hidden></button>
                            <button type="button" class="btn btn_medium btn_primary btn-item_added" data-size-cart-add disabled>
                                <span>Размер не выбран</span>
                            </button>
                        </div>
                    </div>
                    {% comment %}
                    <div class="products-item__sizes-bottom sizes__bottom-pc">
                        <button data-popup="#" type="button" class="products-item__sizes-table">
                            <span>Таблица размеров</span>
                        </button>
                    </div>
                    {% endcomment %}
                </div>
                <!--/noindex-->
            <% } %>
            <div class="products-item__sizes-filling" data-js="product-sizes-close"></div>
        </div>
        <div class="products-item__info">
            <a href="<%= link %>" class="products-item__title"><%= product.title %></a>
            <div class="products-item__properties">
                <div class="products-item__prices">
                    <% if (!product.available && isSoon) { %>
                        <div class="products-item__button btn btn_outline btn_small">
                            Скоро в продаже
                        </div>
                    <% } else {
                        const oldPrice = Number(firstVariant?.old_price);
                        const price = Number(firstVariant.price);
                        
                        if (!isNaN(oldPrice) && price < oldPrice) { %>
                            <span class="products-item__price products-item__price_new"><%= Shop.money.format(price) %></span>
                            <span class="products-item__price products-item__price_old"><%= Shop.money.format(oldPrice) %></span>
                        <% } else { %>
                            <span class="products-item__price"><%= Shop.money.format(product.price ?? product.price_min) %></span>
                        <% }
                    } %>
                </div>
                <div class="products-item__colors colors-list"
                    <% if (firstVariant && firstVariant?.id !== undefined) { %>
                        data-first-variant="<%= firstVariant.id %>" 
                        data-variant-sku="<%= article ?? '' %>"
                    <% } else if (article) { %>
                        data-first-variant="<%= product.variants[0].id %>" 
                        data-variant-sku="<%= article %>"
                    <% } %>
                ></div>
            </div>
            <% if (product.available) { %>
                <!--noindex-->
                <div class="products-item__badges">
                    <% if (product.url.includes("/sale") && firstVariant && firstVariant.old_price) {
                        if (!isNaN(oldPrice) && price < oldPrice) { %>
                            <span class="badge-sale">
                                <span>SUPER SALE</span>
                                <span><%= Math.floor( (oldPrice - price) / oldPrice * 100 ) %>%</span>
                            </span>
                        <% }
                    }
                    if (product.url.includes("/novinki")) { %>
                        <span class="products-item__badge">Новинка</span>
                    <% } %>
                    <%= badgesHTML %>
                </div>
                <!--/noindex-->
            <% } else if (isPreorder && !isSoon) { %>
                <!--noindex-->
                <div class="products-item__badges">
                    <span class="products-item__badge">Предзаказ</span>
                </div>
                <!--/noindex-->
            <% } else if (!isSoon) { %>
                <!--noindex-->
                <div class="products-item__product-ended">Товар закончился</div>
                <a href="<%= urlNotAvailable ? urlNotAvailable : '/collection/all' %>" class="products-item__button btn btn_outline btn_small">
                    <span>Смотреть похожие</span>
                    <span>Похожие</span>
                </a>
                <!--/noindex-->
            <% } %>
        </div>
    </form>
</script>

{% comment %} ! Шаблон Блока товара {% endcomment %}
<script type="text/template" data-template-id="product-item">
    <%
        const link = !available && !isPreorder && !isSoon ? 
            (urlNotAvailable ? urlNotAvailable : '/collection/all') : 
            product.url;
    %>
    <form class="catalog__list-item products-item" 
        <%= available || isPreorder && !isSoon ? 'data-js="product-item"' : '' %>
        method="post" 
        data-cust-product-id="<%= product.product_id %>" data-article="<%= article %>"
    >
        <div class="products-item__img-wrapper">
            <a href="<%= link %>" class="products-item__img">
                <div class="products-item__img-list">
                    <% if (images && images.length) { %>
                        <% for (const image of images) { %>
                            <div>
                                <picture>
                                    <source srcset="<%= image.x1 %> 1x, <%= image.x2 %> 2x" type="image/webp">
                                    <img src="<%= image.x2 %>" alt="<%= product.title %>" class="entered _lazy-loaded" loading="lazy">
                                </picture>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div>
                            <img src="{{ 'no_image.svg' | asset_url }}" alt="<%= product.title %>" class="image-none entered loading" loading="lazy">
                        </div>
                    <% } %>
                </div>
                <div class="products-item__sections"></div>
            </a>
            <div class="products-item__actions">
                <button type="button" 
                    class="products-item__action products-item__action-whishlist <%= wishlistAdded ? ' favorites-added' : '' %>" 
                    data-em-favorites-trigger="<%= product.product_id %>">
                </button>
                <% if (available || isPreorder && !isSoon) { %>
                    <button type="button" 
                        class="products-item__action products-item__action-addcart<% if (product.variants.length == 1 && Cart.order.getItemByID(product.variants[0]?.id) !== undefined) { %> _active<% } %>" 
                        <% if (product.variants.length > 1) { %>
                            data-js="product-item-addcard" 
                            data-add-cart="<%= product.product_id %>"
                        <% } else { %>
                            data-btn-cart-add="<%= product.variants[0]?.id %>"
                        <% } %>
                    ></button>
                <% } else { %>
                    <button type="button" class="products-item__action products-item__action-subscribe" 
                        data-popup="#popup-subscribe"
                    ></button>
                <% } %>
            </div>
            <% 
            var firstVariant = null;
            if (available || isPreorder && !isSoon) { %>
                <!--noindex-->
                <div class="products-item__sizes-wrapper" data-js="product-sizes-wrapper">
                    <button type="button" class="products-item__sizes-close" data-js="product-sizes-close"></button>
                    <div class="products-item__sizes-content">
                        <div class="products-item__sizes-title">Выберите размер</div>
                        <div class="products-item__sizes-list checkbox-list">
                            <% 
                            var note = "", count = 0;
                            product.variants.forEach(function (variant) {
                                if ((!variant.available || variant.quantity == 0) && (!isPreorder || isSoon != false)) return;
                                if (!firstVariant) {
                                    firstVariant = variant;
                                }
                                if (variant.quantity == 1) {
                                    note = [note, variant.title].join(', ').trim();
                                    count++;
                                } %>
                                <div class="checkbox-list__item checkbox-btn">
                                    <label class="checkbox-btn__label">
                                        <input class="checkbox-btn__input" type="radio" value="<%= variant.id %>" data-size-select name="<%= product.product_id %>">
                                        <div class="checkbox-btn__text-wrapper">
                                            <span class="checkbox-btn__text">
                                                <%= variant?.characteristics && variant.characteristics?.full[1607434]?.length && variant.characteristics.full[1607434][0].value?.name ? 
                                                    variant.characteristics.full[1607434][0].value.name : 
                                                    variant.title.replace(product.title, "") %>
                                            </span>
                                        </div>
                                    </label>
                                </div>
                            <% }); %>
                        </div>
                        <% if (count == 1) { %>
                            <div class="products-item__sizes-text"><%= note.substr(2) %> — последний размер</div>
                        <% } else if (count > 1) { %>
                            <div class="products-item__sizes-text"><%= note.substr(2) %> — последние размеры</div>
                        <% } %>
                        <div class="product-item__sizes__buttons">
                            <button type="button" class="btn-icon btn-icon_medium btn-icon_secondary btn-icon_remove" data-size-remove hidden></button>
                            <button type="button" class="btn btn_medium btn_primary btn-item_added" data-size-cart-add disabled>
                                <span>Размер не выбран</span>
                            </button>
                        </div>
                    </div>
                </div>
                <!--/noindex-->
            <% } %>
            <div class="products-item__sizes-filling" data-js="product-sizes-close"></div>
            <ul class="catalog__dots"></ul>
        </div>
        <div class="products-item__info">
            <a href="<%= link %>" class="products-item__title"><%= product.title %></a>
            <div class="products-item__properties">
                <div class="products-item__prices">
                    <% if (!available && isSoon) { %>
                        <div class="products-item__button btn btn_outline btn_small">
                            Скоро в продаже
                        </div>
                    <% } else {
                        const oldPrice = Number(firstVariant?.old_price);
                        const price = Number(firstVariant?.price);
                        
                        if (!isNaN(oldPrice) && !isNaN(price) && price < oldPrice) { %>
                            <span class="products-item__price products-item__price_new"><%= Shop.money.format(price) %></span>
                            <span class="products-item__price products-item__price_old"><%= Shop.money.format(oldPrice) %></span>
                        <% } else { %>
                            <span class="products-item__price"><%= Shop.money.format(firstVariant?.price ?? product.price) %></span>
                        <% }
                    } %>
                </div>
                <div class="products-item__colors colors-list"
                    <% if (firstVariant && firstVariant?.id !== undefined) { %>
                        data-first-variant="<%= firstVariant.id %>" 
                        data-variant-sku="<%= article ?? '' %>"
                    <% } else if (article) { %>
                        data-first-variant="<%= values[0].id %>" 
                        data-variant-sku="<%= article %>"
                    <% } %>
                ></div>
            </div>
            <% if (available) { %>
                <!--noindex-->
                <div class="products-item__badges">
                    <% if (isBadgeSale && firstVariant && firstVariant?.old_price) { %>
                        <% 
                            const oldPrice = Number(firstVariant.old_price);
                            const price = Number(firstVariant?.price ?? product.price);
                        %>
                        <% if (price < oldPrice) { %>
                            <span class="badge-sale">
                                <span>SUPER SALE</span>
                                <span><%= Math.floor( (oldPrice - price) / oldPrice * 100 ) %>%</span>
                            </span>
                        <% } %>
                    <% } %>
                    <%= badgesHTML %>
                </div>
                <!--/noindex-->

            <% } else if (isPreorder && !isSoon) { %>
                <!--noindex-->
                <div class="products-item__badges">
                    <span class="products-item__badge">Предзаказ</span>
                </div>
                <!--/noindex-->

            <% } else if (!isSoon) { %>
                <div class="products-item__product-ended">Товар закончился</div>
                <a href="<%= urlNotAvailable ? urlNotAvailable : '/collection/all' %>" class="products-item__button btn btn_outline btn_small">
                    <span>Смотреть похожие</span>
                    <span>Похожие</span>
                </a>
            <% } %>
        </div>
    </form>
</script>