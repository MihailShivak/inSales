{% comment %} {% capture cache_key_faq %}{{upd_cache}}_key_faq_{{ widget_settings.updated_at }}_{{ block_lists.em-faq-catalog.updated_at }}_{{ language.locale }}{% endcapture %}
{% cache cache_key_faq %}


{% if block_lists.em-faq-catalog.blocks.size > 0 %}
  <!-- 
  help data.blocks
    -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in block_lists.em-faq-catalog.blocks -%}
              {
                "@type": "Question",
                "name": {{- block.question | json -}},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{- block.answer | strip_html | json -}}
                }
              }
              {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
    <script id="faq-data" type="application/json">
      [
        {%- for block in block_lists.em-faq-catalog.blocks -%}{"question":"{{- block.question | escape -}}","answer":"{{- block.answer | strip_html | escape  -}}","collection":"{{- block.collection.handle | escape -}}"}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
      ]
    </script>
{% endif %}
{% endcache %} {% endcomment %}


{% comment %} {% for faq in block_lists.em-faq-catalog.block %}
	{% assign faq_name_key = faq.collection.handle %}
	{% capture faq_name_key %}{{ faq_name_key}}-{{ faq.question }}-{% endcapture %}
{%- endfor -%}

{% assign faq_name_key2 = collection.handle %}
<script>
    console.warn("TEST", '{{ platya }}', '{{ collection.handle }}');
</script> {% endcomment %}

