{% capture header_time %}{{'now' | date: '%s.%L' }}{% endcapture %}
<div id="collectionID" data-collection-handle="{{ collection.handle }}" hidden></div>
{% if isOrder %}
  <header class="header header_order" data-lp="">
    <div class="header__wrapper">
      <div class="header__container header__container_alt">
        <div class="header__body">
          <a href="/" class="header__logo"><img src="{{ widget_settings.logo-img }}" alt="Логотип duman."></a>
          <div class="header__socials">
            <a
              href="{{ widget_settings.order_url_1 }}"
              class="header__social-item header__social-item_wa"
              target="_blank"
            ></a>
            <a
              href="{{ widget_settings.order_url_2 }}"
              class="header__social-item header__social-item_tg"
              target="_blank"
            ></a>
          </div>
        </div>
      </div>
    </div>
  </header>
{% else %}
  {% capture cache_key_header %}{{upd_cache}}_header_{{ widget_settings.updated_at }}_{{ language.locale }}{% endcapture %}
  <header class="header" data-lp>
    <div class="header__wrapper {% if template == "index" %}_header-not-white{%- endif -%}">
      {% cache cache_key_header %}
      {% if widget_settings.show_timer_bf %}
        <script id="promo-data" type="application/ld+json" hidden>
          {
            "discount": "{{- widget_settings.discount_size -}}",
            "dataStart": "{{- widget_settings.promo_date_start -}}",
            "dataEnd": "{{- widget_settings.promo_date_end -}}",
            "offset": "{{- widget_settings.offset_count -}}"
          }
        </script>
        <div class="header__notice header__bf-timer" id="headerBFTimer" hidden>
          <div class="header__promo-info">
            <div class="header__promo-row">
              <div class="header__promo-title">Вещей по акции: <span data-promo-count>0</span></div>
            </div>
            <div
              class="promo__info-container"
              {% if widget_settings.hide_timer_bf %}
                hidden
              {% endif %}
            >
              <div class="promo__info-animate">
                <div class="promo__info-wrapper">
                  <div class="header__promo-row promo__line">
                    <div class="header__promo-title">
                      Последние дни скидок: <span>{{ widget_settings.discount_size }}%</span>
                    </div>
                  </div>
                  <div class="header__promo-row promo__line">
                    <div class="header__promo-title">
                      До окончания акции: <span data-promo-day>0</span> дн, <span data-promo-hour>0</span> ч и
                      <span data-promo-minute>0</span> мин
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="header__promo-title header__promo-notfound"
              data-promo-disabled
              {% unless widget_settings.hide_timer_bf %}
                hidden
              {% endunless %}
            >
              {{ widget_settings.promotion_hide_title }}
            </div>
          </div>
          {% comment %}
            <div class="header__promo-close" data-close-promo>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M12.9947 2.32343C12.8185 2.32759 12.6512 2.40132 12.5292 2.52851L8.00055 7.05715L3.4719 2.52851C3.4097 2.46457 3.33529 2.41376 3.2531 2.37909C3.17091 2.34442 3.08259 2.3266 2.99338 2.32668C2.86082 2.32685 2.73131 2.36653 2.6214 2.44065C2.5115 2.51478 2.42618 2.61998 2.37636 2.74283C2.32653 2.86568 2.31446 3.00059 2.34169 3.13033C2.36891 3.26007 2.43419 3.37875 2.52919 3.47121L7.05784 7.99986L2.52919 12.5285C2.46521 12.5899 2.41413 12.6635 2.37894 12.7449C2.34375 12.8264 2.32516 12.914 2.32425 13.0027C2.32335 13.0914 2.34015 13.1793 2.37368 13.2615C2.40721 13.3436 2.45678 13.4182 2.5195 13.4809C2.58222 13.5436 2.65682 13.5932 2.73894 13.6267C2.82106 13.6603 2.90904 13.6771 2.99774 13.6762C3.08643 13.6753 3.17405 13.6567 3.25547 13.6215C3.33689 13.5863 3.41047 13.5352 3.4719 13.4712L8.00055 8.94257L12.5292 13.4712C12.5906 13.5352 12.6642 13.5863 12.7456 13.6215C12.827 13.6567 12.9147 13.6753 13.0034 13.6762C13.092 13.6771 13.18 13.6603 13.2622 13.6267C13.3443 13.5932 13.4189 13.5436 13.4816 13.4809C13.5443 13.4182 13.5939 13.3436 13.6274 13.2615C13.6609 13.1793 13.6777 13.0914 13.6768 13.0027C13.6759 12.914 13.6573 12.8264 13.6222 12.7449C13.587 12.6635 13.5359 12.5899 13.4719 12.5285L8.94325 7.99986L13.4719 3.47121C13.5689 3.37819 13.6355 3.25802 13.6631 3.12647C13.6906 2.99491 13.6777 2.85811 13.6261 2.73401C13.5745 2.60991 13.4866 2.5043 13.3739 2.43103C13.2612 2.35776 13.1291 2.32025 12.9947 2.32343Z"
                        fill="white" />
                </svg>
            </div>
          {% endcomment %}
        </div>

        {% comment %} Статичная акция (под sale) {% endcomment %}
      {% elsif widget_settings.show_timer_sale %}
        <script id="promo-data-sale" type="application/ld+json" hidden>
          {
            "enableBanner": "{{- widget_settings.show_banner_sale -}}",
            "dataEnd": "{{- widget_settings.promotion_date -}}"
          }
        </script>
        <div
          class="header__notice header__notice-timer"
          id="headerSaleTimer"
          style="background-color: {{ widget_settings.promotion_bg_color | default: '#000' }};"
          hidden
        >
          <div class="header__promo-info">
            <div class="header__promo-row">
              {% if widget_settings.promotion_link %}
                <a
                  href="{{ widget_settings.promotion_link }}"
                  class="header__promo-title"
                  style="color: {{ widget_settings.promotion_text_color | default: '#fff' }};"
                >
                  {{- widget_settings.promotion_title -}}
                </a>
              {% else %}
                <div
                  class="header__promo-title"
                  style="color: {{ widget_settings.promotion_text_color | default: '#ffffff' }};"
                >
                  {{ widget_settings.promotion_title }}
                </div>
              {% endif %}
            </div>
            <div class="promo__info-container">
              <div class="promo__info-animate">
                <div class="promo__info-wrapper">
                  <div class="header__promo-row promo__line">
                    <div
                      class="header__promo-title"
                      style="color: {{ widget_settings.promotion_text_color | default: '#ffffff' }};"
                    >
                      До окончания акции:
                      <span class="timer-days">
                        <span data-promo-day>0</span> дн, <span data-promo-hour>0</span> ч,
                        <span data-promo-minute>0</span> мин
                      </span>
                      <span class="timer-seconds" hidden>
                        <span data-promo-hour>0</span> ч, <span data-promo-minute>0</span> мин,
                        <span data-promo-second>0</span> сек
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% comment %}
            <div class="header__promo-close" data-close-promo2>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.9947 2.32343C12.8185 2.32759 12.6512 2.40132 12.5292 2.52851L8.00055 7.05715L3.4719 2.52851C3.4097 2.46457 3.33529 2.41376 3.2531 2.37909C3.17091 2.34442 3.08259 2.3266 2.99338 2.32668C2.86082 2.32685 2.73131 2.36653 2.6214 2.44065C2.5115 2.51478 2.42618 2.61998 2.37636 2.74283C2.32653 2.86568 2.31446 3.00059 2.34169 3.13033C2.36891 3.26007 2.43419 3.37875 2.52919 3.47121L7.05784 7.99986L2.52919 12.5285C2.46521 12.5899 2.41413 12.6635 2.37894 12.7449C2.34375 12.8264 2.32516 12.914 2.32425 13.0027C2.32335 13.0914 2.34015 13.1793 2.37368 13.2615C2.40721 13.3436 2.45678 13.4182 2.5195 13.4809C2.58222 13.5436 2.65682 13.5932 2.73894 13.6267C2.82106 13.6603 2.90904 13.6771 2.99774 13.6762C3.08643 13.6753 3.17405 13.6567 3.25547 13.6215C3.33689 13.5863 3.41047 13.5352 3.4719 13.4712L8.00055 8.94257L12.5292 13.4712C12.5906 13.5352 12.6642 13.5863 12.7456 13.6215C12.827 13.6567 12.9147 13.6753 13.0034 13.6762C13.092 13.6771 13.18 13.6603 13.2622 13.6267C13.3443 13.5932 13.4189 13.5436 13.4816 13.4809C13.5443 13.4182 13.5939 13.3436 13.6274 13.2615C13.6609 13.1793 13.6777 13.0914 13.6768 13.0027C13.6759 12.914 13.6573 12.8264 13.6222 12.7449C13.587 12.6635 13.5359 12.5899 13.4719 12.5285L8.94325 7.99986L13.4719 3.47121C13.5689 3.37819 13.6355 3.25802 13.6631 3.12647C13.6906 2.99491 13.6777 2.85811 13.6261 2.73401C13.5745 2.60991 13.4866 2.5043 13.3739 2.43103C13.2612 2.35776 13.1291 2.32025 12.9947 2.32343Z" fill="white" />
                </svg>
            </div>
          {% endcomment %}
        </div>
      {% elsif widget_settings.show_notice %}
        <div
          class="header__notice"
          style="color:{{ widget_settings.popup_notice_color | default: '#fff' }};background-color: {{ widget_settings.popup_notice_bg_color | default: '#e2d8c9' }};"
          hidden
        >
          <button type="button" class="header__notice-link" data-popup="#popup-info">
            <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                  d="M10.5013 2.16699C5.90633 2.16699 2.16797 5.90536 2.16797 10.5003C2.16797 15.0953 5.90633 18.8337 10.5013 18.8337C15.0963 18.8337 18.8346 15.0953 18.8346 10.5003C18.8346 5.90536 15.0963 2.16699 10.5013 2.16699ZM10.5013 3.41699C14.4207 3.41699 17.5846 6.58091 17.5846 10.5003C17.5846 14.4197 14.4207 17.5837 10.5013 17.5837C6.58188 17.5837 3.41797 14.4197 3.41797 10.5003C3.41797 6.58091 6.58188 3.41699 10.5013 3.41699ZM10.5013 6.33366C10.2803 6.33366 10.0683 6.42146 9.91205 6.57774C9.75577 6.73402 9.66797 6.94598 9.66797 7.16699C9.66797 7.38801 9.75577 7.59997 9.91205 7.75625C10.0683 7.91253 10.2803 8.00033 10.5013 8.00033C10.7223 8.00033 10.9343 7.91253 11.0906 7.75625C11.2468 7.59997 11.3346 7.38801 11.3346 7.16699C11.3346 6.94598 11.2468 6.73402 11.0906 6.57774C10.9343 6.42146 10.7223 6.33366 10.5013 6.33366ZM10.4915 9.24137C10.3259 9.24396 10.1681 9.31218 10.0527 9.43105C9.93739 9.54991 9.87393 9.7097 9.8763 9.87533V14.4587C9.87513 14.5415 9.89043 14.6237 9.92132 14.7006C9.9522 14.7774 9.99805 14.8474 10.0562 14.9063C10.1144 14.9653 10.1837 15.0122 10.2601 15.0441C10.3365 15.0761 10.4185 15.0926 10.5013 15.0926C10.5841 15.0926 10.6661 15.0761 10.7425 15.0441C10.819 15.0122 10.8882 14.9653 10.9464 14.9063C11.0046 14.8474 11.0504 14.7774 11.0813 14.7006C11.1122 14.6237 11.1275 14.5415 11.1263 14.4587V9.87533C11.1275 9.79167 11.1119 9.70863 11.0804 9.63112C11.0489 9.55361 11.0022 9.48321 10.943 9.42409C10.8838 9.36497 10.8134 9.31834 10.7358 9.28695C10.6582 9.25557 10.5752 9.24007 10.4915 9.24137Z"
                  fill="white"></path>
            </svg>
          </button>
          <span>{{ widget_settings.notice_desc }}</span>
        </div>
      {% endif %}
      <div class="header__container">
        <div class="header__body">
          {% if widget_settings['logo-img'] %}
            <a href="/" class="header__logo">
              <img class="header__logo-black" src="{{ widget_settings.logo-img }}" alt="Логотип duman.">
              <img class="header__logo-white" src="{{ "icon-logo.svg" | asset_url }}" alt="Duman">
            </a>
          {% endif %}
          <div class="header__menu menu">
            <nav class="menu__body">
              <ul class="menu__list">
                <li class="menu__item">
                  <a href="/collection/{{ widget_settings.menu_top_link_1 }}" class="menu__link">
                    {{- widget_settings.menu_top_1 -}}
                  </a>
                  <div class="menu__sub-wrapper sub-wrapper">
                    <div class="sub-wrapper__container">
                      <div class="sub-wrapper__body">
                        <div class="sub-wrapper__submenu submenu">
                          <div class="submenu__group">
                            {% if widget_settings['col-1-el-1-title'] %}
                              <a
                                href="/collection/{{ widget_settings.col-1-el-1-link }}"
                                class="submenu__label"
                              >
                                {{- widget_settings['col-1-el-1-title'] }}
                              </a>
                            {% endif %}
                            {% if widget_settings.menu_left %}
                              <ul class="submenu__list">
                                {% for link in linklists[widget_settings.menu_left].links %}
                                  <li class="submenu__item">
                                    <a
                                      href="{{ link.url }}"
                                      class="submenu__link"
                                      data-coll-permalink="{{ link.url }}"
                                    >
                                      {{- link.title -}}
                                    </a>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </div>
                          <div class="submenu__group submenu__group_wide">
                            <a href="/collection/all" class="submenu__label">Каталог</a>
                            {% if widget_settings.menu_right %}
                              <ul class="submenu__list">
                                {% for link in linklists[widget_settings.menu_right].links %}
                                  <li class="submenu__item">
                                    <a
                                      href="{{ link.url }}"
                                      class="submenu__link"
                                      data-coll-permalink="{{ link.url }}"
                                    >
                                      {{- link.title -}}
                                    </a>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </div>
                        </div>
                        <div class="sub-wrapper__products">
                          {% if widget_settings.img_href_1 %}
                            <div class="sub-wrapper__products-item">
                              <a
                                href="/collection/{{ widget_settings.img_href_1 }}"
                                class="sub-wrapper__products-item-img"
                              >
                                <img
                                  data-src="{{ widget_settings.img_1 | image_url: 650 }}"
                                  alt=""
                                >
                              </a>
                            </div>
                          {% endif %}
                          {% if widget_settings.img_href_2 %}
                            <div class="sub-wrapper__products-item">
                              <a
                                href="/collection/{{ widget_settings.img_href_2 }}"
                                class="sub-wrapper__products-item-img"
                              >
                                <img
                                  data-src="{{ widget_settings.img_2 | image_url: 650 }}"
                                  alt=""
                                >
                              </a>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
                {% if widget_settings.menu_top_link_2 %}
                  <li class="menu__item">
                    <a href="/collection/{{ widget_settings.menu_top_link_2 }}" class="menu__link">
                      {{- widget_settings.menu_top_2 -}}
                    </a>
                  </li>
                {% endif %}
                {% if widget_settings.menu_top_link_3 %}
                  <li class="menu__item">
                    <a href="/collection/{{ widget_settings.menu_top_link_3 }}" class="menu__link">
                      {{- widget_settings.menu_top_3 -}}
                    </a>
                  </li>
                {% endif %}
                {% if widget_settings.menu_top_link_4 %}
                  <li class="menu__item">
                    <a href="/collection/{{ widget_settings.menu_top_link_4 }}" class="menu__link">
                      {{- widget_settings.menu_top_4 -}}
                    </a>
                  </li>
                {% endif %}
                {% if widget_settings.menu_top_link_5 %}
                  <li class="menu__item">
                    <a href="/collection/{{ widget_settings.menu_top_link_5 }}" class="menu__link">
                      {{- widget_settings.menu_top_5 -}}
                    </a>
                  </li>
                {% endif %}
                {% if widget_settings.show_city_button_in_menu %}
                  <li class="menu__item menu__item_city">
                    <button type="button" data-city-open class="menu__link menu__link_city">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.9951 5.09618C12.9936 5.30746 12.9242 5.51265 12.7971 5.68146C12.6701 5.85028 12.4921 5.97376 12.2895 6.03368L12.277 6.03743L7.40198 7.40243L6.03698 12.2774L6.03323 12.2899C5.97322 12.4925 5.84971 12.6704 5.68092 12.7974C5.51213 12.9245 5.30698 12.9939 5.09573 12.9956H5.07698C4.86981 12.9975 4.66731 12.9341 4.49823 12.8144C4.32915 12.6947 4.20209 12.5247 4.1351 12.3287L0.0576014 1.33555C0.0562817 1.33231 0.0552365 1.32897 0.0544765 1.32555C-0.00645929 1.14857 -0.0165011 0.958045 0.0254936 0.775641C0.0674883 0.593236 0.159834 0.42628 0.292024 0.293764C0.424215 0.161247 0.590944 0.0684917 0.773244 0.0260484C0.955545 -0.0163949 1.1461 -0.00682168 1.32323 0.0536785L1.33323 0.0568035L12.3282 4.13555C12.5273 4.2036 12.6994 4.33354 12.8194 4.50637C12.9394 4.6792 13.0009 4.88587 12.9951 5.09618Z" fill="currentColor"/>
                      </svg>
                      <span data-city-name>Новосибирск</span>
                    </button>
                  </li>
                {% endif %}
              </ul>
            </nav>
          </div>
          <div class="header__actions">
            <button type="button" data-js-sub-btn="search" class="header__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M8.54167 2.5C5.21235 2.5 2.5 5.21235 2.5 8.54167C2.5 11.871 5.21235 14.5833 8.54167 14.5833C9.98182 14.5833 11.3057 14.0746 12.3454 13.2292L16.4331 17.3169C16.4907 17.3769 16.5597 17.4248 16.636 17.4578C16.7123 17.4907 16.7945 17.5082 16.8776 17.509C16.9608 17.5099 17.0433 17.4941 17.1202 17.4627C17.1972 17.4312 17.2672 17.3848 17.326 17.326C17.3848 17.2672 17.4312 17.1972 17.4627 17.1202C17.4941 17.0433 17.5099 16.9608 17.509 16.8776C17.5082 16.7945 17.4907 16.7123 17.4578 16.636C17.4248 16.5597 17.3769 16.4907 17.3169 16.4331L13.2292 12.3454C14.0746 11.3057 14.5833 9.98182 14.5833 8.54167C14.5833 5.21235 11.871 2.5 8.54167 2.5ZM8.54167 3.75C11.1954 3.75 13.3333 5.8879 13.3333 8.54167C13.3333 9.83442 12.8234 11.0024 11.9963 11.8628C11.9453 11.9003 11.9003 11.9453 11.8628 11.9963C11.0024 12.8234 9.83442 13.3333 8.54167 13.3333C5.8879 13.3333 3.75 11.1954 3.75 8.54167C3.75 5.8879 5.8879 3.75 8.54167 3.75Z" fill="#251E19"/>
              </svg>
            </button>

            <a href="/favorites" class="header__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M6.87496 2.08334C5.38665 2.08334 4.16663 3.30337 4.16663 4.79168V17.2917C4.16666 17.4067 4.19844 17.5195 4.25847 17.6177C4.3185 17.7158 4.40446 17.7955 4.50686 17.8479C4.60927 17.9003 4.72415 17.9235 4.83887 17.9148C4.95358 17.9061 5.06368 17.8659 5.15702 17.7987L9.99996 14.3115L14.8429 17.7987C14.9362 17.8659 15.0463 17.9061 15.1611 17.9148C15.2758 17.9235 15.3907 17.9003 15.4931 17.8479C15.5955 17.7955 15.6814 17.7158 15.7414 17.6177C15.8015 17.5195 15.8333 17.4067 15.8333 17.2917V4.79168C15.8333 3.30337 14.6133 2.08334 13.125 2.08334H6.87496ZM6.87496 3.33334H13.125C13.9375 3.33334 14.5833 3.97915 14.5833 4.79168V16.0718L10.3654 13.0347C10.2589 12.958 10.1311 12.9168 9.99996 12.9168C9.8688 12.9168 9.74097 12.958 9.63456 13.0347L5.41663 16.0718V4.79168C5.41663 3.97915 6.06243 3.33334 6.87496 3.33334Z" fill="#251E19"/>
              </svg>
              <span class="icon-counter" data-em-favorites-counter hidden></span>
            </a>

            {% comment %}
              {% if client %}
              <a href="/client_account/orders" class="header__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
