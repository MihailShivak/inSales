<script src="https://api-maps.yandex.ru/3.0/?apikey=82b416d9-91cb-4d67-a85c-4a66bbeeb85b&lang=ru_RU"></script>

{% assign is_home = false %}

{% if request.path == '/' or template == 'index' %}
    {% assign is_home = true %}
{% endif %}

<div class="popup popup-map" id="popup-map" data-geo-json="{{ 'map-zones.geojson' | file_url }}">
    <div id="map" class="map__wrapper"></div>
    <div class="map__panel">
        <div class="map__panel-marker"></div>
        {% comment %} <div class="map__panel-address" id="address-define">Определение адреса...</div> {% endcomment %}
        {% comment %} <button class="btn__change-address"">Изменить адрес</button> {% endcomment %}
        <button type="button" class="btn-ready" data-em-ready>Доставить сюда</button>
        <button type="button" class="btn-home" data-em-home>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2394F0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="&#10;">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
        </button>
    </div>
    {% comment %} <button class="modal-close">
        <svg width="24" height="24" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M4.11 2.697L2.698 4.11 6.586 8l-3.89 3.89 1.415 1.413L8 9.414l3.89 3.89 1.413-1.415L9.414 8l3.89-3.89-1.415-1.413L8 6.586l-3.89-3.89z" fill="#000"></path>
        </svg>
    </button> {% endcomment %}
</div>
<div class="popup popup-address" id="popup-address">
    <div class="modal__content">
        <input id="address-input" class="map__input" type="text" placeholder="Введите адрес">
    </div>
    <button class="modal-close modal__back-close">
        <svg width="24" height="24" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M4.11 2.697L2.698 4.11 6.586 8l-3.89 3.89 1.415 1.413L8 9.414l3.89 3.89 1.413-1.415L9.414 8l3.89-3.89-1.415-1.413L8 6.586l-3.89-3.89z" fill="#000"></path>
        </svg>
    </button>
</div>

<!-- Модалка заказа в приложении -->
