{% content_for 'title' %}
Мои заказы
{% end_content_for %}
<div class='co-checkout-block--padded'>
    {% if orders == empty %}
        <div class="account__descript">Вы ещё ничего не покупали. Самое время сделать заказ!</div>
        <a href="/collection/all" class="account__btn btn btn_primary">Перейти к покупкам</a>
    {% else %}
        {% paginate orders by 10 %}
        <div class="order__list">
            {% for order in orders %}
                <div class="order__item">
                    {% if order.fulfillment_status == 'delivered' %}
                        {% assign classNameStatus = "order__delivered" %}
                    {% elsif order.fulfillment_status == 'declined' %}
                        {% assign classNameStatus = "order__cancelled" %}
                    {% endif %}
                    <div class="order__item-top">
                        <div class="order__item-info">
                            <a href="{{ order.url | replace: "https://www.duman.store/", "/" }}" class="order__item-title">Заказ #{{ order.number }} от {{ order.creation_date | date: '%d.%m.%Y %H:%M' }}</a>
                            <div class="order__item-price">{{ order.total_price | money }}</div>
                        </div>
                        <div class="order__item-status btn {{ classNameStatus }}">
                            {{ order.customer_status }}
                        </div>
                    </div>
                    <div class="order__pay-btns">
                        <div class="order__item-status btn {{ classNameStatus }}">
                            {{ order.customer_status }}
                        </div>
                        {% if order.payment_needed? and order.fulfillment_status == 'approved' %}
                            <a href="{{ order.pay_url | replace: "https://www.duman.store/", "/" }}" class="order__pay-btn btn btn_small btn_primary">Оплатить</a>
                        {% endif %}
                    </div>
                    <div class="order__item-images">
                        {% for item in order.items %}
                            <a href="{{ item.product.url | replace: "https://www.duman.store/", "/" }}">
                                {% if item.product.images.size > 0 %}
                                    <img data-src="{{ item.variant.first_image.medium_url }}" alt="{{ item.variant.title }}">
                                {% else %}
                                    <img data-src="{{ 'no_image.svg' | asset_url }}" alt="{{ item.variant.title }}" class="image-none">
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="pagin__body" data-em-pagin="{{ paginate.pages }}" data-orders-pagin="{{ paginate.current_page }}" hidden>
            <input type="text" name="em-pagin" value="{{ paginate.current_page }}" hidden/>
            <div class="pagin__btn" data-pagin-left></div>
            <div class="pagin__wrapper">
                <div class="pagin__slider"></div>
            </div>
            <div class="pagin__btn" data-pagin-right></div>
        </div>
        {% endpaginate %}
    {% endif %}
</div>