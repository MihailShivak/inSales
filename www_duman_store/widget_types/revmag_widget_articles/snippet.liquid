{% assign for_limit = widget_settings.limit | default: 24  %}

{% if template contains 'blog' %}
  {% assign permalink_blog = articles %}
{% else %}
  {% assign permalink_blog = blogs[widget_settings.permalink_blog].articles %}
{% endif %}

{% if permalink_blog.size > 0 %}
  {% if editor_mode? or widget_settings.tags-hide != true %}
    {% unless blog.tags == empty %}
      <ul class="tags-list list-horizontal">
        <li class="list-item first">#</li>

        {% for tag in blog.tags %}
        <li class="list-item">
          <a class="{% if tag.current? %}is-active{% endif %}" href='{{ tag.url }}' title='{{ tag.title }}'>
            {{ tag.title }}
          </a>
        </li>
        {% endfor %}
      </ul>
    {% endunless %}
  {% endif %}
  <div class="rev-blog">
    <div class="grid-list">
      {% if template contains 'blog' %}
        {% for article in articles %}
            <div class="article-point">
              {% if editor_mode? or widget_settings.hide-image != true %}
                {% if article.image.original_url contains '/no_image_original.jpg' %}
                  <div class="no-image"></div>
                {% endif %}

                <div class="article-img">
                  <div class="img-ratio img-ratio_cover article-list__item-photo">
                    <div class="img-ratio__inner">
                      {% assign article_img_title = article.title | escape %}
                      <a href="{{ article.url }}">
                        {% if article.image.original_url contains '/no_image_original.jpg' %}
                          <img data-src="{{ 'no_image.jpg' | asset_url }}" alt="{{ article_img_title }}" class="lazyload" />
                        {% else %}
                          {% assign img_width = widget_settings.slide-width | to_integer | times: 1.25 | default: 500 %}
                          <picture>
                            <source media="(min-width:769px)" data-srcset="{{ article.image | image_url: 1000, format: 'webp', resizing_type: 'fit_width' }}" type="image/webp" class="lazyload">
                            <source media="(max-width:480px)" data-srcset="{{ article.image | image_url: 500, format: 'webp', resizing_type: 'fit_width' }}" type="image/webp" class="lazyload">
                            <img data-src="{{ article.image | image_url: 1000, resizing_type: 'fit_width' }}" class="lazyload" alt="{{ article_img_title }}">
                          </picture>
                        {% endif %}
                      </a>
                    </div>
                  </div>
                </div>
              {% endif %}

              <div class="article-text" {% if article.image.large_url contains 'no_image' %}style="padding-top: 0;"{% endif %}>
                <div class="title"><a class="link-hover-underline" href="{{ article.url }}">{{ article.title | escape }}</a></div>

                {% if editor_mode? or widget_settings.hide-description != true %}
                  {% if widget_settings.article_desc_limit != "all" %}
                    {% assign preview_text = article.preview | strip_html | truncatewords: widget_settings.article_desc_limit %}
                  {% else %}
                    {% assign preview_text = article.preview | strip_html %}
                  {% endif %}

                  {% if editor_mode? or widget_settings.hide-date != true or widget_settings.hide-time != true %}
                    <div class="time-date">
                      <div class="time">
                        <div>
                          <div>{% include 'svg' with 'icon_book' %}</div>
                          <div>
                            {% assign minutes = article.content.size | divided_by: 1500 %}
                            {{ widget_messages.reading_time }}: {{ minutes }} {{ widget_messages.minutes }}
                          </div>
                        </div>
                      </div>
                      <div class="divide">|</div>
                      <div class="date">{{ article.created_at | date: '%d.%m.%Y' }}</div>
                    </div>
                  {% endif %}

                  {% if preview_text.size > 0 %}
                    <div class="description">{{ preview_text }}</div>
                  {% endif %}
                {% endif %}

                {% if editor_mode? or widget_settings.hide-tags != true %}
                  {% if article.tags.size > 0 %}
                    <div class="tags">
                      {% for tag in article.tags %}
                        <a class="link-hover-underline" href="{{ tag.url }}">#{{ tag.title }} ({{ tag.articles_count }})</a>{% unless forloop.last %}, {% endunless %}
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endif %}

                {% if editor_mode? != true or widget_settings.hide-author != true %}
                  <div class="author">
                    <div>{% include 'svg' with 'icon_user' %}</div>
                    <div>{{ article.author }}</div>
                  </div>
                {% endif %}    

                <div class="article-link">
                  <a href="{{ article.url }}" class="custom-link">{{ widget_messages.read_more }}</a>
                </div>
              </div>
            </div>
        {% endfor %}
      {% else %}
        {% for article in blogs[widget_settings.permalink_blog].articles limit:for_limit %}
          <div class="article-point {% if article.image.large_url contains 'no_image' %}no-image{% endif %}">
            {% unless article.image.large_url contains 'no_image' %}
              <div class="article-img">
                <div class="img-ratio img-ratio_cover article-list__item-photo">
                  <div class="img-ratio__inner">
                    {% assign article_img_title = article.title | escape %}
                    <a href="{{ article.url }}">
                    <picture>
                      <source media="(min-width:769px)" data-srcset="{{ article.image | image_url: 1000, format: 'webp', resizing_type: 'fit_width' }}" type="image/webp" class="lazyload">
                      <source media="(max-width:480px)" data-srcset="{{ article.image | image_url: 500, format: 'webp', resizing_type: 'fit_width' }}" type="image/webp" class="lazyload">
                      <img data-src="{{ article.image | image_url: 1000, resizing_type: 'fit_width' }}" class="lazyload" alt="{{ article_img_title }}">
                    </picture>
                    </a>
                  </div>
                </div>
              </div>
            {% endunless %}

            <div class="article-text" {% if article.image.large_url contains 'no_image' %}style="padding-top: 0;"{% endif %}>
              <div class="title"><a class="link-hover-underline" href="{{ article.url }}">{{ article.title | escape }}</a></div>

              {% if editor_mode? or widget_settings.hide-description != true %}
                {% if widget_settings.article_desc_limit != "all" %}
                  {% assign preview_text = article.preview | strip_html | truncatewords: widget_settings.article_desc_limit %}
                {% else %}
                  {% assign preview_text = article.preview | strip_html %}
                {% endif %}

                {% if editor_mode? or widget_settings.hide-date != true or widget_settings.hide-time != true %}
                  <div class="time-date">
                    <div class="time">
                      <div>
                        <div>{% include 'svg' with 'icon_book' %}</div>
                        <div>
                          {% assign minutes = article.content.size | divided_by: 1500 %}
                          {{ widget_messages.reading_time }}: {{ minutes }} {{ widget_messages.minutes }}
                        </div>
                      </div>
                    </div>
                    <div class="divide">|</div>
                    <div class="date">{{ article.created_at | date: '%d.%m.%Y' }}</div>
                  </div>
                {% endif %}

                {% if preview_text.size > 0 %}
                  <div class="description">{{ preview_text }}</div>
                {% endif %}
              {% endif %}

              {% if editor_mode? or widget_settings.hide-tags != true %}
                {% if article.tags.size > 0 %}
                  <div class="tags">
                    {% for tag in article.tags %}
                      <a class="link-hover-underline" href="{{ tag.url }}">#{{ tag.title }} ({{ tag.articles_count }})</a>
                      {% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}
              {% endif %}

              {% if editor_mode? != true or widget_settings.hide-author != true %}
                <div class="author">
                  <div>{% include 'svg' with 'icon_user' %}</div>
                  <div>{{ article.author }}</div>
                </div>
              {% endif %}    

              <div class="article-link">
                <a href="{{ article.url }}" class="custom-link">{{ widget_messages.read_more }}</a>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
{% endif %}