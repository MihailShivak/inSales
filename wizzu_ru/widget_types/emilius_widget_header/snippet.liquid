<div class="popup popup-search" id="popup-search">
  <div class="search__body">
    <div class="search__scroll">
      <div class="search__panel-mob">
        <div class="popup__input-search input-group__wrapper" data-js-search="">
          <div class="header__icon icon_search"></div>
          <input
            autocomplete="off"
            type="text"
            placeholder="Найти нужный товар ..."
            class="input-group__input input"
            data-popup="#popup-search"
            data-mob-search-input
          >
          <button class="panel__mob-close icon_close" data-btn-clear-input></button>
        </div>
      </div>
      <div class="search__not-found search__collcetions-title" hidden>По вашему запросу ничего не найдено</div>
      <div class="search__products-list" data-em-products-list hidden></div>
      <div class="search__collcetions-list" data-em-collcetions-list>
        {% if collections.all.subcollections.size > 0 %}
          <div class="search__collcetions-title">Категории</div>
        {% endif %}
        {% for collection in collections.all.subcollections %}
          {% if collection.subcollections.size == 0 %}
            {% continue %}
          {% endif %}
          <a href="{{ collection.url }}" class="search__subcollections-item">
            <div class="search__subcollections-img">
              <img
                src="{{ collection.image.large_url | replace: 'static.insales-cdn.com', 'ibicecdn.com/gastromania' }}"
                class="lazyload"
                loading="lazy"
              >
            </div>
            <div class="search__subcollections-title">{{ collection.title }}</div>
          </a>
        {% endfor %}
      </div>
      {% comment %}
        <div class="search__collcetions-list" data-em-collcetions-list>
            {% for collection in collections.all.subcollections %}
                <div class="search__collcetions-item">
                    <div class="search__collcetions-title">{{ collection.title }}</div>
                    <div class="search__subcollections">
                        {% for collection in collection.subcollections %}
                            <a href="{{ collection.url }}" class="search__subcollections-item">
                                <div class="search__subcollections-img">
                                    <img src="{{ collection.image.large_url }}" alt="">
                                </div>
                                <div class="search__subcollections-title">{{ collection.title }}</div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
      {% endcomment %}
    </div>
  </div>
  <div class="modal-close modal__back-close"></div>
</div>

