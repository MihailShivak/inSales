<div data-ajax-pagination>
  {% if paginate.pages > 1 %}
    <div class="rev-coll-pagination">
      {% if paginate.previous %}
      <a href="{{ paginate.previous.url }}" class="pag-prev">{% include 'svg' with 'icon_prev' %}</a>
      {% endif %}
      <div class="pag-items {% if paginate.next %}next{% endif %}">
        {% for part in paginate.parts %}
        {% if part.title == paginate['current_page'] %}
          <span class="pag-link pag-disabled">
           {{ part.title }}
          </span>
        {% else %}
        {% if part.is_link %}
          <a href="{{ part.url }}" class="pag-link">
           {{ part.title }}
        </a>
        {% else %}
          <span class="pag-void">
           {{ part.title }}
          </span>
        {% endif %}
        {% endif %}
        {% endfor %}
      </div>
      {% if paginate.next %}
        <a href="{{ paginate.next.url }}" class="pag-next">{% include 'svg' with 'icon_next' %}</a>
      {% endif %}
    </div>
  {% endif %} 
</div>