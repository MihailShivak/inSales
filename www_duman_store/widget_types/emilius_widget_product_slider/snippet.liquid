{% capture product_slider_time %}{{'now' | date: '%s.%L' }}{% endcapture %}

<!-- product-slider -->
{% assign collection_select = collections[widget_settings.category] %}

{% for product in collection_select.products limit: 15 %}

  {% capture product_key %}|{{ product.id }}|{% endcapture %}

  {% unless schema_product_ids contains product_key %}

    {% capture schema_product_ids %}
      {{ schema_product_ids }}{{ product_key }}
    {% endcapture %}

    {% assign schema_position = schema_position | plus: 1 %}

    {% capture schema_product_items %}
      {{ schema_product_items }}
      {% if schema_has_items %},{% endif %}
      {
        "@type": "ListItem",
        "position": {{ schema_position }},
        "url": "{{ account.url }}{{ product.url }}",
        "item": {
            "@type": "Product",
            "name": "{{ product.title }}",
            "image": "{{ product.first_image.large_url | replace: 'cdn.insales-shop.ru', 'ibicecdn.com/dumanstore' }}",
            "offers": {
                "@type": "Offer",
                "price": "{{ product.price }}",
                "priceCurrency": "RUB",
                "availability": "https://schema.org/InStock",
                "url": "{{ account.url }}{{ product.url }}"
            }
        }
      }
        {% endcapture %}

    {% assign schema_has_items = true %}

  {% endunless %}

{% endfor %}

{% if collection_select and collection_select.products_count > 0 %}
    <div class="products-slider" data-js-slider="products-slider-wrapper" data-em-slider>
		<script type="application/ld+json">
			{
				"handle": "{{- collection_select.handle -}}",
				"products_count": "{{- collection_select.products_count -}}",
				"limit": "{{- widget_settings.elem-number | default: 10 -}}"
			}
		</script>
        <div class="products-slider__container">
            <div class="products-slider__head">
                <div class="products-slider__title-wrapper">
                    <a href="{{ collection_select.url }}" class="products-slider__title">{{ widget_settings.slider-title | editable }}</a>
                    <div class="products-slider__subtitle">{{ widget_settings.slider-description | editable }}</div>
                </div>
                <div class="products-slider__arrows">
                    <button type="button" class="products-slider__arrow products-slider__arrow-prev swiper-button-prev"></button>
                    <button type="button" class="products-slider__arrow products-slider__arrow-next swiper-button-next"></button>
                </div>
            </div>
            <div class="products-slider__list swiper">
                <div class="products-slider__list-wrapper swiper-wrapper">
                    <div class="products-slider__slide products-item swiper-slide" data-js="product-item">
                        <div class="products-item__img-wrapper">
                            <div class="products-item__img products-item__more">
                                <div class="products-item__more-text">
                                    <div>Загружаем товары</div>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" style="fill:#975730;"><circle class="spinner_b2T7" cx="4" cy="12" r="3"/><circle class="spinner_b2T7 spinner_YRVV" cx="12" cy="12" r="3"/><circle class="spinner_b2T7 spinner_c9oY" cx="20" cy="12" r="3"/></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% comment %} <div class="products-slider__slide products-item swiper-slide" data-js="product-item">
                        <div class="products-item__img-wrapper">
                            <a href="{{ category_url }}" class="products-item__img products-item__more" target="_blank">
                                <div class="products-item__more-text">Смотреть все</div>
                            </a>
                        </div>
                    </div> {% endcomment %}
                </div>
            </div>
        </div>
    </div>
    <div data-js="product-item">
        <button type="button" data-js="product-item-addcard" data-em-btn-form hidden></button>
        <div data-em-product-form class="em-wrapper__form"></div>
        <div class="products-item__sizes-filling" data-js="product-sizes-close"></div>
    </div>
{% endif %}
<!-- product-slider end -->

<script>console.log("render ajax slider: {{ 'now' | date: '%s.%L' | minus: product_slider_time }}");</script>

