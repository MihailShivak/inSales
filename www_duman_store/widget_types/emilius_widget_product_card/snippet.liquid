{% if popup_i > 0 %}
    <div id="popup-gallery" aria-hidden="true" class="popup popup-gallery">
        <div class="popup-gallery__content popup__content" data-js-slider="gallery-slider">
            <button type="button" data-close class="popup__close popup-gallery__close"></button>

            <button type="button" class="gallery-slider__plus">+</button>
            <button type="button" class="gallery-slider__arrow swiper-button-prev"></button>
            <button type="button" class="gallery-slider__arrow swiper-button-next"></button>

            <div class="popup-gallery__thumbs swiper">
                <div class="popup-thumbs__list swiper-wrapper">
                    {% if product.video_links.size > 0 %}
                        {% for video in product.video_links %}
                            <div class="popup-thumb__item swiper-slide">
                                <img class="entered _lazy-loaded" 
                                    data-src="{{ product.first_image.large_url | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}" alt="">
                            </div>
                        {% endfor %}
                    {% endif %}
                    {% for image in product.images %}
                        <div class="popup-thumb__item swiper-slide">
                            <img class="entered _lazy-loaded" 
                                data-src="{{ image.large_url | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}" alt="">
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="popup-gallery__list swiper">
                <div class="popup-gallery__list-wrapper swiper-wrapper">
                    {% if product.video_links.size > 0 %}
                        {% assign popup_i = 0 %}
                        {% for video in product.video_links %}
                            {% assign popup_i = popup_i | plus: 1 %}
                            <div class="popup-gallery__item swiper-slide" data-close>
                                <video 
                                    data-em-video="{{ video.url }}" data-video-i="{{ popup_i }}"
                                    data-em-video-controls="true"
                                    preload="metadata"
                                    controls controlslist="nodownload"
                                    playsinline loop
                                    preload="metadata" class="popup__gallery-video">
                                    <!-- Fallback для браузеров без поддержки HLS -->
                                    {% comment %} <source src="{{ video.url }}.mp4" type="video/mp4">
                                    <source src="{{ video.url }}.m3u8" type="application/vnd.apple.mpegurl"> {% endcomment %}
                                    Ваш браузер не поддерживает воспроизведение видео.
                                </video>
                            </div>
                        {% endfor %}
                    {% endif %}
                    {% for image in product.images %}
                        <div class="popup-gallery__item swiper-slide">
                            <picture>
                                <!-- webp -->
                                {% comment %} <source type="image/webp"
                                    data-srcset="{{ image.original_url | image_url: 2048, format: 'webp' | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}" > {% endcomment %}
                                <img class="popup__gallery-img" 
                                    data-src="{{ image.original_url | replace: 'static.insales-cdn.com', 'ibicecdn.com/dumanstorel2' }}" alt="">
                            </picture>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    {% assign popup_i = null %}
{% endif %}

