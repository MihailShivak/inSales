{% assign logo_default = widget_settings.logo_img
  | default: ''
%}

{% assign logo_barakat = widget_settings['logo_img_barakat-voda']
  | default: 'https://cdn.insales-shop.ru/files/1/7985/131882801/original/barakat-voda.svg'
%}

{% assign logo_fermerskaya = widget_settings['logo_img_fermerskaya-lavka']
  | default: 'https://cdn.insales-shop.ru/files/1/7993/131882809/original/fermerskaya-lavka.svg'
%}

<div class="header _app-header {% unless template == "index" %} _disabled-mob {% endunless %}">
  <div class="header__top">
    <div class="header__top-menu">
      {% for link in linklists[widget_settings.menu_top].links %}
        <a href="{{ link.url }}" class="header__menu-item">{{ link.title }}</a>
      {% endfor %}
    </div>
    <div class="header__top-section header__top-text">
      {{ widget_settings['title-top'] }}
    </div>
    <a
      href="tel:+{{ widget_settings.url_1-href }}"
      class="header__top-section"
      data-em-link="{{ widget_settings.url_1-href }}"
      data-em-id-order="{{ order.number }}"
    >
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="13.0004" cy="12.9994" r="12.9994" fill="#2394F0"/>
